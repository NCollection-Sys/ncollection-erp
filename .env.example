# ============================================================================
#  NCollection ERP — local environment template
# ============================================================================
#  Copy this file to `.env` and adjust if needed:
#      cp .env.example .env
#
#  docker-compose.yml reads these with defaults (${VAR:-default}), so the stack
#  ALSO runs fine with no .env at all — this file just lets you override the
#  local Postgres credentials without editing tracked files.
#
#  `.env` is gitignored and must never be committed. These are DEV credentials
#  only; production secrets are handled separately by ticket P1-T02.
# ============================================================================

# Postgres credentials (used by both the db and odoo containers).
DB_USER=odoo
DB_PASSWORD=odoo
DB_NAME=postgres

# Host port for connecting an external client (pgAdmin4, DBeaver, psql) to
# the containerized Postgres. Default 5433 avoids clashing with a local
# Postgres install, which usually already owns 5432.
DB_PORT=5433

# Odoo database-manager master password. Must match `admin_passwd` in
# config/odoo.conf. Dev-only value.
ODOO_ADMIN_PASSWORD=ncollection_dev

# Config-sync MASTER key (P2-T03 + #212). The SINGLE most powerful credential in
# the platform (ARCHITECTURE_SECURITY §11): each tenant's config-sync bearer is
# DERIVED from this master per-tenant — HMAC-SHA256(master, "nc-config-sync:" + db)
# — so a leaked/logged per-tenant key is scoped to one tenant, never the fleet.
# The master stays in the platform process only; the platform derives each key and
# hands the tenant subprocess just the derived value (the master never enters a
# tenant DB). Provisioning stores only the HASH of the derived key inside each
# tenant. Generate a strong random value and NEVER commit it (this template is
# valueless on purpose). Empty => config sync is disabled (fails soft + logs).
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
NC_CONFIG_SYNC_KEY=

# AI gateway per-tenant auth master (#373). The SAME value must reach both the
# odoo container (which signs) and the ai-gateway satellite (which verifies).
# Each tenant's key is derived as HMAC-SHA256(master, "nc-ai-gateway:" || db),
# so nothing per-tenant is ever stored and rotating this rotates every tenant.
# Empty => the gateway refuses every request (503) rather than trusting the
# caller's claim. Generate with:
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
NC_AI_GATEWAY_KEY=

# Stripe subscription-payment keys (P2-T13). ncollection_billing configures the
# admin-DB Stripe provider from these, in TEST mode. Use your Stripe TEST keys
# (sk_test_… / pk_test_…) and the signing secret from the webhook endpoint
# (…/payment/stripe/webhook). NEVER commit real keys — this template is empty on
# purpose. All three empty => online payment stays disabled. Going live means
# swapping in live keys AND flipping the provider to 'enabled' (an ops action).
NC_STRIPE_SECRET_KEY=
NC_STRIPE_PUBLISHABLE_KEY=
NC_STRIPE_WEBHOOK_SECRET=

# pgAdmin4 (only started by docker-compose.dev.yml):
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d
# then open http://localhost:5050 and log in with these.
# NOTE: avoid the .local TLD — pgAdmin's email validator rejects it and the
# container crash-loops. Any normal TLD works (dev-only login, not real mail).
PGADMIN_EMAIL=admin@ncollection.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ============================================================================
#  Production edge (Nginx + TLS) — ticket P1-T03.
# ============================================================================
#  Used by docker-compose.prod.yml and the Certbot commands in nginx/README.md.
#  NOT needed for local dev (dev serves *.localhost over plain HTTP, no certs).

# Base domain for tenant subdomains (<tenant>.DOMAIN). NOTE: the prod Nginx conf
# currently hardcodes ncollectionerp.com — if you change this, also edit
# nginx/conf.d/ncollection.prod.conf (config templating is a future enhancement).
DOMAIN=ncollectionerp.com

# Email Let's Encrypt attaches to the cert for expiry notices (Certbot --email).
CERTBOT_EMAIL=ops@ncollectionerp.com

# Wildcard certs require the DNS-01 challenge, i.e. YOUR DNS provider's Certbot
# plugin + a scoped API token, so `certbot certonly --dns-<provider>` can write
# the _acme-challenge TXT record. See nginx/README.md for the exact command and
# a manual (no-API) fallback. Keep real tokens in a gitignored file, never here.
# CERTBOT_DNS_PROVIDER=cloudflare
# CERTBOT_DNS_API_TOKEN=changeme

# ============================================================================
#  Staging deploy (CD) — ticket P2-T07.
# ============================================================================
#  Two distinct credential sets — do not confuse them:
#
#  1) On the STAGING SERVER's /opt/ncollection/.env (runtime): reuse the DB_* /
#     ODOO_ADMIN_PASSWORD / NC_CONFIG_SYNC_KEY above, plus the image tag below.
#     The pipeline overrides IMAGE_TAG per deploy (sha-<gitsha>); this default
#     just lets a manual `docker compose ... up` on the server pull `:develop`.
IMAGE_TAG=develop

#  2) The pipeline's own credentials live as GitHub Actions REPOSITORY SECRETS,
#     never in any committed or server file:
#       STAGING_HOST       staging hostname/IP the runner SSHes to
#       STAGING_SSH_USER   deploy user (defaults to `deploy` if unset)
#       STAGING_SSH_KEY    that user's PRIVATE key (multiline)
#       DISCORD_WEBHOOK    deploy notifications (optional; omit to skip)
#     Until STAGING_HOST + STAGING_SSH_KEY exist, the deploy workflow no-ops
#     (green). Full setup: docs/markdown/RUNBOOK_STAGING.md.

# ============================================================================
#  Backup / PITR — pgBackRest (P2-T04). Only needed with docker-compose.backup.yml.
# ============================================================================
#  REQUIRED when the backup overlay is active — the repo is aes-256-cbc encrypted.
#  Generate a strong passphrase and keep it in the secrets store, never in git:
#     openssl rand -base64 48
PGBACKREST_REPO1_CIPHER_PASS=
#  Dev/test uses a LOCAL posix repo (pgbackrest.conf default). PRODUCTION points
#  the repo at Backblaze B2 (S3-compatible) by setting these (secrets):
# PGBACKREST_REPO1_TYPE=s3
# PGBACKREST_REPO1_S3_BUCKET=ncollection-backups
# PGBACKREST_REPO1_S3_ENDPOINT=s3.us-west-002.backblazeb2.com
# PGBACKREST_REPO1_S3_REGION=us-west-002
# PGBACKREST_REPO1_S3_KEY=
# PGBACKREST_REPO1_S3_KEY_SECRET=

# ============================================================================
#  Tenant backup manager (P2-T05). The per-tenant pg_dump + filestore layer.
# ============================================================================
#  REQUIRED to run tenant backups — the bundle is aes-256-cbc encrypted:
#     openssl rand -base64 48
TENANT_BACKUP_CIPHER_PASS=
#  Optional off-site upload: an executable taking the encrypted file path (e.g.
#  an rclone/aws-cli wrapper). Unset = keep only the local copy under
#  /var/lib/odoo/backups/<db>/. See docs/markdown/RUNBOOK_TENANT_BACKUP.md.
# TENANT_BACKUP_UPLOAD_CMD=/opt/ncollection/scripts/backup/upload_b2.sh

# ============================================================================
#  Monitoring & alerting (P2-T10). Lightweight cron probes → Discord.
# ============================================================================
#  Discord webhook every monitor (+ the deploy pipeline) alerts to. Unset = the
#  scripts still log "[ALERT] …" locally but post nothing.
DISCORD_WEBHOOK=
#  Space-separated health URLs to probe (admin + tenant subdomains). Default
#  probes the local Odoo /web/health.
# MONITOR_HEALTH_URLS=https://admin.ncollectionerp.com/web/health
#  Thresholds (defaults shown):
# MONITOR_DISK_PCT=85
# MONITOR_MEM_PCT=90
# MONITOR_LOAD_PER_CPU=2.0

# ---------------------------------------------------------------------------
# DEV ONLY — temporary tenant-admin password (#475)
# ---------------------------------------------------------------------------
# LEAVE THIS EMPTY. NEVER SET IT IN STAGING OR PRODUCTION.
#
# Provisioning normally gives a new tenant admin an unguessable random password
# that is never disclosed, then forces a password reset — so there is no known
# initial credential. That is what makes a tenant "born hardened".
#
# Setting this variable to a value replaces BOTH halves of that for every tenant
# provisioned afterwards: the admin gets exactly this password, and the forced
# reset is skipped. The credentials are then printed into the provisioning job
# log at WARNING level, which is fine on a laptop and unacceptable anywhere else.
#
# The variable IS the password on purpose — there is no boolean "dev mode" that
# could be switched on for an unrelated reason, and no default credential is
# committed anywhere in this repository.
#
# For local testing only, uncomment:
# NC_DEV_SEED_PASSWORD=NCollection123!
NC_DEV_SEED_PASSWORD=
