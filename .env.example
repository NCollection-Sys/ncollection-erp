# ============================================================================
#  NCollection ERP — local environment template
# ============================================================================
#  Copy this file to `.env` and adjust if needed:
#      cp .env.example .env
#
#  docker-compose.yml reads these with defaults (${VAR:-default}), so the stack
#  ALSO runs fine with no .env at all — this file just lets you override the
#  local Postgres credentials without editing tracked files.
#
#  `.env` is gitignored and must never be committed. These are DEV credentials
#  only; production secrets are handled separately by ticket P1-T02.
# ============================================================================

# Postgres credentials (used by both the db and odoo containers).
DB_USER=odoo
DB_PASSWORD=odoo
DB_NAME=postgres

# Host port for connecting an external client (pgAdmin4, DBeaver, psql) to
# the containerized Postgres. Default 5433 avoids clashing with a local
# Postgres install, which usually already owns 5432.
DB_PORT=5433

# Odoo database-manager master password. Must match `admin_passwd` in
# config/odoo.conf. Dev-only value.
ODOO_ADMIN_PASSWORD=ncollection_dev

# Config-sync service-account bearer key (P2-T03). The SINGLE most powerful
# credential in the platform (ARCHITECTURE_SECURITY §11): the shared bearer key
# the platform uses to push plan changes into every tenant DB's workspace
# config over json2. Provisioning stores only its HASH inside each tenant.
# Generate a strong random value and NEVER commit it (this template is
# valueless on purpose). Empty => config sync is disabled (fails soft + logs).
#   python3 -c "import secrets; print(secrets.token_urlsafe(48))"
NC_CONFIG_SYNC_KEY=

# pgAdmin4 (only started by docker-compose.dev.yml):
#   docker compose -f docker-compose.yml -f docker-compose.dev.yml up -d
# then open http://localhost:5050 and log in with these.
# NOTE: avoid the .local TLD — pgAdmin's email validator rejects it and the
# container crash-loops. Any normal TLD works (dev-only login, not real mail).
PGADMIN_EMAIL=admin@ncollection.com
PGADMIN_PASSWORD=admin
PGADMIN_PORT=5050

# ============================================================================
#  Production edge (Nginx + TLS) — ticket P1-T03.
# ============================================================================
#  Used by docker-compose.prod.yml and the Certbot commands in nginx/README.md.
#  NOT needed for local dev (dev serves *.localhost over plain HTTP, no certs).

# Base domain for tenant subdomains (<tenant>.DOMAIN). NOTE: the prod Nginx conf
# currently hardcodes ncollectionerp.com — if you change this, also edit
# nginx/conf.d/ncollection.prod.conf (config templating is a future enhancement).
DOMAIN=ncollectionerp.com

# Email Let's Encrypt attaches to the cert for expiry notices (Certbot --email).
CERTBOT_EMAIL=ops@ncollectionerp.com

# Wildcard certs require the DNS-01 challenge, i.e. YOUR DNS provider's Certbot
# plugin + a scoped API token, so `certbot certonly --dns-<provider>` can write
# the _acme-challenge TXT record. See nginx/README.md for the exact command and
# a manual (no-API) fallback. Keep real tokens in a gitignored file, never here.
# CERTBOT_DNS_PROVIDER=cloudflare
# CERTBOT_DNS_API_TOKEN=changeme
