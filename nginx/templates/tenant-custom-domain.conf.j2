# ==========================================================================
#  NCollection ERP — CUSTOM tenant domain server block  (ticket P2-T06)
# ==========================================================================
#  Jinja2 template for a tenant's OWN domain (e.g. erp.acme.com), rendered per
#  domain into /etc/nginx/conf.d/tenants/{{ fqdn }}.conf and activated with a
#  graceful reload (scripts/deploy/nginx-reload.sh).
#
#  Platform SUBDOMAINS (<db>.ncollectionerp.com) do NOT use this — they ride the
#  wildcard block in ncollection.prod.conf with zero per-tenant config. This
#  template is only for CUSTOM domains, which each need their own Let's Encrypt
#  cert (issued via HTTP-01 before the reload — see nginx/README.md).
#
#  Shared http-context directives (upstreams `odoo`/`odoo_bus`, the
#  $connection_upgrade map, the `login` rate-limit zone) come from
#  ncollection.prod.conf, which is always loaded alongside this file.
#
#  Render context: fqdn (str) — the tenant's fully-qualified custom domain.
# ==========================================================================

server {
    listen 80;
    server_name {{ fqdn }};

    location /.well-known/acme-challenge/ {
        root /var/www/certbot;
    }
    location / {
        return 301 https://$host$request_uri;
    }
}

server {
    listen 443 ssl;
    http2 on;
    server_name {{ fqdn }};

    # Per-domain Let's Encrypt cert (issued before this block is activated).
    ssl_certificate     /etc/letsencrypt/live/{{ fqdn }}/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/{{ fqdn }}/privkey.pem;

    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_prefer_server_ciphers off;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_session_cache shared:SSL:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;

    client_max_body_size 100M;

    include /etc/nginx/snippets/security-headers.conf;
    include /etc/nginx/snippets/gzip.conf;
    include /etc/nginx/snippets/public-urls.conf;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    location /web/database {
        return 403;
    }

    location = /web/login {
        limit_req zone=login burst=10 nodelay;
        limit_req_status 429;
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://odoo;
    }

    location /websocket {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://odoo_bus;
    }
    location /longpolling {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://odoo_bus;
    }

    location / {
        include /etc/nginx/snippets/proxy.conf;
        proxy_pass http://odoo;
    }
}
