<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Record rules — the ORM half of Rule 4/7. A plain reseller may only
            reach records tied to its own reseller (matched via the reseller's
            portal login user_id); Platform Admin sees the whole fleet.
        -->

        <!-- Reseller record: own only vs. all (admin). -->
        <record id="reseller_rule_own" model="ir.rule">
            <field name="name">Reseller: own account only</field>
            <field name="model_id" ref="model_ncollection_reseller"/>
            <field name="domain_force">[('user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_reseller'))]"/>
        </record>
        <record id="reseller_rule_admin" model="ir.rule">
            <field name="name">Reseller: platform admin sees all</field>
            <field name="model_id" ref="model_ncollection_reseller"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[Command.link(ref('ncollection_subscription.group_platform_admin'))]"/>
        </record>

        <!-- Sub-tenants: a reseller sees only tenants it provisioned. -->
        <record id="tenant_rule_reseller" model="ir.rule">
            <field name="name">Reseller: own sub-tenants only</field>
            <field name="model_id" ref="ncollection_subscription.model_ncollection_tenant"/>
            <field name="domain_force">[('reseller_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_reseller'))]"/>
        </record>
        <!-- ...and the matching admin rule that widens Platform Admin back to the
             whole fleet. REQUIRED, not cosmetic: reseller_groups.xml makes
             group_platform_admin IMPLY group_reseller, so without this the only
             tenant rule an admin matches is the restrictive one above — and since
             group rules are OR'ed, installing this module silently stripped
             Platform Admin's access to every tenant it does not personally resell
             (#300: AccessError on tenant.write in ncollection_subscription and
             ncollection_billing tests). The sibling rules for ncollection.reseller
             and the revenue-share report already do this; tenants were missed. -->
        <record id="tenant_rule_admin" model="ir.rule">
            <field name="name">Tenant: platform admin sees all</field>
            <field name="model_id" ref="ncollection_subscription.model_ncollection_tenant"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[Command.link(ref('ncollection_subscription.group_platform_admin'))]"/>
        </record>

        <!-- Revenue-share report rows: own vs. all (admin). -->
        <record id="revshare_rule_own" model="ir.rule">
            <field name="name">Revenue share: own only</field>
            <field name="model_id" ref="model_ncollection_reseller_revenue_share"/>
            <field name="domain_force">[('reseller_id.user_id', '=', user.id)]</field>
            <field name="groups" eval="[Command.link(ref('group_reseller'))]"/>
        </record>
        <record id="revshare_rule_admin" model="ir.rule">
            <field name="name">Revenue share: platform admin sees all</field>
            <field name="model_id" ref="model_ncollection_reseller_revenue_share"/>
            <field name="domain_force">[(1, '=', 1)]</field>
            <field name="groups"
                   eval="[Command.link(ref('ncollection_subscription.group_platform_admin'))]"/>
        </record>
    </data>
</odoo>
