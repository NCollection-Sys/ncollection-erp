<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            P10-T09 — Reseller group. A white-label partner who signs in to the
            platform to manage ITS OWN sub-tenants only. Distinct from Platform
            Admin (NCollection staff, full fleet). The group is the gate for the
            reseller menus, MIRRORED at the ORM via ir.model.access + record
            rules (Rule 4/7) — never a UI-only restriction.

            Platform Admin implies Reseller so staff can see the reseller
            surfaces too; record rules then widen Platform Admin back to the full
            fleet while a plain reseller stays scoped to its own tenants.
        -->
        <record id="group_reseller" model="res.groups">
            <field name="name">Reseller</field>
            <field name="privilege_id"
                   ref="ncollection_subscription.res_groups_privilege_platform"/>
            <field name="comment">White-label partner: manages its own sub-tenants,
                branding and revenue-share report. Scoped by record rules.</field>
        </record>

        <record id="ncollection_subscription.group_platform_admin" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('group_reseller'))]"/>
        </record>
    </data>
</odoo>
