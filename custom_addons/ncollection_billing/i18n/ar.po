#. module: ncollection_billing
#: model:mail.template,body_html:ncollection_billing.mail_template_payment_received
msgid "<div>\n                    <p>Hello <t t-out=\"object.tenant_id.company_name or ''\"/>,</p>\n                    <p>We received your payment<t t-if=\"ctx.get('invoice_name')\"> for invoice\n                       <strong><t t-out=\"ctx.get('invoice_name')\"/></strong></t>. Your\n                       <strong><t t-out=\"object.plan_id.name or ''\"/></strong> subscription is active\n                       through <t t-out=\"object.end_date or ''\"/>. Thank you.</p>\n                </div>\n            "
msgstr "<div><p>مرحبًا <t t-out=\"object.tenant_id.company_name or ''\"/>،</p><p>استلمنا دفعتك<t t-if=\"ctx.get('invoice_name')\"> للفاتورة <strong><t t-out=\"ctx.get('invoice_name')\"/></strong></t>. اشتراكك في <strong><t t-out=\"object.plan_id.name or ''\"/></strong> نشط حتى <t t-out=\"object.end_date or ''\"/>. شكرًا لك.</p></div>"

#. module: ncollection_billing
#: model:mail.template,body_html:ncollection_billing.mail_template_dunning
msgid "<div>\n                    <p>Hello <t t-out=\"object.tenant_id.company_name or ''\"/>,</p>\n                    <p>We were unable to collect payment for your\n                       <strong><t t-out=\"object.plan_id.name or ''\"/></strong> subscription.</p>\n                    <p>Please settle the outstanding invoice to keep your workspace active.</p>\n                </div>\n            "
msgstr "<div><p>مرحبًا <t t-out=\"object.tenant_id.company_name or ''\"/>،</p><p>تعذّر علينا تحصيل الدفعة الخاصة باشتراكك في <strong><t t-out=\"object.plan_id.name or ''\"/></strong>.</p><p>يُرجى تسوية الفاتورة المستحقة للحفاظ على نشاط مساحة عملك.</p></div>"

#. module: ncollection_billing
#: model:mail.template,body_html:ncollection_billing.mail_template_payment_failed
msgid "<div>\n                    <p>Hello <t t-out=\"object.tenant_id.company_name or ''\"/>,</p>\n                    <p>We were unable to process a payment for your\n                       <strong><t t-out=\"object.plan_id.name or ''\"/></strong> subscription. Please\n                       update your payment method and try again to avoid any interruption.</p>\n                </div>\n            "
msgstr "<div><p>مرحبًا <t t-out=\"object.tenant_id.company_name or ''\"/>،</p><p>تعذّرت معالجة دفعة اشتراكك في <strong><t t-out=\"object.plan_id.name or ''\"/></strong>. يُرجى تحديث وسيلة الدفع والمحاولة مرة أخرى لتجنّب أي انقطاع.</p></div>"

#. module: ncollection_billing
#: model:mail.template,body_html:ncollection_billing.mail_template_expiry_warning
msgid "<div>\n                    <p>Hello <t t-out=\"object.tenant_id.company_name or ''\"/>,</p>\n                    <p>Your <strong><t t-out=\"object.plan_id.name or ''\"/></strong> subscription\n                       expires on <t t-out=\"object.end_date or ''\"/>\n                       (in <t t-out=\"object.days_remaining\"/> days).</p>\n                    <p>Please renew to avoid any interruption to your workspace.</p>\n                </div>\n            "
msgstr "<div><p>مرحبًا <t t-out=\"object.tenant_id.company_name or ''\"/>،</p><p>ينتهي اشتراكك في <strong><t t-out=\"object.plan_id.name or ''\"/></strong> بتاريخ <t t-out=\"object.end_date or ''\"/> (خلال <t t-out=\"object.days_remaining\"/> يومًا).</p><p>يُرجى التجديد لتجنّب أي انقطاع في مساحة عملك.</p></div>"

#. module: ncollection_billing
#: model:mail.template,body_html:ncollection_billing.mail_template_expired
msgid "<div>\n                    <p>Hello <t t-out=\"object.tenant_id.company_name or ''\"/>,</p>\n                    <p>Your <strong><t t-out=\"object.plan_id.name or ''\"/></strong> subscription has\n                       expired. You are within the grace period — renew now to restore full access\n                       before your workspace is suspended.</p>\n                </div>\n            "
msgstr "<div><p>مرحبًا <t t-out=\"object.tenant_id.company_name or ''\"/>،</p><p>انتهى اشتراكك في <strong><t t-out=\"object.plan_id.name or ''\"/></strong>. أنت ضمن فترة السماح — جدّد الآن لاستعادة الوصول الكامل قبل تعليق مساحة عملك.</p></div>"

#. module: ncollection_billing
#: model:mail.template,body_html:ncollection_billing.mail_template_trial_ending
msgid "<div>\n                    <p>Hello <t t-out=\"object.tenant_id.company_name or ''\"/>,</p>\n                    <p>Your free trial of the <strong><t t-out=\"object.plan_id.name or ''\"/></strong>\n                       plan ends on <t t-out=\"object.trial_end_date or ''\"/>\n                       <t t-if=\"ctx.get('days_left') is not None\">(in <t t-out=\"ctx.get('days_left')\"/> days)</t>.</p>\n                    <p>Add a payment method to keep your workspace running without interruption.</p>\n                </div>\n            "
msgstr "<div><p>مرحبًا <t t-out=\"object.tenant_id.company_name or ''\"/>،</p><p>تنتهي تجربتك المجانية لخطة <strong><t t-out=\"object.plan_id.name or ''\"/></strong> بتاريخ <t t-out=\"object.trial_end_date or ''\"/> <t t-if=\"ctx.get('days_left') is not None\">(خلال <t t-out=\"ctx.get('days_left')\"/> يومًا)</t>.</p><p>أضف وسيلة دفع لتستمر مساحة عملك دون انقطاع.</p></div>"

#. module: ncollection_billing
#: model:mail.template,body_html:ncollection_billing.mail_template_plan_change
msgid "<div>\n                    <p>Hello <t t-out=\"object.tenant_id.company_name or ''\"/>,</p>\n                    <p>Your subscription plan has been changed<t t-if=\"ctx.get('old_plan')\"> from\n                       <strong><t t-out=\"ctx.get('old_plan')\"/></strong></t> to\n                       <strong><t t-out=\"ctx.get('new_plan') or object.plan_id.name or ''\"/></strong>.\n                       Any price difference is prorated on your next invoice.</p>\n                </div>\n            "
msgstr "<div><p>مرحبًا <t t-out=\"object.tenant_id.company_name or ''\"/>،</p><p>تم تغيير خطة اشتراكك<t t-if=\"ctx.get('old_plan')\"> من <strong><t t-out=\"ctx.get('old_plan')\"/></strong></t> إلى <strong><t t-out=\"ctx.get('new_plan') or object.plan_id.name or ''\"/></strong>. تُحتسب أي فروقات في السعر بالتناسب على فاتورتك القادمة.</p></div>"

#. module: ncollection_billing
#: model:mail.template,body_html:ncollection_billing.mail_template_suspended
msgid "<div>\n                    <p>Hello <t t-out=\"object.tenant_id.company_name or ''\"/>,</p>\n                    <p>Your workspace has been suspended after the grace period ended. Your data is\n                       safe. Settle the outstanding balance to reactivate your\n                       <strong><t t-out=\"object.plan_id.name or ''\"/></strong> subscription.</p>\n                </div>\n            "
msgstr "<div><p>مرحبًا <t t-out=\"object.tenant_id.company_name or ''\"/>،</p><p>تم تعليق مساحة عملك بعد انتهاء فترة السماح. بياناتك بأمان. سدّد الرصيد المستحق لإعادة تفعيل اشتراكك في <strong><t t-out=\"object.plan_id.name or ''\"/></strong>.</p></div>"

