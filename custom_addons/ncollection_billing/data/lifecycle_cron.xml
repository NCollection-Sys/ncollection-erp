<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Daily subscription lifecycle + dunning sweep (P2-T14). Drives, once
            per day and idempotently: advance-warning emails (30/14/7/1 days),
            trial expiry, expiry after end_date + 48h, suspension after the
            grace window, and the dunning reminder schedule. Runs in the ADMIN
            DB; suspension reaches tenants only through the existing SaaS
            action_suspend override (config-sync -> P2-T03 interstitial).
        -->
        <record id="cron_lifecycle_sweep" model="ir.cron">
            <field name="name">NCollection: subscription lifecycle &amp; dunning sweep</field>
            <field name="model_id" ref="ncollection_subscription.model_ncollection_subscription"/>
            <field name="state">code</field>
            <field name="code">model._cron_lifecycle_sweep()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
