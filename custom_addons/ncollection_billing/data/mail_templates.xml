<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- P2-T14 lifecycle emails. Sent by the daily scheduler to the tenant's
             billing contact: an advance-warning before expiry, and a dunning
             reminder while an invoice is overdue. Kept deliberately plain — the
             renewal/pay flow is Odoo's native invoice portal (P2-T13). -->

        <record id="mail_template_expiry_warning" model="mail.template">
            <field name="name">NCollection: Subscription Expiry Warning</field>
            <field name="model_id" ref="ncollection_subscription.model_ncollection_subscription"/>
            <field name="subject">Your NCollection subscription expires soon ({{ object.days_remaining }} days)</field>
            <field name="email_to">{{ object.tenant_id.email or '' }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.tenant_id.company_name or ''"/>,</p>
                    <p>Your <strong><t t-out="object.plan_id.name or ''"/></strong> subscription
                       expires on <t t-out="object.end_date or ''"/>
                       (in <t t-out="object.days_remaining"/> days).</p>
                    <p>Please renew to avoid any interruption to your workspace.</p>
                </div>
            </field>
        </record>

        <record id="mail_template_dunning" model="mail.template">
            <field name="name">NCollection: Subscription Payment Reminder</field>
            <field name="model_id" ref="ncollection_subscription.model_ncollection_subscription"/>
            <field name="subject">Payment overdue for your NCollection subscription</field>
            <field name="email_to">{{ object.tenant_id.email or '' }}</field>
            <field name="auto_delete" eval="False"/>
            <field name="body_html" type="html">
                <div>
                    <p>Hello <t t-out="object.tenant_id.company_name or ''"/>,</p>
                    <p>We were unable to collect payment for your
                       <strong><t t-out="object.plan_id.name or ''"/></strong> subscription.</p>
                    <p>Please settle the outstanding invoice to keep your workspace active.</p>
                </div>
            </field>
        </record>
    </data>
</odoo>
