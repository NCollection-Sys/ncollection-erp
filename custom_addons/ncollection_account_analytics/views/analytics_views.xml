<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- F4-T01 (#120): a definition list, not a report. FPA §7 lists Reports
         under this module's "Must Never Own" — rendering these figures is
         ncollection_account_reports' job (#315, which depends on this ticket).
         What a finance manager needs here is to set a target and a period. -->
    <record id="view_analytics_kpi_list" model="ir.ui.view">
        <field name="name">ncollection.account.analytics.kpi.list</field>
        <field name="model">ncollection.account.analytics.kpi</field>
        <field name="arch" type="xml">
            <list string="Financial KPIs" create="false" delete="false">
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="key"/>
                <field name="unit"/>
                <field name="period_type"/>
                <field name="target_value"/>
            </list>
        </field>
    </record>

    <record id="view_analytics_kpi_form" model="ir.ui.view">
        <field name="name">ncollection.account.analytics.kpi.form</field>
        <field name="model">ncollection.account.analytics.kpi</field>
        <field name="arch" type="xml">
            <form string="Financial KPI">
                <sheet>
                    <group>
                        <group string="Definition">
                            <!-- `key` selects the computation and is not
                                 editable: the formula is a closed Python
                                 dispatch, so a key with no method would be a
                                 KPI that silently computes nothing. -->
                            <field name="key" readonly="1"/>
                            <field name="name"/>
                            <field name="unit" readonly="1"/>
                        </group>
                        <group string="Measurement">
                            <field name="period_type"/>
                            <field name="target_value"/>
                            <field name="active"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_analytics_kpi" model="ir.actions.act_window">
        <field name="name">Financial KPIs</field>
        <field name="res_model">ncollection.account.analytics.kpi</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_ncollection_analytics"
              name="Financial Analytics"
              parent="account.menu_finance_configuration"
              sequence="90"/>

    <menuitem id="menu_analytics_kpi" name="Financial KPIs"
              parent="menu_ncollection_analytics"
              action="action_analytics_kpi" sequence="10"/>
</odoo>
