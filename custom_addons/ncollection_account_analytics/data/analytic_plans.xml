<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
    <!-- F4-T01 (#120): the three dimensions FPA §7 names, as ROOT analytic
         plans. Odoo validates the 100% distribution rule INDEPENDENTLY per root
         plan (analytic_mixin._validate_distribution), so one journal item can
         carry a Department split, a Cost Centre split and a Profit Centre split
         at once, each checked on its own. That is the whole reason this module
         defines no dimension model of its own — Standing Rule 2, extend before
         replacing.

         noupdate="1" BECAUSE TENANTS RENAME THESE. A record without it is
         write()-ten from the XML on every `-u`, so a tenant who renamed
         "Departments" to "Business Units" would find it silently renamed back
         on the next upgrade — no log, no warning. Nothing here needs
         overwriting to keep working: `dimension.py` keys on the EXTERNAL ID,
         never on `name`, so the three roots stay resolvable however they are
         labelled. A future structural correction ships as a migration script,
         which is the Odoo pattern for exactly this.

         Tenants add their own analytic accounts underneath; none are seeded,
         because a cost-centre tree is a business's own shape and inventing one
         would be a guess every tenant then has to undo. -->
    <record id="analytic_plan_department" model="account.analytic.plan">
        <field name="name">Departments</field>
        <field name="default_applicability">optional</field>
    </record>

    <record id="analytic_plan_cost_center" model="account.analytic.plan">
        <field name="name">Cost Centers</field>
        <field name="default_applicability">optional</field>
    </record>

    <record id="analytic_plan_profit_center" model="account.analytic.plan">
        <field name="name">Profit Centers</field>
        <field name="default_applicability">optional</field>
    </record>
    </data>
</odoo>
