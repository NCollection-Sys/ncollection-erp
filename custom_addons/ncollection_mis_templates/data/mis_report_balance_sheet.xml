<?xml version="1.0" encoding="utf-8"?>
<!--
    Balance Sheet template (P3-T10 go-live fix).

    Grouping is by account_type (Odoo-core selection, identical across every
    chart including l10n_ae), NOT by hardcoded code prefixes — so it reconciles
    to the GL on the UAE CoA (P3-T05) rather than a generic numbering. `bale`
    = ending balance (a balance sheet is cumulative, not a period movement).
    Liability/equity/earnings are credit-normal, so their signed balance is
    negated to present positive figures; with Current Year Earnings included,
    TOTAL ASSETS == TOTAL LIABILITIES & EQUITY to the penny.

    NOT noupdate: this is a platform-owned template whose corrections must reach
    existing tenants on upgrade (the module is a tactical bootstrap, sunset by
    ncollection_account_reports / #117).
-->
<odoo>

    <record id="mis_report_bs" model="mis.report">
        <field name="name">Balance Sheet</field>
    </record>

    <!-- ============ ASSETS ============ -->
    <record id="bs_kpi_current_assets" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">current_assets</field>
        <field name="description">Current Assets</field>
        <field name="sequence">10</field>
        <field name="auto_expand_accounts">True</field>
    </record>
    <record id="bs_kpi_current_assets_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="bs_kpi_current_assets"/>
        <field name="name">bale[][('account_id.account_type', 'in', ('asset_receivable', 'asset_cash', 'asset_current', 'asset_prepayments'))]</field>
    </record>

    <record id="bs_kpi_fixed_assets" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">fixed_assets</field>
        <field name="description">Fixed &amp; Other Assets</field>
        <field name="sequence">20</field>
        <field name="auto_expand_accounts">True</field>
    </record>
    <record id="bs_kpi_fixed_assets_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="bs_kpi_fixed_assets"/>
        <field name="name">bale[][('account_id.account_type', 'in', ('asset_non_current', 'asset_fixed'))]</field>
    </record>

    <record id="bs_kpi_total_assets" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">total_assets</field>
        <field name="description">TOTAL ASSETS</field>
        <field name="sequence">30</field>
    </record>
    <record id="bs_kpi_total_assets_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="bs_kpi_total_assets"/>
        <field name="name">current_assets + fixed_assets</field>
    </record>

    <!-- ============ LIABILITIES ============ -->
    <record id="bs_kpi_current_liab" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">current_liabilities</field>
        <field name="description">Current Liabilities</field>
        <field name="sequence">50</field>
        <field name="auto_expand_accounts">True</field>
    </record>
    <record id="bs_kpi_current_liab_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="bs_kpi_current_liab"/>
        <field name="name">-bale[][('account_id.account_type', 'in', ('liability_payable', 'liability_credit_card', 'liability_current'))]</field>
    </record>

    <record id="bs_kpi_long_term_liab" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">long_term_liabilities</field>
        <field name="description">Long-Term Liabilities</field>
        <field name="sequence">60</field>
        <field name="auto_expand_accounts">True</field>
    </record>
    <record id="bs_kpi_long_term_liab_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="bs_kpi_long_term_liab"/>
        <field name="name">-bale[][('account_id.account_type', '=', 'liability_non_current')]</field>
    </record>

    <record id="bs_kpi_total_liab" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">total_liabilities</field>
        <field name="description">TOTAL LIABILITIES</field>
        <field name="sequence">70</field>
    </record>
    <record id="bs_kpi_total_liab_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="bs_kpi_total_liab"/>
        <field name="name">current_liabilities + long_term_liabilities</field>
    </record>

    <!-- ============ EQUITY ============ -->
    <record id="bs_kpi_equity" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">equity</field>
        <field name="description">Equity</field>
        <field name="sequence">80</field>
        <field name="auto_expand_accounts">True</field>
    </record>
    <record id="bs_kpi_equity_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="bs_kpi_equity"/>
        <field name="name">-bale[][('account_id.account_type', 'in', ('equity', 'equity_unaffected'))]</field>
    </record>

    <!-- Current-year result (income - expense, cumulative). Without this a
         balance sheet never balances mid-year, because the year's P&amp;L is not
         posted to an equity account until year-end closing. -->
    <record id="bs_kpi_current_earnings" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">current_year_earnings</field>
        <field name="description">Current Year Earnings</field>
        <field name="sequence">85</field>
    </record>
    <record id="bs_kpi_current_earnings_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="bs_kpi_current_earnings"/>
        <field name="name">-bale[][('account_id.account_type', 'in', ('income', 'income_other', 'expense', 'expense_direct_cost', 'expense_depreciation'))]</field>
    </record>

    <record id="bs_kpi_total_liab_eq" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_bs"/>
        <field name="name">total_liab_equity</field>
        <field name="description">TOTAL LIABILITIES &amp; EQUITY</field>
        <field name="sequence">90</field>
    </record>
    <record id="bs_kpi_total_liab_eq_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="bs_kpi_total_liab_eq"/>
        <field name="name">total_liabilities + equity + current_year_earnings</field>
    </record>

</odoo>
