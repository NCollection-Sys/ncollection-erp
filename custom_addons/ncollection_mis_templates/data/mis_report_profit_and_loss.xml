<?xml version="1.0" encoding="utf-8"?>
<!--
    Profit & Loss template (P3-T10 go-live fix).

    Grouped by account_type (Odoo-core, chart-agnostic) so it reconciles to the
    GL on the UAE CoA (P3-T05), not a generic code numbering. `balp` = period
    variation (a P&L is a flow over the period). Income is credit-normal, so its
    signed balance is negated to present positive revenue; expenses are
    debit-normal and presented as-is.

    NOT noupdate: platform-owned template whose corrections must reach existing
    tenants on upgrade (tactical bootstrap, sunset by #117).
-->
<odoo>

    <record id="mis_report_pl" model="mis.report">
        <field name="name">Profit &amp; Loss</field>
    </record>

    <!-- ============ INCOME ============ -->
    <record id="pl_kpi_revenue" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_pl"/>
        <field name="name">revenue</field>
        <field name="description">Sales Revenue</field>
        <field name="sequence">10</field>
        <field name="auto_expand_accounts">True</field>
    </record>
    <record id="pl_kpi_revenue_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="pl_kpi_revenue"/>
        <field name="name">-balp[][('account_id.account_type', '=', 'income')]</field>
    </record>

    <record id="pl_kpi_other_income" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_pl"/>
        <field name="name">other_income</field>
        <field name="description">Other Operating Income</field>
        <field name="sequence">20</field>
        <field name="auto_expand_accounts">True</field>
    </record>
    <record id="pl_kpi_other_income_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="pl_kpi_other_income"/>
        <field name="name">-balp[][('account_id.account_type', '=', 'income_other')]</field>
    </record>

    <record id="pl_kpi_total_income" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_pl"/>
        <field name="name">total_income</field>
        <field name="description">TOTAL INCOME</field>
        <field name="sequence">30</field>
    </record>
    <record id="pl_kpi_total_income_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="pl_kpi_total_income"/>
        <field name="name">revenue + other_income</field>
    </record>

    <!-- ============ COST OF GOODS SOLD ============ -->
    <record id="pl_kpi_cogs" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_pl"/>
        <field name="name">cogs</field>
        <field name="description">Cost of Goods Sold</field>
        <field name="sequence">40</field>
        <field name="auto_expand_accounts">True</field>
    </record>
    <record id="pl_kpi_cogs_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="pl_kpi_cogs"/>
        <field name="name">balp[][('account_id.account_type', '=', 'expense_direct_cost')]</field>
    </record>

    <record id="pl_kpi_gross_profit" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_pl"/>
        <field name="name">gross_profit</field>
        <field name="description">GROSS PROFIT</field>
        <field name="sequence">50</field>
    </record>
    <record id="pl_kpi_gross_profit_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="pl_kpi_gross_profit"/>
        <field name="name">total_income - cogs</field>
    </record>

    <!-- ============ OPERATING EXPENSES ============ -->
    <record id="pl_kpi_op_expenses" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_pl"/>
        <field name="name">operating_expenses</field>
        <field name="description">Operating Expenses</field>
        <field name="sequence">60</field>
        <field name="auto_expand_accounts">True</field>
    </record>
    <record id="pl_kpi_op_expenses_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="pl_kpi_op_expenses"/>
        <field name="name">balp[][('account_id.account_type', 'in', ('expense', 'expense_other', 'expense_depreciation'))]</field>
    </record>

    <record id="pl_kpi_operating_profit" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_pl"/>
        <field name="name">operating_profit</field>
        <field name="description">OPERATING PROFIT</field>
        <field name="sequence">70</field>
    </record>
    <record id="pl_kpi_operating_profit_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="pl_kpi_operating_profit"/>
        <field name="name">gross_profit - operating_expenses</field>
    </record>

    <!-- ============ NET PROFIT ============ -->
    <record id="pl_kpi_net_profit" model="mis.report.kpi">
        <field name="report_id" ref="mis_report_pl"/>
        <field name="name">net_profit</field>
        <field name="description">NET PROFIT</field>
        <field name="sequence">80</field>
    </record>
    <record id="pl_kpi_net_profit_expr" model="mis.report.kpi.expression">
        <field name="kpi_id" ref="pl_kpi_net_profit"/>
        <field name="name">operating_profit</field>
    </record>

</odoo>
