<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- Balance Sheet — current period instance -->
    <record id="mis_report_instance_bs" model="mis.report.instance">
        <field name="name">Balance Sheet — Current Period</field>
        <field name="report_id" ref="mis_report_bs"/>
        <field name="comparison_mode" eval="True"/>
    </record>

    <record id="mis_report_instance_bs_period_actual" model="mis.report.instance.period">
        <field name="report_instance_id" ref="mis_report_instance_bs"/>
        <field name="name">Actual</field>
        <field name="sequence">10</field>
        <field name="mode">relative</field>
        <field name="type">d</field>
        <field name="offset">0</field>
        <field name="duration">1</field>
    </record>

    <!-- Profit &amp; Loss — current month instance -->
    <record id="mis_report_instance_pl" model="mis.report.instance">
        <field name="name">Profit &amp; Loss — Current Month</field>
        <field name="report_id" ref="mis_report_pl"/>
        <field name="comparison_mode" eval="True"/>
    </record>

    <record id="mis_report_instance_pl_period_actual" model="mis.report.instance.period">
        <field name="report_instance_id" ref="mis_report_instance_pl"/>
        <field name="name">This Month</field>
        <field name="sequence">10</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">0</field>
        <field name="duration">1</field>
    </record>

    <record id="mis_report_instance_pl_period_prev" model="mis.report.instance.period">
        <field name="report_instance_id" ref="mis_report_instance_pl"/>
        <field name="name">Previous Month</field>
        <field name="sequence">20</field>
        <field name="mode">relative</field>
        <field name="type">m</field>
        <field name="offset">-1</field>
        <field name="duration">1</field>
    </record>

</odoo>
