<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nc_audit_seal_list" model="ir.ui.view">
        <field name="name">ncollection.audit.seal.list</field>
        <field name="model">ncollection.audit.seal</field>
        <field name="arch" type="xml">
            <list string="Audit Seals" create="false" edit="false" delete="false"
                  decoration-muted="pruned_at">
                <field name="sealed_at"/>
                <field name="from_log_id"/>
                <field name="to_log_id"/>
                <field name="log_count" sum="Entries"/>
                <field name="pruned_at" optional="show"/>
                <field name="digest" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_nc_audit_seal" model="ir.actions.act_window">
        <field name="name">Audit Seals</field>
        <field name="res_model">ncollection.audit.seal</field>
        <field name="view_mode">list</field>
        <!-- Rule 4: mirrored at the ORM. security/ir.model.access.csv grants
             this model to the two auditlog groups and to nobody else, so an
             RPC read from any other role is refused whether or not the menu
             is visible. -->
        <field name="group_ids" eval="[(4, ref('auditlog.group_auditlog_user'))]"/>
    </record>

    <menuitem id="menu_nc_audit_seal" name="Audit Seals"
              parent="auditlog.menu_audit" action="action_nc_audit_seal"
              sequence="90" groups="auditlog.group_auditlog_user"/>
</odoo>
