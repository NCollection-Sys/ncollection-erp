<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_nc_audit_center" model="ir.actions.client">
        <field name="name">Audit Log</field>
        <field name="tag">ncollection_audit.audit_center</field>
    </record>

    <record id="view_nc_audit_policy_list" model="ir.ui.view">
        <field name="name">ncollection.audit.policy.list</field>
        <field name="model">ncollection.audit.policy</field>
        <field name="arch" type="xml">
            <list string="Recorded Document Types" editable="bottom">
                <field name="model_id" options="{'no_create': True}"/>
                <field name="model" optional="hide"/>
                <field name="log_create" widget="boolean_toggle"/>
                <field name="log_write" widget="boolean_toggle"/>
                <field name="log_unlink" widget="boolean_toggle"/>
                <field name="excluded_field_ids" widget="many2many_tags" optional="show"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>
    <record id="action_nc_audit_policy" model="ir.actions.act_window">
        <field name="name">Recorded Document Types</field>
        <field name="res_model">ncollection.audit.policy</field>
        <field name="view_mode">list</field>
        <field name="context">{'active_test': False}</field>
        <field name="help" type="html">
            <p>Which business documents the Audit Log records. Restricted fields, credentials and files are never
               recorded, whatever is chosen here.</p>
        </field>
    </record>
</odoo>
