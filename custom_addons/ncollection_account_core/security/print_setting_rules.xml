<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A document's Print Settings are seen only within the companies the user works in (the document's own rule
         applies on top: every write checks the move's write access). -->
    <record id="rule_move_print_setting_company" model="ir.rule">
        <field name="name">Print Settings: allowed companies</field>
        <field name="model_id" ref="model_ncollection_move_print_setting"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
