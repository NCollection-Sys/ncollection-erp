<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- File names of the printed documents (PRINT-01): "<kind> <number>" from nc.document.print.mixin
         (_nc_print_filename), e.g. "Vendor Bill BILL-2026-00007", for Print (Odoo's download route) and View alike.
         Only the file name: the report, its content and the document's number are unchanged. -->
    <record id="account.account_invoices" model="ir.actions.report">
        <field name="print_report_name">object._nc_print_filename()</field>
    </record>
    <record id="account.account_invoices_without_payment" model="ir.actions.report">
        <field name="print_report_name">object._nc_print_filename()</field>
    </record>
    <record id="account.action_report_payment_receipt" model="ir.actions.report">
        <field name="print_report_name">object._nc_print_filename()</field>
    </record>
</odoo>
