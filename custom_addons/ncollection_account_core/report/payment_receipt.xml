<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- THE PAYMENT RECEIPT, as a document.

         Odoo's own receipt lists the invoice, then the payment itself as a negative "invoice" row, then a due amount: a
         reconciliation ledger, not a receipt. This one says what a receipt says: who paid, when, how, how much, what it
         settled and what is left, from the payment's NATIVE reconciliation (the partials Odoo keeps: one row per
         document the payment was applied to, the amount applied, the balance still due on it) and from nothing of ours.
         The payment is never shown as if it were one of the documents it was applied to.

         LAYOUTS. The o_nc_* classes below are styled by the Professional layout (ncollection_branding) and by nothing
         else, so under any other Configure Document Layout choice (Light, Boxed, Bold, Striped, Bubble, Wave, Folder)
         the tables used to print bare: no width, no padding, and the layout's table frame drawn around every small
         block. Under a stock layout the two DATA tables therefore take Odoo's own report classes (table o_main_table),
         so each layout draws them exactly as it draws its invoice lines; the amount panel, the totals and the
         signature lines are not data grids, so they opt out of the layout's table design (o_ignore_layout_styling,
         Odoo's own switch) and carry the small neutral stylesheet below. The Professional output is unchanged. -->
    <template id="report_payment_receipt_document_nc" inherit_id="account.report_payment_receipt_document">
        <xpath expr="//div[hasclass('page')]" position="replace">
            <t t-set="nc_applied" t-value="o._nc_applied_rows()"/>
            <t t-set="nc_rows" t-value="nc_applied[0]"/>
            <t t-set="nc_unallocated" t-value="nc_applied[1]"/>
            <t t-set="nc_labels" t-value="o._nc_receipt_labels()"/>
            <t t-set="nc_words" t-value="o._nc_amount_in_words()"/>
            <t t-set="nc_applied_total" t-value="sum(row['applied'] for row in nc_rows)"/>
            <t t-set="nc_rtl" t-value="o.env['res.lang']._get_data(code=o.env.lang or 'en_US').direction == 'rtl'"/>
            <t t-set="nc_stock" t-value="o.company_id.external_report_layout_id.key != 'ncollection_branding.external_layout_nc'"/>
            <t t-set="nc_data_class" t-value="'o_nc_table table o_main_table' if nc_stock else 'o_nc_table'"/>
            <t t-set="nc_plain_class" t-value="' o_ignore_layout_styling' if nc_stock else ''"/>
            <t t-set="layout_document_title">
                <span t-field="o.payment_receipt_title"/> <span t-field="o.name"/>
            </t>
            <t t-set="address">
                <div class="o_nc_label" t-out="nc_labels['party']"/>
                <address t-field="o.partner_id"
                         t-options='{"widget": "contact", "fields": ["name", "address", "phone"], "no_marker": true}'/>
                <div t-if="o.partner_id.vat" class="muted">
                    <span t-out="o.partner_id.country_id.vat_label or 'Tax ID'"/>: <span t-field="o.partner_id.vat"/>
                </div>
            </t>

            <div t-attf-class="page o_nc_receipt#{' o_nc_receipt_stock' if nc_stock else ''}">
                <style t-if="nc_stock">
                    .o_nc_receipt_stock .o_nc_label { display: block; color: #5c6670; font-size: 9.4pt; font-weight: bold; text-transform: uppercase; margin-bottom: 1.2mm; }
                    .o_nc_receipt_stock table.o_nc_table { width: 100%; margin: 0 0 7mm 0; }
                    .o_nc_receipt_stock table.o_nc_table th, .o_nc_receipt_stock table.o_nc_table td { padding: 2.2mm 2.8mm; vertical-align: middle; }
                    .o_nc_receipt_stock table.o_nc_table tr { page-break-inside: avoid; }
                    .o_nc_receipt_stock table.o_nc_table thead { display: table-header-group; }
                    .o_nc_receipt_stock table.o_nc_amount, .o_nc_receipt_stock table.o_nc_totals, .o_nc_receipt_stock table.o_nc_signatures {
                        border-collapse: collapse; border: 0 none !important; background: transparent; page-break-inside: avoid; }
                    .o_nc_receipt_stock table.o_nc_amount tbody, .o_nc_receipt_stock table.o_nc_amount tr, .o_nc_receipt_stock table.o_nc_totals tbody, .o_nc_receipt_stock table.o_nc_totals tr,
                    .o_nc_receipt_stock table.o_nc_signatures tbody, .o_nc_receipt_stock table.o_nc_signatures tr { border: 0 none !important; background: transparent; }
                    .o_nc_receipt_stock table.o_nc_amount { width: 100%; margin: 0 0 7mm 0; }
                    .o_nc_receipt_stock table.o_nc_amount td { border: 0.25mm solid #ced4da !important; padding: 3.2mm 3.8mm; vertical-align: top; background: #f8f9fa; }
                    .o_nc_receipt_stock table.o_nc_amount .o_nc_figure { font-size: 19pt; font-weight: bold; line-height: 1.15; white-space: nowrap; }
                    .o_nc_receipt_stock table.o_nc_amount .o_nc_words { font-size: 10.5pt; line-height: 1.45; }
                    .o_nc_receipt_stock .o_nc_note { color: #495057; font-size: 9pt; margin: 0 0 7mm 0; }
                    .o_nc_receipt_stock table.o_nc_totals { margin-top: 1mm; margin-bottom: 0; }
                    .o_nc_receipt_stock table.o_nc_totals td { padding: 2mm 2.8mm; border: 0 none !important; border-bottom: 0.2mm solid #dee2e6 !important; background: transparent; }
                    .o_nc_receipt_stock table.o_nc_totals tr.o_nc_grand td { border-top: 0.45mm solid #343a40 !important; border-bottom: 0 none !important; font-size: 11.5pt; font-weight: bold; }
                    .o_nc_receipt_stock table.o_nc_signatures { width: 100%; margin-top: 20mm; }
                    .o_nc_receipt_stock table.o_nc_signatures td { width: 40%; border: 0 none !important; border-top: 0.3mm solid #495057 !important; padding: 2mm 0 0 0; color: #343a40; font-size: 10.5pt; background: transparent; }
                    .o_nc_receipt_stock table.o_nc_signatures td.o_nc_gap { width: 20%; border-top: 0 none !important; }
                    .o_nc_receipt_stock .o_nc_status { font-weight: bold; }
                </style>
                <table t-att-class="nc_data_class" name="nc_receipt_info">
                    <thead>
                        <tr>
                            <th>Payment date</th>
                            <th t-if="values['display_payment_method'] and o.payment_method_id">Payment method</th>
                            <th t-if="o.journal_id">Journal</th>
                            <th t-if="o.memo">Reference</th>
                            <th>Status</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr>
                            <td><span t-field="o.date"/></td>
                            <td t-if="values['display_payment_method'] and o.payment_method_id"><span t-field="o.payment_method_id.name"/></td>
                            <td t-if="o.journal_id"><span t-field="o.journal_id.name"/></td>
                            <td t-if="o.memo" dir="auto"><span t-field="o.memo"/></td>
                            <td><span t-attf-class="o_nc_status o_nc_status_#{o.state}" t-field="o.state"/></td>
                        </tr>
                    </tbody>
                </table>

                <table t-attf-class="#{'o_nc_amount' if nc_stock else 'o_nc_table o_nc_amount'}#{nc_plain_class}" name="nc_receipt_amount">
                    <tbody>
                        <tr>
                            <td style="width: 38%;">
                                <div class="o_nc_label">Amount</div>
                                <div class="o_nc_figure" style="font-size: 19pt; font-weight: bold;">
                                    <span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/>
                                </div>
                            </td>
                            <td t-if="nc_words" dir="auto">
                                <div class="o_nc_label">Amount in words</div>
                                <div class="o_nc_words" t-out="nc_words"/>
                            </td>
                        </tr>
                    </tbody>
                </table>

                <t t-if="nc_rows">
                    <div class="o_nc_label" style="margin-bottom: 1.5mm;">Applied to</div>
                    <table t-att-class="nc_data_class" name="nc_receipt_documents">
                        <thead>
                            <tr>
                                <th><span t-out="nc_labels['document']"/></th>
                                <th>Date</th>
                                <th class="text-end">Document total</th>
                                <th class="text-end">Applied</th>
                                <th class="text-end">Balance due</th>
                            </tr>
                        </thead>
                        <tbody>
                            <tr t-foreach="nc_rows" t-as="row">
                                <t t-set="doc" t-value="row['move']"/>
                                <td><span t-field="doc.name"/></td>
                                <td><span t-field="doc.invoice_date"/></td>
                                <td class="text-end"><span t-out="doc.amount_total" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                                <td class="text-end"><strong><span t-out="row['applied']" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></strong></td>
                                <td class="text-end"><span t-out="doc.amount_residual" t-options="{'widget': 'monetary', 'display_currency': doc.currency_id}"/></td>
                            </tr>
                        </tbody>
                    </table>
                </t>
                <p t-elif="o.state != 'draft'" class="muted o_nc_note">
                    This payment is not applied to any invoice or bill; the whole amount is held as credit on the account.
                </p>
                <p t-if="o.state == 'draft'" class="muted o_nc_note">
                    This payment has not been confirmed yet, so nothing has been applied.
                </p>

                <!-- The closing block: totals + signature lines, never split. With a long "Applied to" list the
                     signature lines used to fall alone onto a last page; now the totals travel with them. -->
                <div class="o_nc_receipt_close" name="nc_receipt_close" style="page-break-inside: avoid;">
                <table t-attf-class="o_nc_totals#{nc_plain_class}" name="nc_receipt_totals" t-attf-style="width: 52%; margin-#{'right' if nc_rtl else 'left'}: auto;">
                    <tr>
                        <td>Applied to documents</td>
                        <td class="text-end"><span t-out="nc_applied_total" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                    </tr>
                    <tr t-if="o.state != 'draft'">
                        <td>Not applied (credit on account)</td>
                        <td class="text-end"><span t-out="nc_unallocated" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                    </tr>
                    <tr class="o_nc_grand">
                        <td>Payment amount</td>
                        <td class="text-end"><span t-field="o.amount" t-options="{'widget': 'monetary', 'display_currency': o.currency_id}"/></td>
                    </tr>
                </table>

                <table t-attf-class="o_nc_signatures#{nc_plain_class}">
                    <tr>
                        <td>Received by</td>
                        <td class="o_nc_gap"/>
                        <td>Authorised signature</td>
                    </tr>
                </table>
                </div>
            </div>
        </xpath>
    </template>
</odoo>
