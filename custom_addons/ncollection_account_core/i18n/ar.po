#. module: ncollection_account_core
#. odoo-python
#: code:addons/ncollection_account_core/models/res_company_defaults.py:0
msgid "%(account)s cannot be the %(field)s of %(company)s."
msgstr "%(account)s لا يمكن أن يكون %(field)s لـ %(company)s."

#. module: ncollection_account_core
#. odoo-python
#: code:addons/ncollection_account_core/wizards/business_settings.py:0
msgid "%(company)s already has a chart of accounts. Replacing it would delete its accounts, taxes and journals; ask the platform administrator."
msgstr "لدى %(company)s دليل حسابات بالفعل. استبداله سيحذف حساباته وضرائبه ودفاتر يوميته؛ اطلب ذلك من مسؤول المنصة."

#. module: ncollection_account_core
#. odoo-python
#: code:addons/ncollection_account_core/wizards/business_settings.py:0
msgid "%(company)s already has accounts, taxes, journals or fiscal positions (or a branch with a chart). Loading a chart would delete them; ask the platform administrator."
msgstr "لدى %(company)s حسابات أو ضرائب أو دفاتر يومية أو أوضاع مالية بالفعل (أو فرع لديه دليل حسابات). تحميل دليل حسابات سيحذفها؛ اطلب ذلك من مسؤول المنصة."

#. module: ncollection_account_core
#. odoo-python
#: code:addons/ncollection_account_core/wizards/business_settings.py:0
msgid "%(company)s keeps the chart of accounts of another country than its fiscal country, so its main currency cannot be changed on its own."
msgstr "يحتفظ %(company)s بدليل حسابات لدولة غير دولته المالية، لذا لا يمكن تغيير عملته الرئيسية وحدها."

#. module: ncollection_account_core
#. odoo-python
#: code:addons/ncollection_account_core/wizards/business_settings.py:0
msgid "%(company)s uses a chart of accounts that is not the %(country)s chart; changing only the fiscal country would keep the other country's accounts and taxes."
msgstr "يستخدم %(company)s دليل حسابات ليس دليل %(country)s؛ تغيير الدولة المالية وحدها سيُبقي حسابات وضرائب الدولة الأخرى."

#. module: ncollection_account_core
#. odoo-python
#: code:addons/ncollection_account_core/wizards/business_settings.py:0
msgid "%(detail)s This needs a controlled localization migration (new chart of accounts, taxes and fiscal positions, with the existing ones mapped and kept), run by the platform administrator. Nothing was changed."
msgstr "%(detail)s يتطلب ذلك ترحيل توطين مضبوطاً (دليل حسابات وضرائب وأوضاع مالية جديدة، مع ربط الحالية والاحتفاظ بها)، يُنفّذه مسؤول المنصة. لم يتغير شيء."

#. module: ncollection_account_core
#. odoo-python
#: code:addons/ncollection_account_core/models/account_payment.py:0
