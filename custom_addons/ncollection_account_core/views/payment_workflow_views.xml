<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- INVOICES / BILLS / CREDIT NOTES / RECEIPTS, every list (view_invoice_tree is the parent of all of them):
         Files, the payment figures and status (computed from the accounting, never stored), and View / Edit. -->
    <record id="view_invoice_tree_nc_payment_workflow" model="ir.ui.view">
        <field name="name">account.move.list.nc.payment.workflow</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='name']" position="after">
                <field name="nc_attachment_count" string="Files" widget="nc_attachment_count" optional="show"/>
            </xpath>
            <xpath expr="//field[@name='status_in_payment']" position="before">
                <field name="nc_amount_paid" optional="show" invisible="not nc_payment_status"/>
                <field name="nc_amount_due" optional="show" invisible="not nc_payment_status"
                       decoration-info="nc_amount_due &lt; 0"/>
                <field name="nc_overpaid_amount" optional="hide" invisible="not nc_overpaid_amount"/>
                <field name="nc_payment_status" widget="badge" optional="show"
                       decoration-success="nc_payment_status == 'paid'"
                       decoration-info="nc_payment_status == 'overpaid'"
                       decoration-warning="nc_payment_status == 'partial'"
                       decoration-danger="nc_payment_status == 'overdue'"
                       decoration-muted="nc_payment_status == 'unpaid'"/>
            </xpath>
            <xpath expr="//list" position="inside">
                <button name="action_nc_view" type="object" string="View" icon="fa-eye" title="View"/>
                <button name="action_nc_edit" type="object" string="Edit" icon="fa-pencil" title="Edit"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>

    <!-- FILTER-01. Overpaid (the stored, invoice-specific excess), Taxable and Non-taxable (by the tax GROUP of the
         lines: zero-rated is taxable, exempt / out of scope / untaxed is not - never "VAT amount = 0"). -->
    <record id="view_account_invoice_filter_nc_settlement" model="ir.ui.view">
        <field name="name">account.move.search.nc.settlement</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_account_invoice_filter"/>
        <field name="arch" type="xml">
            <xpath expr="//filter[@name='cancel']" position="after">
                <separator/>
                <filter name="nc_overpaid" string="Overpaid" domain="[('nc_overpaid_amount', '&gt;', 0)]"/>
                <separator/>
                <filter name="nc_taxable" string="Taxable" domain="[('nc_is_taxable', '=', True)]"/>
                <filter name="nc_non_taxable" string="Non-taxable" domain="[('nc_is_taxable', '=', False)]"/>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_search_nc_overpaid" model="ir.ui.view">
        <field name="name">account.payment.search.nc.overpaid</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_search"/>
        <field name="arch" type="xml">
            <xpath expr="//search" position="inside">
                <separator/>
                <filter name="nc_overpaid" string="Overpaid" domain="[('nc_is_overpaid', '=', True)]"/>
            </xpath>
        </field>
    </record>

    <!-- The form: what has been paid and the status, under Amount Due (the payments themselves, with the amount each
         applied, are Odoo's own list just above). -->
    <record id="view_move_form_nc_payment_status" model="ir.ui.view">
        <field name="name">account.move.form.nc.payment.status</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[hasclass('oe_subtotal_footer')]/field[@name='amount_residual']" position="before">
                <field name="nc_amount_paid" invisible="not nc_payment_status"/>
            </xpath>
            <xpath expr="//group[hasclass('oe_subtotal_footer')]/field[@name='amount_residual']" position="after">
                <field name="nc_payment_status" widget="badge" invisible="not nc_payment_status"
                       decoration-success="nc_payment_status == 'paid'"
                       decoration-info="nc_payment_status == 'overpaid'"
                       decoration-warning="nc_payment_status == 'partial'"
                       decoration-danger="nc_payment_status == 'overdue'"/>
            </xpath>
        </field>
    </record>

    <!-- PAYMENTS. Confirm posts and then applies the payment through Odoo's reconciliation (selected document first,
         then earliest due); Print Receipt and View render the one receipt report. -->
    <record id="view_account_payment_form_nc_workflow" model="ir.ui.view">
        <field name="name">account.payment.form.nc.workflow</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_post']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//header/button[@name='action_post']" position="after">
                <button name="action_nc_post_and_allocate" string="Confirm" type="object" class="oe_highlight"
                        invisible="state != 'draft'" data-hotkey="q"/>
            </xpath>
            <xpath expr="//header" position="inside">
                <button name="action_nc_print" string="Print Receipt" type="object" invisible="not id"/>
                <button name="action_nc_view" string="View" type="object" invisible="not id"/>
            </xpath>
            <xpath expr="//field[@name='memo']" position="after">
                <field name="nc_eligible_move_ids" invisible="1"/>
                <field name="nc_apply_first_move_id" invisible="state != 'draft' or not partner_id"
                       options="{'no_create': True}" placeholder="Optional: earliest due first"/>
            </xpath>
            <xpath expr="//sheet/group[@name='main_group']" position="after">
                <group string="Allocation" invisible="not partner_id">
                    <field name="nc_allocation_html" nolabel="1" colspan="2" readonly="1"/>
                    <field name="nc_unallocated_amount" invisible="1"/>
                </group>
            </xpath>
        </field>
    </record>

    <record id="view_account_payment_tree_nc_workflow" model="ir.ui.view">
        <field name="name">account.payment.list.nc.workflow</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='state']" position="before">
                <field name="nc_unallocated_amount" optional="show" invisible="state == 'draft'"/>
                <field name="nc_attachment_count" string="Files" widget="nc_attachment_count" optional="show"/>
            </xpath>
            <xpath expr="//list" position="inside">
                <button name="action_nc_view" type="object" string="View" icon="fa-eye" title="View"/>
                <button name="action_nc_edit" type="object" string="Edit" icon="fa-pencil" title="Edit"
                        groups="account.group_account_invoice"/>
            </xpath>
        </field>
    </record>

    <!-- STAMP-02: the Document Stamp switch of THIS document (nc.document.stamp.mixin, ncollection_branding). Default
         follows the Print Settings of its kind; On / Off applies to this document only. Changing it is enforced by
         the model (who may stamp the kind), the readonly here only says so. -->
    <record id="view_account_payment_form_nc_stamp_mode" model="ir.ui.view">
        <field name="name">account.payment.form.nc.stamp.mode</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group2']" position="inside">
                <field name="nc_stamp_mode_editable" invisible="1"/>
                <field name="nc_stamp_default_on" invisible="1"/>
                <label for="nc_stamp_mode"/>
                <div class="o_row">
                    <field name="nc_stamp_mode" widget="selection_badge" readonly="not nc_stamp_mode_editable"/>
                    <div class="text-muted" invisible="nc_stamp_mode != 'default' or not nc_stamp_default_on">(stamped)</div>
                    <div class="text-muted" invisible="nc_stamp_mode != 'default' or nc_stamp_default_on">(not stamped)</div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
