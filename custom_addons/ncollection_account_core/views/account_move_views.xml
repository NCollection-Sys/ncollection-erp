<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Custom print title of one customer document (invoice / credit note). -->
    <record id="view_move_form_nc_print_title" model="ir.ui.view">
        <field name="name">account.move.form.nc.print.title</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='sale_info_group']" position="inside">
                <field name="nc_print_title_enabled" string="Custom print title"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
                <field name="nc_print_title" string="Custom title" placeholder="TAX INVOICE"
                       invisible="move_type not in ('out_invoice', 'out_refund') or not nc_print_title_enabled"
                       required="nc_print_title_enabled and move_type in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>

    <!-- Product, Quantity and Unit on every invoice AND vendor bill line, as on a customer invoice. Odoo marks them
         optional="conditional" and its line renderer (account product_label_section_and_note_field_o2m.js) turns that
         into HIDDEN for every bill ("Vendor Bills -> Product should be hidden by default"), leaving only Label: a bill
         without a purchase order could not take a product. "show" is not rewritten by that renderer, so the columns
         are shown by default (a user can still hide them); a bill created from a purchase order is unchanged. -->
    <record id="view_move_form_nc_line_product" model="ir.ui.view">
        <field name="name">account.move.form.nc.line.product</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='product_id']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='quantity']" position="attributes">
                <attribute name="optional">show</attribute>
            </xpath>
        </field>
    </record>

    <!-- Line amounts (LINE-01/02): Amount right after Price, then the line total INCLUDING tax. Both are Odoo's own
         computed fields (price_subtotal / price_total, from the tax engine with the document's currency rounding and
         fiscal position): only their place in the list changes, no amount is computed here. When the company shows
         tax-included prices on customer documents, Odoo's Amount already IS price_total, so the extra column is only
         added where it says something new. -->
    <record id="view_move_form_nc_line_amounts" model="ir.ui.view">
        <field name="name">account.move.form.nc.line.amounts</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_unit']" position="after">
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_subtotal']" position="move"/>
                <xpath expr="//field[@name='invoice_line_ids']/list/field[@name='price_total']" position="move"/>
                <field name="price_total" string="Total incl. Tax"
                       column_invisible="parent.company_price_include == 'tax_included' and parent.move_type not in ('in_invoice', 'in_refund', 'in_receipt')"/>
            </xpath>
        </field>
    </record>

    <!-- STAMP-02: the Document Stamp switch of THIS document (nc.document.stamp.mixin, ncollection_branding). Default
         follows the Print Settings of its kind; On / Off applies to this document only. Changing it is enforced by
         the model (who may stamp the kind), the readonly here only says so. -->
    <record id="view_move_form_nc_stamp_mode" model="ir.ui.view">
        <field name="name">account.move.form.nc.stamp.mode</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@id='header_right_group']" position="inside">
                <field name="nc_stamp_mode_editable" invisible="1"/>
                <field name="nc_stamp_default_on" invisible="1"/>
                <label for="nc_stamp_mode" invisible="move_type == 'entry'"/>
                <div class="o_row" invisible="move_type == 'entry'">
                    <field name="nc_stamp_mode" widget="selection_badge" readonly="not nc_stamp_mode_editable"/>
                    <div class="text-muted" invisible="nc_stamp_mode != 'default' or not nc_stamp_default_on">(stamped)</div>
                    <div class="text-muted" invisible="nc_stamp_mode != 'default' or nc_stamp_default_on">(not stamped)</div>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
