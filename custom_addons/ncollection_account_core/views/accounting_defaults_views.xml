<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Settings > Accounting Defaults: the default accounts Odoo Community already has, on one page.
        Native res.company fields only (plus the four ir.default properties, see models/res_company_defaults.py).
        Reachable by the workspace Owner (system administrators): the same group res.company / ir.default writes
        require, so the menu and the ORM agree.
    -->
    <record id="view_nc_accounting_defaults_form" model="ir.ui.view">
        <field name="name">ncollection.accounting.defaults.form</field>
        <field name="model">res.company</field>
        <field name="priority">99</field>
        <field name="arch" type="xml">
            <form string="Accounting Defaults" create="false" delete="false">
                <sheet>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                        <p class="text-muted">
                            The accounts new records start with, and the accounts the accounting engine posts to.
                            These apply to this company only.
                        </p>
                    </div>
                    <group string="Customers and vendors">
                        <group>
                            <field name="nc_default_receivable_id" options="{'no_create': True}"/>
                            <field name="nc_default_payable_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Sales, purchases and products">
                        <group>
                            <!-- Odoo uses these as the starting accounts of every product category -->
                            <field name="income_account_id" options="{'no_create': True}"/>
                            <field name="expense_account_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="account_sale_tax_id" options="{'no_create': True}"/>
                            <field name="account_purchase_tax_id" options="{'no_create': True}"/>
                            <field name="account_price_include"/>
                            <field name="tax_calculation_rounding_method"/>
                        </group>
                    </group>
                    <group string="Bank, cash and transfers">
                        <group>
                            <field name="transfer_account_id" options="{'no_create': True}"/>
                            <field name="account_journal_suspense_account_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="default_cash_difference_income_account_id" options="{'no_create': True}"/>
                            <field name="default_cash_difference_expense_account_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Currency differences and early-payment discounts">
                        <group>
                            <field name="currency_exchange_journal_id" options="{'no_create': True}"/>
                            <field name="income_currency_exchange_account_id" options="{'no_create': True}"/>
                            <field name="expense_currency_exchange_account_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <field name="account_journal_early_pay_discount_gain_account_id" options="{'no_create': True}"/>
                            <field name="account_journal_early_pay_discount_loss_account_id" options="{'no_create': True}"/>
                        </group>
                    </group>
                    <group string="Deferrals and accruals (Change Period)">
                        <group>
                            <field name="revenue_accrual_account_id" options="{'no_create': True}"/>
                            <field name="expense_accrual_account_id" options="{'no_create': True}"/>
                            <field name="automatic_entry_default_journal_id" options="{'no_create': True}"/>
                        </group>
                        <group>
                            <div class="text-muted">
                                Odoo Community has no automatic deferred revenue or expense engine. These are the
                                accounts and journal the manual "Change Period" action on journal items uses to
                                spread an entry across periods.
                            </div>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nc_accounting_defaults" model="ir.actions.server">
        <field name="name">Accounting Defaults</field>
        <field name="model_id" ref="base.model_res_company"/>
        <field name="state">code</field>
        <field name="code">action = model.nc_action_accounting_defaults()</field>
    </record>

    <menuitem id="menu_nc_accounting_defaults" name="Accounting Defaults"
              parent="base.menu_administration" sequence="6"
              action="action_nc_accounting_defaults"
              groups="base.group_system"/>
</odoo>
