<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Request 09.2: Accounting Settings > Bank & Cash > Financial Colours (one setting for every financial table). -->
    <record id="res_config_settings_view_form_fin_palette" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.nc.fin.palette</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@id='bank_cash']" position="inside">
                <setting id="nc_fin_palette_setting" string="Financial Colours"
                         help="How money movements are coloured in bank transactions, statements, ledgers and payments. Directions are always labelled too; statuses keep their own colours.">
                    <field name="nc_fin_palette" widget="radio"/>
                    <div class="mt-2 small">
                        <span class="o_nc_fin_in fw-bold me-3">+ 1,000.00 incoming</span>
                        <span class="o_nc_fin_out fw-bold">- 250.00 outgoing</span>
                    </div>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
