<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nc_cheque_reason_wizard_form" model="ir.ui.view">
        <field name="name">ncollection.cheque.reason.wizard.form</field>
        <field name="model">ncollection.cheque.reason.wizard</field>
        <field name="arch" type="xml">
            <form>
                <group>
                    <field name="job_id"/>
                    <field name="kind" invisible="1"/>
                    <field name="reason" placeholder="e.g. paper jam, misaligned print, cheque spoiled"/>
                </group>
                <footer>
                    <button name="action_confirm" type="object" string="Confirm" class="btn-primary" data-hotkey="q"/>
                    <button string="Cancel" class="btn-link" special="cancel" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
