<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nc_cheque_job_list" model="ir.ui.view">
        <field name="name">ncollection.cheque.print.job.list</field>
        <field name="model">ncollection.cheque.print.job</field>
        <field name="arch" type="xml">
            <list js_class="nc_cheque_job_list" decoration-muted="state in ('void', 'cancelled')" decoration-success="state == 'printed'"
                  decoration-warning="state == 'reprinted'">
                <field name="name"/>
                <field name="payment_id"/>
                <field name="payee"/>
                <field name="amount"/>
                <field name="currency_id" column_invisible="True"/>
                <field name="date"/>
                <field name="template_id"/>
                <field name="print_count"/>
                <field name="last_printed_at"/>
                <field name="state" widget="badge"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="view_nc_cheque_job_form" model="ir.ui.view">
        <field name="name">ncollection.cheque.print.job.form</field>
        <field name="model">ncollection.cheque.print.job</field>
        <field name="arch" type="xml">
            <form create="0" delete="0">
                <header>
                    <button name="action_print" type="object" string="Print" class="btn-primary" invisible="state != 'draft'"/>
                    <button name="action_open_reprint" type="object" string="Reprint" invisible="state not in ('printed', 'reprinted')"/>
                    <button name="action_open_void" type="object" string="Void" invisible="state not in ('printed', 'reprinted')"/>
                    <button name="action_cancel" type="object" string="Cancel" invisible="state != 'draft'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,printed,reprinted"/>
                </header>
                <sheet>
                    <div class="alert alert-warning" role="alert" invisible="template_confirmed_now">
                        The dimensions of this cheque template are not confirmed yet. Print the calibration sheet, check it on paper, and confirm the template.
                    </div>
                    <div class="oe_title"><h1><field name="name"/></h1></div>
                    <group>
                        <group string="Printed on the cheque">
                            <field name="output_lang"/>
                            <field name="payee"/>
                            <field name="date"/>
                            <field name="amount"/>
                            <field name="currency_id"/>
                            <field name="amount_words_en"/>
                            <field name="amount_words_ar"/>
                            <field name="reference"/>
                            <field name="cheque_number"/>
                            <field name="bank_name"/>
                            <field name="account_last4"/>
                        </group>
                        <group string="Source">
                            <field name="payment_id"/>
                            <field name="template_id"/>
                            <field name="profile_id"/>
                            <field name="profile_offset_x_mm"/>
                            <field name="profile_offset_y_mm"/>
                            <field name="profile_scale_pct"/>
                            <field name="user_id"/>
                            <field name="printed_at"/>
                            <field name="last_printed_at"/>
                            <field name="print_count"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                            <field name="template_confirmed" invisible="1"/>
                            <field name="template_confirmed_now" invisible="1"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="History" name="history">
                            <field name="event_ids">
                                <list create="0" delete="0" edit="0">
                                    <field name="at"/>
                                    <field name="kind"/>
                                    <field name="user_id"/>
                                    <field name="reason"/>
                                    <field name="pdf_sha256" optional="hide"/>
                                    <field name="offset_x_mm" optional="hide"/>
                                    <field name="offset_y_mm" optional="hide"/>
                                    <field name="scale_pct" optional="hide"/>
                                    <field name="warnings" optional="hide"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_nc_cheque_job_search" model="ir.ui.view">
        <field name="name">ncollection.cheque.print.job.search</field>
        <field name="model">ncollection.cheque.print.job</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="payee"/>
                <field name="payment_id"/>
                <field name="cheque_number"/>
                <filter name="printed" string="Printed" domain="[('state', 'in', ('printed', 'reprinted'))]"/>
                <filter name="reprinted" string="Reprinted" domain="[('state', '=', 'reprinted')]"/>
                <filter name="void" string="Void" domain="[('state', '=', 'void')]"/>
                <group>
                    <filter name="by_state" string="Status" context="{'group_by': 'state'}"/>
                    <filter name="by_template" string="Template" context="{'group_by': 'template_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nc_cheque_job" model="ir.actions.act_window">
        <field name="name">Cheque Print Jobs</field>
        <field name="res_model">ncollection.cheque.print.job</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No cheque printed yet</p>
            <p>Open a payment you make and press Print Cheque. Every print, reprint and void is kept here.</p>
        </field>
    </record>

    <!-- New in Print Jobs: the same wizard as the payment's button, with the payment to be chosen. -->
    <record id="action_nc_cheque_print_new" model="ir.actions.act_window">
        <field name="name">Print cheque</field>
        <field name="res_model">ncollection.cheque.print.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>
</odoo>
