<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <!-- P1-T13: the session-expired dialog title ("Odoo Session Expired") is
         a static title.translate= prop baked into the OWL template itself
         (web/core/errors/error_dialogs.xml), not a JS class property, so it
         cannot be patched from white_label.js like the other error dialog
         titles. Extend the template (t-inherit-mode="extension", the same
         mechanism core/enterprise addons use to patch each other's OWL
         templates) to override just the title attribute. -->
    <t t-inherit="web.SessionExpiredDialog" t-inherit-mode="extension">
        <xpath expr="//Dialog" position="attributes">
            <attribute name="title.translate">Session Expired</attribute>
        </xpath>
    </t>

    <!-- The (?) documentation links of the settings pages and widgets point at the upstream vendor's website. The product
         does not ship a link to another company's documentation: those links are not rendered. A link to any other
         address is untouched. -->
    <t t-inherit="web.DocumentationLink" t-inherit-mode="extension">
        <xpath expr="//a" position="attributes">
            <attribute name="t-if">!url.startsWith('https://www.odoo.com/')</attribute>
        </xpath>
    </t>

</templates>
