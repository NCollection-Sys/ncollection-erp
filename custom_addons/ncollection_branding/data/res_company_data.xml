<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!--
        Company defaults on INSTALL only (noupdate: an upgrade must never write
        them back over the company's real details, which it did until 19.0.1.14.0;
        the platform now pushes the details entered in Tenants). No contact
        details are seeded: an invented address (noreply@ncollection.com) used to
        show as the company's own. The tenant may change them from Settings.

        The email_*_color fields are consumed by Odoo's mail notification
        layout for the action-button and accent colours (they default to
        Odoo purple #875A7B otherwise). (logo for the branded email header is embedded in the
        mail layout template as inline base64.)
    -->
    <record id="base.main_company" model="res.company">
        <field name="email_primary_color">#FFFFFF</field>
        <field name="email_secondary_color">#1F5F8F</field>
    </record>
</odoo>
