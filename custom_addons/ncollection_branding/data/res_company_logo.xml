<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The company's logo is the company's identity: the letterhead of its invoices. A database is born with a VENDOR
        mark in it (Odoo's default company logo; until 19.0.1.15.0 this file seeded the NCollection mark), which then
        printed on every invoice as if it were the company's. Remove exactly those marks, on install and on every
        upgrade; a logo the Owner uploaded is never touched (models/res_company.py). The sign-in page and the
        workspace show the SYSTEM's logo from System Branding, never this field.
    -->
    <function model="res.company" name="_nc_clear_vendor_logos"/>
</odoo>
