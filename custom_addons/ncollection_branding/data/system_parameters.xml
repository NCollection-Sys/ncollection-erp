<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!-- White-label system parameters. noupdate=1 keeps client edits sticky. -->

    <!-- No outgoing sender is seeded: it was noreply@ncollection.com (mail.default.from / from_filter), the address
         every email of every workspace was sent from. Odoo's own default sender applies; databases that still hold
         that exact value are cleaned by ncollection_core (workspace_config._nc_clear_placeholder_mail_sender). -->

    <!-- Web title appearing in some HTTP responses / shortcuts -->
    <record id="ir_config_web_title" model="ir.config_parameter">
        <field name="key">web.base.title</field>
        <field name="value">NCollection ERP</field>
    </record>

    <!-- Database list shown on /web/database/manager (when list_db=True) -->
    <record id="ir_config_database_manager_show_name" model="ir.config_parameter">
        <field name="key">database.show_name</field>
        <field name="value">NCollection ERP Platform</field>
    </record>

</odoo>
