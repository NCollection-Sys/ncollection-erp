<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- PRODUCT BRANDING: the identity of the application itself. Company branding (a tenant's logo, colours, stamp) is a
         different thing, on the company (Workspace Administration > Company / Appearance). -->
    <record id="view_product_branding_form" model="ir.ui.view">
        <field name="name">ncollection.product.branding.form</field>
        <field name="model">ncollection.product.branding</field>
        <field name="arch" type="xml">
            <form string="Product Branding" create="false" delete="false">
                <sheet>
                    <div class="oe_title"><h1>Product Branding</h1></div>
                    <div class="alert alert-info" role="status">
                        This is the identity of the <strong>application</strong>: its name, logo and icon. The logo and
                        stamp of a <strong>company</strong> (printed on its invoices) are configured on the company, not
                        here. Changes apply at the next page load.
                    </div>
                    <group>
                        <group string="Name">
                            <field name="name" placeholder="e.g. NCollection ERP"/>
                            <field name="short_name"/>
                        </group>
                        <group string="Browser">
                            <field name="favicon" widget="image" class="oe_avatar"
                                   options="{'size': [0, 64], 'accepted_file_extensions': 'image/png,image/x-icon,.ico'}"/>
                        </group>
                    </group>
                    <group>
                        <group string="Product logo">
                            <field name="logo" widget="image" options="{'size': [0, 90], 'accepted_file_extensions': 'image/png,image/jpeg,image/webp'}"/>
                            <div class="text-muted small" colspan="2">Used on the sign-in page and the administration screens
                                unless they have their own logo.</div>
                        </group>
                        <group string="Optional dedicated logos">
                            <field name="login_logo" widget="image" options="{'size': [0, 70], 'accepted_file_extensions': 'image/png,image/jpeg,image/webp'}"/>
                            <div class="text-muted small" colspan="2">Sign-in and password pages. Empty: the product logo.</div>
                            <field name="admin_logo" widget="image" options="{'size': [0, 70], 'accepted_file_extensions': 'image/png,image/jpeg,image/webp'}"/>
                            <div class="text-muted small" colspan="2">Administration and platform screens. Empty: the product logo.</div>
                        </group>
                    </group>
                    <p class="text-muted">Images are checked by their content: PNG, JPEG or WebP for logos (PNG or ICO for the
                        favicon), up to 2 MB. SVG is not accepted.</p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_branding" model="ir.actions.server">
        <field name="name">Product Branding</field>
        <field name="model_id" ref="model_ncollection_product_branding"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <menuitem id="menu_product_branding" name="Product Branding" parent="base.menu_administration"
              action="action_product_branding" sequence="95" groups="base.group_system"/>
</odoo>
