<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- SYSTEM BRANDING: the identity of the system (the application itself). It is NOT the tenant's workspace look
         (company colours and login background, Workspace Administration > Appearance) and NOT the company's identity
         (legal name, logo and stamp printed on its documents, Workspace Administration > Company). Three identities,
         three places, no shared field. The technical names (ncollection.product.branding, view / action ids) keep the
         names they were persisted under. -->
    <record id="view_product_branding_form" model="ir.ui.view">
        <field name="name">ncollection.product.branding.form</field>
        <field name="model">ncollection.product.branding</field>
        <field name="arch" type="xml">
            <form string="System Branding" create="false" delete="false">
                <sheet>
                    <div class="oe_title"><h1>System Branding</h1></div>
                    <div class="alert alert-info" role="status">
                        This is the identity of the <strong>system</strong>: its name, logo, icon, browser title,
                        copyright line and colours, as seen on the sign-in page, error pages, e-mails and the browser
                        tab. It is separate from <strong>tenant branding</strong> (the colours and login background of
                        a workspace) and from the <strong>company identity</strong> (the legal name, logo and stamp
                        printed on its invoices); neither can change this and this cannot change them. Changes apply at
                        the next page load.
                    </div>
                    <group>
                        <group string="Name">
                            <field name="name" placeholder="e.g. NCollection ERP"/>
                            <field name="short_name"/>
                            <field name="browser_title" placeholder="Empty: the system name"/>
                        </group>
                        <group string="Browser">
                            <field name="favicon" widget="image" class="oe_avatar"
                                   options="{'size': [0, 64], 'accepted_file_extensions': 'image/png,image/x-icon,.ico'}"/>
                        </group>
                    </group>
                    <group>
                        <group string="System colours">
                            <field name="primary_color" widget="color"/>
                            <field name="secondary_color" widget="color"/>
                            <div class="text-muted small" colspan="2">The system's own colours: the sign-in page, error
                                pages, e-mail frame and the browser's theme colour. A workspace that has not chosen
                                its own colours uses these too; a workspace's colours never repaint these pages.</div>
                        </group>
                        <group string="Ownership">
                            <field name="copyright_text" placeholder="e.g. © 2026 Acme Cloud Ltd. All rights reserved."/>
                            <div class="text-muted small" colspan="2">Shown under the sign-in page. Empty: © the
                                current year and the system name.</div>
                        </group>
                    </group>
                    <group>
                        <group string="System logo">
                            <field name="logo" widget="image" options="{'size': [0, 90], 'accepted_file_extensions': 'image/png,image/jpeg,image/webp'}"/>
                            <div class="text-muted small" colspan="2">Used on the sign-in page and the administration screens
                                unless they have their own logo.</div>
                        </group>
                        <group string="Optional dedicated logos">
                            <field name="login_logo" widget="image" options="{'size': [0, 70], 'accepted_file_extensions': 'image/png,image/jpeg,image/webp'}"/>
                            <div class="text-muted small" colspan="2">Sign-in and password pages. Empty: the system logo.</div>
                            <field name="admin_logo" widget="image" options="{'size': [0, 70], 'accepted_file_extensions': 'image/png,image/jpeg,image/webp'}"/>
                            <div class="text-muted small" colspan="2">Administration and platform screens. Empty: the system logo.</div>
                        </group>
                    </group>
                    <p class="text-muted">Images are checked by their content: PNG, JPEG or WebP for logos (PNG or ICO for the
                        favicon), up to 2 MB. SVG is not accepted.</p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_product_branding" model="ir.actions.server">
        <field name="name">System Branding</field>
        <field name="model_id" ref="model_ncollection_product_branding"/>
        <field name="state">code</field>
        <field name="code">action = model.action_open()</field>
    </record>

    <menuitem id="menu_product_branding" name="System Branding" parent="base.menu_administration"
              action="action_product_branding" sequence="95"
              groups="ncollection_branding.group_system_branding_manager"/>
</odoo>
