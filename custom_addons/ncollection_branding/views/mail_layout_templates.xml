<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Branded transactional email layout (P1-T18).

        We override the two highest shared QWeb layouts every transactional
        email renders through - mail.mail_notification_layout and
        mail.mail_notification_light - so password reset, user invitation,
        quotation/SO, invoice and PO all inherit the branding at once, and the
        override survives Odoo upgrades (the issue's own guidance).

        Per change: (1) a branded header with the NCollection logo embedded as
        an inline base64 data URI (maximum email-client compatibility - no
        external fetch, no dependency on res.company.logo which is a related
        Image field that does not persist reliably from install-time data);
        alt text keeps the brand visible when a client blocks images.
        (2) Remove the "Powered by Odoo" leak, replacing it with a neutral
        NCollection platform line.

        Inline CSS + table-safe markup only (clients strip <style> / external CSS).
    -->

    <!-- Shared logo snippet: the base64 lives here ONCE, both layouts t-call it. -->
    <template id="nc_email_logo_header">
        <div style="padding: 12px 0 10px 0; border-bottom: 3px solid #1F5F8F; margin-bottom: 8px;">
            <img src="data:image/png;base64,"
                 alt="NCollection ERP"
                 style="max-height: 44px; max-width: 220px; border: 0; outline: none; text-decoration: none;"/>
        </div>
    </template>

    <!-- ============ mail_notification_layout ============ -->
    <template id="mail_notification_layout_branded"
              inherit_id="mail.mail_notification_layout"
              name="NCollection Branded Notification Layout">
        <xpath expr="//t[@t-call='mail.notification_preview']" position="after">
            <t t-call="ncollection_branding.nc_email_logo_header"/>
        </xpath>
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <a target="_blank" href="https://ncollection.com"
               style="color: #1F5F8F; text-decoration: none;">NCollection ERP</a>
        </xpath>
    </template>

    <!-- ============ mail_notification_light ============ -->
    <template id="mail_notification_light_branded"
              inherit_id="mail.mail_notification_light"
              name="NCollection Branded Light Notification Layout">
        <!-- The core light layout only shows its logo cell when the company
             has a CUSTOM logo (t-if="not uses_default_logo"). Make it
             unconditional so the NCollection header always renders. -->
        <xpath expr="//td[@t-if='company and not company.uses_default_logo']" position="attributes">
            <attribute name="t-if">1</attribute>
        </xpath>
        <!-- Replace the light layout's own /logo.png URL header with our
             inline base64 logo (image-blocking-safe, no external fetch). -->
        <xpath expr="//img[contains(@t-att-src, '/logo.png')]" position="replace">
            <img src="data:image/png;base64,"
                 alt="NCollection ERP"
                 style="max-height: 44px; max-width: 220px; border: 0; outline: none; text-decoration: none;"/>
        </xpath>
        <xpath expr="//a[contains(@href, 'odoo.com')]" position="replace">
            <a target="_blank" href="https://ncollection.com"
               style="color: #1F5F8F; text-decoration: none;">NCollection ERP</a>
        </xpath>
    </template>

</odoo>
