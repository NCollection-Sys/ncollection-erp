<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Settings > General Settings "About" block (P1-T13).

        The res_config_edition widget hardcodes "Odoo <version> (Community
        Edition)" and "Copyright © 2004 Odoo S.A. — GNU LGPL Licensed".
        We REMOVE the widget (option A from recon: pure view inheritance,
        the safest mechanism) and replace it with an NCollection version
        line. The LGPL attribution obligations are recorded in docs/LEGAL.md
        instead of a settings widget — rebranding the UI is permitted, the
        license notice lives with the source distribution, not the UI.
    -->
    <record id="res_config_settings_view_form_branded" model="ir.ui.view">
        <field name="name">res.config.settings.form.ncollection.branding</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='res_config_edition']" position="replace">
                <div>
                    <h3>NCollection ERP</h3>
                    <small class="text-muted">
                        Built on open-source technology (GNU LGPL v3 — see docs/LEGAL.md in the source distribution).
                    </small>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
