<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Settings > General Settings "About" block (P1-T13).

        The res_config_edition widget hardcodes "Odoo <version> (Community
        Edition)" and "Copyright © 2004 Odoo S.A. — GNU LGPL Licensed".
        We REMOVE the widget (option A from recon: pure view inheritance,
        the safest mechanism) and replace it with an NCollection version
        line. The LGPL attribution obligations are recorded in docs/LEGAL.md
        instead of a settings widget — rebranding the UI is permitted, the
        license notice lives with the source distribution, not the UI.
    -->
    <record id="res_config_settings_view_form_branded" model="ir.ui.view">
        <field name="name">res.config.settings.form.ncollection.branding</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//widget[@name='res_config_edition']" position="replace">
                <div>
                    <h3><field name="nc_product_name" readonly="1" nolabel="1"/></h3>
                    <small class="text-muted">
                        Built on open-source technology (GNU LGPL v3 — see docs/LEGAL.md in the source distribution).
                    </small>
                </div>
            </xpath>
        </field>
    </record>

    <!-- Two labels of the stock Settings page name the upstream vendor (API Keys help, IAP block). -->
    <record id="res_config_settings_view_form_no_vendor_names" model="ir.ui.view">
        <field name="name">res.config.settings.form.ncollection.no.vendor.names</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//button[@name='%(base.action_apikeys_admin)d']/parent::setting" position="attributes">
                <attribute name="help">API Keys allow your users to access the workspace with external tools when multi-factor authentication is enabled.</attribute>
            </xpath>
        </field>
    </record>
    <record id="res_config_settings_view_form_no_vendor_names_iap" model="ir.ui.view">
        <field name="name">res.config.settings.form.ncollection.no.vendor.names.iap</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="iap.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='iap_credits_setting']" position="attributes">
                <attribute name="string">In-App Services</attribute>
            </xpath>
        </field>
    </record>

    <!-- General Settings > Languages: say WHICH languages are installed. -->
    <record id="res_config_settings_view_form_languages" model="ir.ui.view">
        <field name="name">res.config.settings.form.ncollection.languages</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='languages_setting']//button[@name='%(base.action_view_base_language_install)d']" position="before">
                <div class="mt-2 mb-2">
                    <field name="nc_active_language_ids" widget="many2many_tags"
                           readonly="1" options="{'no_open': True}"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
