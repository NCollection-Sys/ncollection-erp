<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- DOCUMENT STAMPS: reusable stamp templates, scoped to document types and placed on the paper in millimetres.
         The menu lives with the other workspace administration entries (ncollection_core); the model, the rules and the
         designer are this module's. -->
    <record id="view_document_stamp_list" model="ir.ui.view">
        <field name="name">ncollection.document.stamp.list</field>
        <field name="model">ncollection.document.stamp</field>
        <field name="arch" type="xml">
            <list string="Document Stamps" decoration-muted="not active">
                <field name="name"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="document_type_ids" widget="many2many_tags"/>
                <field name="page_scope"/>
                <field name="priority" optional="show"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_document_stamp_form" model="ir.ui.view">
        <field name="name">ncollection.document.stamp.form</field>
        <field name="model">ncollection.document.stamp</field>
        <field name="arch" type="xml">
            <form string="Document Stamp">
                <sheet>
                    <widget name="web_ribbon" title="Archived" bg_color="text-bg-danger" invisible="active"/>
                    <field name="active" invisible="1"/>
                    <field name="aspect_ratio" invisible="1"/>
                    <field name="sheet_width_mm" invisible="1"/>
                    <field name="sheet_height_mm" invisible="1"/>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Official invoice stamp"/></h1>
                    </div>
                    <group>
                        <group string="Stamp">
                            <field name="image" widget="image" options="{'size': [0, 120], 'accepted_file_extensions': 'image/png'}"/>
                            <field name="company_id" groups="base.group_multi_company" options="{'no_create': True}"/>
                            <field name="document_type_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="paper_format_ids" widget="many2many_tags" options="{'no_create': True}"/>
                            <field name="priority"/>
                        </group>
                        <group string="Position and size">
                            <field name="page_scope"/>
                            <field name="x_mm"/>
                            <field name="y_mm"/>
                            <field name="width_mm"/>
                            <field name="height_mm"/>
                            <field name="keep_ratio"/>
                        </group>
                    </group>
                    <group string="Design">
                        <widget name="nc_stamp_designer"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_document_stamp_search" model="ir.ui.view">
        <field name="name">ncollection.document.stamp.search</field>
        <field name="model">ncollection.document.stamp</field>
        <field name="arch" type="xml">
            <search>
                <field name="name"/>
                <field name="document_type_ids"/>
                <filter name="archived" string="Archived" domain="[('active', '=', False)]"/>
            </search>
        </field>
    </record>

    <record id="action_document_stamp" model="ir.actions.act_window">
        <field name="name">Document Stamps</field>
        <field name="res_model">ncollection.document.stamp</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Create your first document stamp</p>
            <p>Upload a PNG stamp, choose the documents it is printed on (invoices, receipts, orders...) and place it
               on the paper. The same stamp then appears on View and on Print.</p>
        </field>
    </record>
</odoo>
