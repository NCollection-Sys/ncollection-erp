<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Groups. They stand beside Odoo's accounting groups (like cheque printing does) and are NOT added to the
         NCollection role matrix: e-invoicing is an optional, gated capability, so no standard role implies it. -->
    <record id="group_einvoice_user" model="res.groups">
        <field name="name">UAE e-invoicing: user</field>
        <field name="comment">Prepares, checks and validates UAE e-invoices of the companies the user may access. Reads accounting documents (read only). Writes only the per-document PINT data; state, identity and the archive are the engine's.</field>
        <field name="implied_ids" eval="[(4, ref('account.group_account_readonly'))]"/>
    </record>
    <record id="group_einvoice_manager" model="res.groups">
        <field name="name">UAE e-invoicing: manager</field>
        <field name="comment">Everything a user does, plus configuration: provider, credentials (write-only), tax and payment maps, retention rules and legal holds.</field>
        <field name="implied_ids" eval="[(4, ref('group_einvoice_user'))]"/>
    </record>
    <record id="group_einvoice_service" model="res.groups">
        <field name="name">UAE e-invoicing: service</field>
        <field name="comment">Non-interactive account that runs submission and status jobs and is the only one allowed to decrypt a provider credential. Not for human users.</field>
    </record>

    <!-- Multi-company: every model of the engine is scoped to the user's companies. A child inherits through its parent. -->
    <record id="rule_einvoice_config_company" model="ir.rule">
        <field name="name">E-invoice config: own company</field>
        <field name="model_id" ref="model_ncollection_einvoice_config"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_einvoice_provider_company" model="ir.rule">
        <field name="name">E-invoice provider: own company</field>
        <field name="model_id" ref="model_ncollection_einvoice_provider"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_einvoice_secret_company" model="ir.rule">
        <field name="name">E-invoice secret: own company</field>
        <field name="model_id" ref="model_ncollection_einvoice_secret"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_einvoice_holiday_company" model="ir.rule">
        <field name="name">E-invoice holiday: own company or workspace-wide</field>
        <field name="model_id" ref="model_ncollection_einvoice_holiday"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_einvoice_tax_map_company" model="ir.rule">
        <field name="name">E-invoice tax map: own company</field>
        <field name="model_id" ref="model_ncollection_einvoice_tax_map"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_einvoice_payment_map_company" model="ir.rule">
        <field name="name">E-invoice payment map: own company</field>
        <field name="model_id" ref="model_ncollection_einvoice_payment_map"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_einvoice_company" model="ir.rule">
        <field name="name">E-invoice: own company</field>
        <field name="model_id" ref="model_ncollection_einvoice"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_einvoice_line_company" model="ir.rule">
        <field name="name">E-invoice line: own company</field>
        <field name="model_id" ref="model_ncollection_einvoice_line"/>
        <field name="domain_force">[('einvoice_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_einvoice_history_company" model="ir.rule">
        <field name="name">E-invoice history: own company</field>
        <field name="model_id" ref="model_ncollection_einvoice_history"/>
        <field name="domain_force">[('einvoice_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_einvoice_validation_company" model="ir.rule">
        <field name="name">E-invoice validation line: own company</field>
        <field name="model_id" ref="model_ncollection_einvoice_validation"/>
        <field name="domain_force">[('einvoice_id.company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_einvoice_hold_company" model="ir.rule">
        <field name="name">E-invoice legal hold: own company</field>
        <field name="model_id" ref="model_ncollection_einvoice_hold"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="rule_einvoice_retention_read" model="ir.rule">
        <field name="name">E-invoice retention rule: read own or shared</field>
        <field name="model_id" ref="model_ncollection_einvoice_retention_rule"/>
        <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="True"/>
        <field name="perm_write" eval="False"/>
        <field name="perm_create" eval="False"/>
        <field name="perm_unlink" eval="False"/>
    </record>
    <record id="rule_einvoice_retention_write" model="ir.rule">
        <field name="name">E-invoice retention rule: change only own company's</field>
        <field name="model_id" ref="model_ncollection_einvoice_retention_rule"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
        <field name="perm_read" eval="False"/>
        <field name="perm_write" eval="True"/>
        <field name="perm_create" eval="True"/>
        <field name="perm_unlink" eval="True"/>
    </record>
</odoo>
