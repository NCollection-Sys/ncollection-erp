#. module: ncollection_uae_einvoicing
#. odoo-python
#: code:addons/ncollection_uae_einvoicing/models/retention.py:0
msgid "A closed legal hold is final."
msgstr "الحجز القانوني المغلق نهائي."

#. module: ncollection_uae_einvoicing
#: model:ir.model.constraint,message:ncollection_uae_einvoicing.constraint_ncollection_einvoice_provider_company_unique
msgid ""
"A company has one ASP: it sends and receives through the same provider."
msgstr "للشركة مزوّد خدمة معتمد واحد: ترسل وتستقبل عبر المزوّد نفسه."

#. module: ncollection_uae_einvoicing
#. odoo-python
#: code:addons/ncollection_uae_einvoicing/models/secret.py:0
msgid "A credential cannot be empty."
msgstr "لا يمكن أن تكون بيانات الاعتماد فارغة."

#. module: ncollection_uae_einvoicing
#. odoo-python
#: code:addons/ncollection_uae_einvoicing/models/secret.py:0
msgid "A credential's identity cannot be changed; set it again instead."
msgstr "لا يمكن تغيير هوية بيانات الاعتماد؛ أعد ضبطها بدلاً من ذلك."

#. module: ncollection_uae_einvoicing
#: model:ir.model.fields,help:ncollection_uae_einvoicing.field_ncollection_einvoice_secret__secret_name
msgid "A label chosen by the provider adapter, e.g. 'api_token'."
msgstr "تسمية يحددها مهيّئ المزوّد، مثل 'api_token'."

#. module: ncollection_uae_einvoicing
#. odoo-python
#: code:addons/ncollection_uae_einvoicing/models/retention.py:0
msgid ""
"A legal hold can only be closed (or its reason edited), never rescoped."
msgstr "يمكن إغلاق الحجز القانوني (أو تعديل سببه) فقط، ولا يمكن تغيير نطاقه."

#. module: ncollection_uae_einvoicing
#. odoo-python
#: code:addons/ncollection_uae_einvoicing/models/retention.py:0
msgid "A legal hold cannot be closed before it was opened."
msgstr "لا يمكن إغلاق الحجز القانوني قبل فتحه."

#. module: ncollection_uae_einvoicing
#. odoo-python
#: code:addons/ncollection_uae_einvoicing/models/retention.py:0
msgid ""
"A legal hold is opened open and the system records who opened it; close it "
"afterwards."
msgstr "يُفتح الحجز القانوني مفتوحاً ويسجّل النظام من فتحه؛ أغلقه لاحقاً."

#. module: ncollection_uae_einvoicing
#. odoo-python
#: code:addons/ncollection_uae_einvoicing/models/retention.py:0
msgid "A legal hold is part of the record: close it, do not delete it."
msgstr "الحجز القانوني جزء من السجل: أغلقه ولا تحذفه."

#. module: ncollection_uae_einvoicing
#: model:ir.model.constraint,message:ncollection_uae_einvoicing.constraint_ncollection_einvoice_line_line_unique
msgid "A line appears once per e-invoice."
msgstr "يظهر البند مرة واحدة فقط في كل فاتورة إلكترونية."

#. module: ncollection_uae_einvoicing
#. odoo-python
#: code:addons/ncollection_uae_einvoicing/models/config.py:0
msgid ""
"A reverse-charge tax needs its goods type and the rate shown on the line."
msgstr "ضريبة الاحتساب العكسي تتطلب نوع السلع والنسبة الظاهرة على البند."

#. module: ncollection_uae_einvoicing
#: model:ir.model.fields,help:ncollection_uae_einvoicing.field_ncollection_einvoice_retention_rule__confirmed
msgid ""
"A rule only counts once someone has checked it against the primary text. "
