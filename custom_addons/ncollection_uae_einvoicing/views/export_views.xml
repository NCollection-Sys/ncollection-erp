<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Evidence exports (R46). Manager-only menu; the model is append-only at the ORM and manager-only in the ACL. -->
    <record id="view_einvoice_export_list" model="ir.ui.view">
        <field name="name">ncollection.einvoice.export.list</field>
        <field name="model">ncollection.einvoice.export</field>
        <field name="arch" type="xml">
            <list create="0" delete="0">
                <field name="requested_at"/>
                <field name="requested_by"/>
                <field name="company_id" groups="base.group_multi_company"/>
                <field name="einvoice_count"/>
                <field name="inbound_count"/>
                <field name="file_count"/>
                <field name="package_sha256"/>
            </list>
        </field>
    </record>

    <record id="view_einvoice_export_form" model="ir.ui.view">
        <field name="name">ncollection.einvoice.export.form</field>
        <field name="model">ncollection.einvoice.export</field>
        <field name="arch" type="xml">
            <form create="0" delete="0" edit="0">
                <sheet>
                    <group>
                        <group>
                            <field name="requested_at"/>
                            <field name="requested_by"/>
                            <field name="company_id"/>
                            <field name="attachment_id"/>
                        </group>
                        <group>
                            <field name="einvoice_count"/>
                            <field name="inbound_count"/>
                            <field name="file_count"/>
                            <field name="package_sha256"/>
                            <field name="manifest_sha256"/>
                        </group>
                    </group>
                    <p class="text-muted">
                        The package is deterministic and self-verifying: MANIFEST.sha256 lists the sha256 of every
                        file, and package.json carries the sha256 of the manifest.
                    </p>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_einvoice_export_create" model="ir.actions.server">
        <field name="name">Create evidence package</field>
        <field name="model_id" ref="model_ncollection_einvoice_export"/>
        <field name="group_ids" eval="[(4, ref('ncollection_uae_einvoicing.group_einvoice_manager'))]"/>
        <field name="state">code</field>
        <field name="code">action = model.action_create_package()</field>
    </record>

    <record id="action_einvoice_export" model="ir.actions.act_window">
        <field name="name">Evidence exports</field>
        <field name="res_model">ncollection.einvoice.export</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_einvoice_export" name="Evidence Exports" parent="menu_einvoice_configuration" sequence="60"
              action="action_einvoice_export" groups="ncollection_uae_einvoicing.group_einvoice_manager"/>
    <menuitem id="menu_einvoice_export_create" name="Create Evidence Package" parent="menu_einvoice_configuration"
              sequence="61" action="action_einvoice_export_create"
              groups="ncollection_uae_einvoicing.group_einvoice_manager"/>
</odoo>
