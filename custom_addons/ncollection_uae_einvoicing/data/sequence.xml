<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The NCollection e-invoice RECORD id. It is its own series: it is not the Odoo invoice number, the PINT invoice number,
         the UUID or any network reference, and it is never used in their place. -->
    <record id="seq_einvoice" model="ir.sequence">
        <field name="name">UAE e-invoice record</field>
        <field name="code">ncollection.einvoice</field>
        <field name="prefix">EINV/%(year)s/</field>
        <field name="padding">5</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
