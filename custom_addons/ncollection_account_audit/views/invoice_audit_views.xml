<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nc_invoice_audit_list" model="ir.ui.view">
        <field name="name">ncollection.invoice.audit.list</field>
        <field name="model">ncollection.invoice.audit</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" default_order="logged_at desc, id desc">
                <field name="logged_at"/>
                <field name="move_name"/>
                <field name="event"/>
                <field name="state"/>
                <field name="old_amount_total" sum="Old"/>
                <field name="new_amount_total" sum="New"/>
                <field name="currency_id" optional="hide"/>
                <field name="user_login"/>
                <field name="ip_address" optional="show"/>
                <field name="company_id" groups="base.group_multi_company"/>
            </list>
        </field>
    </record>

    <record id="view_nc_invoice_audit_form" model="ir.ui.view">
        <field name="name">ncollection.invoice.audit.form</field>
        <field name="model">ncollection.invoice.audit</field>
        <field name="arch" type="xml">
            <form create="0" edit="0" delete="0">
                <sheet>
                    <group>
                        <group>
                            <field name="move_name"/>
                            <field name="move_id"/>
                            <field name="res_id"/>
                            <field name="partner_name"/>
                            <field name="state"/>
                            <field name="company_id" groups="base.group_multi_company"/>
                        </group>
                        <group>
                            <field name="event"/>
                            <field name="logged_at"/>
                            <field name="user_login"/>
                            <field name="ip_address"/>
                            <field name="trigger"/>
                        </group>
                    </group>
                    <group string="Before">
                        <field name="currency_id" invisible="1"/>
                        <field name="old_amount_untaxed"/>
                        <field name="old_amount_tax"/>
                        <field name="old_amount_total"/>
                        <field name="old_lines_total"/>
                    </group>
                    <group string="After">
                        <field name="new_amount_untaxed"/>
                        <field name="new_amount_tax"/>
                        <field name="new_amount_total"/>
                        <field name="new_lines_total"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_nc_invoice_audit_search" model="ir.ui.view">
        <field name="name">ncollection.invoice.audit.search</field>
        <field name="model">ncollection.invoice.audit</field>
        <field name="arch" type="xml">
            <search>
                <field name="move_name"/>
                <field name="partner_name"/>
                <field name="user_login"/>
                <filter name="changed" string="Amount changed" domain="[('event', '=', 'amount_changed')]"/>
                <filter name="created" string="Created" domain="[('event', '=', 'created')]"/>
                <filter name="deleted" string="Deleted" domain="[('event', '=', 'deleted')]"/>
                <group>
                    <filter name="by_invoice" string="Invoice" context="{'group_by': 'move_name'}"/>
                    <filter name="by_user" string="User" context="{'group_by': 'user_login'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_nc_invoice_audit" model="ir.actions.act_window">
        <field name="name">Invoice Amount Audit</field>
        <field name="res_model">ncollection.invoice.audit</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_nc_invoice_audit" name="Invoice Amount Audit" parent="account.menu_finance"
              action="action_nc_invoice_audit" sequence="95"
              groups="account.group_account_manager,ncollection_core.group_role_owner,ncollection_core.group_role_ceo"/>
</odoo>
