<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- A user sees the entries of the companies they are allowed into, and nothing else (multi-company isolation). -->
    <record id="rule_nc_invoice_audit_company" model="ir.rule">
        <field name="name">Invoice amount audit: own companies</field>
        <field name="model_id" ref="model_ncollection_invoice_audit"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
</odoo>
