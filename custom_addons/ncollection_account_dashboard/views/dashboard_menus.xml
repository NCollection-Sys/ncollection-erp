<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Financial dashboards are for the roles that actually carry accounting
         ORM rights: Accountant / CEO / Owner (see ncollection_core hooks.py
         ROLE_IMPLICATIONS — Manager implies only sales/stock/hr, NOT account, so
         it is deliberately excluded). The gate is genuinely mirrored at the data
         layer: the executive services run under the user's own accounting rights
         with no sudo, so anyone reaching a figure must already be permitted to
         read it (Rule 4/7); no other role can open the RPC. -->
    <menuitem id="menu_account_dashboard_root"
              name="Financial Dashboards"
              groups="ncollection_core.group_role_accountant,ncollection_core.group_role_ceo,ncollection_core.group_role_owner"
              sequence="12"/>

    <menuitem id="menu_finance_dashboard"
              name="Finance"
              parent="menu_account_dashboard_root"
              action="action_finance_dashboard"
              sequence="10"/>

    <menuitem id="menu_accountant_dashboard"
              name="Accountant"
              parent="menu_account_dashboard_root"
              action="action_accountant_dashboard"
              sequence="20"/>

    <menuitem id="menu_cash_dashboard"
              name="Cash"
              parent="menu_account_dashboard_root"
              action="action_cash_dashboard"
              sequence="30"/>

    <!-- CEO (#56). Narrower than its siblings: the executive cross-domain view
         is for CEO/Owner, not every accountant. The parent menu's own groups
         still apply, so this INTERSECTS them rather than widening anything —
         an accountant cannot see this item. Mirrored at the data layer by the
         same mechanism as the rest: get_ceo_dashboard runs the executive
         services under the caller's own accounting rights with no sudo, and
         the cross-domain panels go through the P4-T01 engine, which enforces
         Ring 2 licensing per model (Rule 4/7). -->
    <menuitem id="menu_ceo_dashboard"
              name="CEO"
              parent="menu_account_dashboard_root"
              groups="ncollection_core.group_role_ceo,ncollection_core.group_role_owner"
              action="action_ceo_dashboard"
              sequence="5"/>

</odoo>
