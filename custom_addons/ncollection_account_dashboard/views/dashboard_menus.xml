<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- Financial dashboards are for the roles that actually carry accounting
         ORM rights: Accountant / CEO / Owner (see ncollection_core hooks.py
         ROLE_IMPLICATIONS — Manager implies only sales/stock/hr, NOT account, so
         it is deliberately excluded). The gate is genuinely mirrored at the data
         layer: the executive services run under the user's own accounting rights
         with no sudo, so anyone reaching a figure must already be permitted to
         read it (Rule 4/7); no other role can open the RPC. -->
    <menuitem id="menu_account_dashboard_root"
              name="Financial Dashboards"
              groups="ncollection_core.group_role_accountant,ncollection_core.group_role_ceo,ncollection_core.group_role_owner"
              sequence="12"/>

    <menuitem id="menu_finance_dashboard"
              name="Finance"
              parent="menu_account_dashboard_root"
              action="action_finance_dashboard"
              sequence="10"/>

    <menuitem id="menu_accountant_dashboard"
              name="Accountant"
              parent="menu_account_dashboard_root"
              action="action_accountant_dashboard"
              sequence="20"/>

    <menuitem id="menu_cash_dashboard"
              name="Cash"
              parent="menu_account_dashboard_root"
              action="action_cash_dashboard"
              sequence="30"/>

    <!-- CEO (#56). Narrower than its siblings: the executive cross-domain view
         is for CEO/Owner, not every accountant. The parent menu's own groups
         still apply, so this INTERSECTS them rather than widening anything —
         an accountant cannot see this item.

         What IS mirrored at the data layer: every figure is read under the
         caller's own rights with no sudo, so the executive services are gated
         by account ACLs and the cross-domain panels by the P4-T01 engine's
         Ring 2 licensing, per model.

         What is NOT mirrored, stated plainly rather than implied: this menu's
         CEO/Owner narrowing is Ring 1 only. `get_ceo_dashboard` carries no
         role check of its own, so an accountant who calls it directly gets a
         payload. That exposes NO data they cannot already see — the same KPIs
         are on their own Finance/Accountant dashboards, and the panels stay
         Ring-2 gated regardless — so it is role curation, not a leak. Whether
         to add the RPC-level check is #333. -->
    <menuitem id="menu_ceo_dashboard"
              name="CEO"
              parent="menu_account_dashboard_root"
              groups="ncollection_core.group_role_ceo,ncollection_core.group_role_owner"
              action="action_ceo_dashboard"
              sequence="5"/>

    <!-- Department dashboards (#57 / P4-T04) — NON-financial, so a SEPARATE root
         from the financial one and gated to the operational roles. The root is
         visible to any of the three department roles; each child is gated to its
         OWN role so a dashboard is "visible only to its role group" (acceptance).
         Mirrored at the data layer like the CEO dashboard: the ncollection.kpi /
         P4-T01 engine reads run under the user's own rights with no sudo, so a
         cross-role RPC call returns None (empty), never another role's data.
         (The RPC-level role check, as for the CEO dashboard, is deferred to
         #333 — menu gating is Ring 1 curation.) -->
    <menuitem id="menu_department_dashboard_root"
              name="Department Dashboards"
              groups="ncollection_core.group_role_sales,ncollection_core.group_role_hr,ncollection_core.group_role_warehouse"
              sequence="13"/>

    <menuitem id="menu_sales_dashboard"
              name="Sales"
              parent="menu_department_dashboard_root"
              groups="ncollection_core.group_role_sales"
              action="action_sales_dashboard"
              sequence="10"/>

    <menuitem id="menu_hr_dashboard"
              name="HR"
              parent="menu_department_dashboard_root"
              groups="ncollection_core.group_role_hr"
              action="action_hr_dashboard"
              sequence="20"/>

    <menuitem id="menu_warehouse_dashboard"
              name="Warehouse"
              parent="menu_department_dashboard_root"
              groups="ncollection_core.group_role_warehouse"
              action="action_warehouse_dashboard"
              sequence="30"/>

</odoo>
