<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Lock the platform-dangerous top menus to the tenant Owner (P1-T11).

        Core defaults:
          base.menu_management    (Apps)     -> base.group_system
          base.menu_administration (Settings) -> group_system + group_erp_manager

        We tighten both to ncollection_core.group_role_owner ONLY. Owner
        implies base.group_system (P1-T08 ROLE_MATRIX D1), so the Owner keeps
        full backend rights; every other tenant role — including a bare
        group_system holder that is not the Owner — loses the Apps and
        Settings menus. This is Ring-1 UX; the ORM mirror is core's own
        group_system ACL on res.config.settings + ir.module.module, and the
        debug vector is closed in models/ir_http.py.
    -->

    <record model="ir.ui.menu" id="base.menu_management">
        <field name="group_ids" eval="[Command.set([ref('ncollection_core.group_role_owner')])]"/>
    </record>

    <record model="ir.ui.menu" id="base.menu_administration">
        <field name="group_ids" eval="[Command.set([ref('ncollection_core.group_role_owner')])]"/>
    </record>

</odoo>
