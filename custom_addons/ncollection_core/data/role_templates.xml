<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Standard workspace roles. Each names REAL Odoo groups by external id (models/role.py): the ids are resolved when
        needed, so a role whose application is not installed in a workspace says so ("Needs: stock") and a workspace
        picks the role up on its own when the application arrives. Nothing here grants anything by itself; what a user
        may do is decided by the groups, which is why no role below carries a list of rights of its own.

        Loaded without noupdate on purpose: the group mapping is part of the product and an upgrade must be able to
        correct it. A workspace may rename or archive a standard role (not change its groups; models/role.py).
    -->

    <record id="nc_role_administrator" model="ncollection.role">
        <field name="code">administrator</field>
        <field name="name">Administrator</field>
        <field name="kind">standard</field>
        <field name="sequence">1</field>
        <field name="group_xmlids">ncollection_core.group_role_owner</field>
        <field name="description">Full control of the workspace: users, roles, settings, billing and every application. Give it to as few people as possible.</field>
    </record>

    <record id="nc_role_finance_manager" model="ncollection.role">
        <field name="code">finance_manager</field>
        <field name="name">Finance Manager</field>
        <field name="kind">standard</field>
        <field name="sequence">10</field>
        <field name="group_xmlids">ncollection_core.group_role_accountant,account.group_account_manager</field>
        <field name="description">Runs accounting: invoices, bills, payments, journals, reconciliation, reports and accounting settings.</field>
    </record>

    <record id="nc_role_accountant" model="ncollection.role">
        <field name="code">accountant</field>
        <field name="name">Accountant</field>
        <field name="kind">standard</field>
        <field name="sequence">11</field>
        <field name="group_xmlids">ncollection_core.group_role_accountant</field>
        <field name="description">Day-to-day accounting: invoices, bills, payments and reports. No accounting configuration.</field>
    </record>

    <record id="nc_role_sales_manager" model="ncollection.role">
        <field name="code">sales_manager</field>
        <field name="name">Sales Manager</field>
        <field name="kind">standard</field>
        <field name="sequence">20</field>
        <field name="group_xmlids">ncollection_core.group_role_sales,sales_team.group_sale_manager</field>
        <field name="description">Sees every quotation and order, manages teams and sales configuration.</field>
    </record>

    <record id="nc_role_sales_user" model="ncollection.role">
        <field name="code">sales_user</field>
        <field name="name">Sales User</field>
        <field name="kind">standard</field>
        <field name="sequence">21</field>
        <field name="group_xmlids">ncollection_core.group_role_sales,sales_team.group_sale_salesman</field>
        <field name="description">Own quotations, orders and customers.</field>
    </record>

    <record id="nc_role_purchase_manager" model="ncollection.role">
        <field name="code">purchase_manager</field>
        <field name="name">Purchase Manager</field>
        <field name="kind">standard</field>
        <field name="sequence">30</field>
        <field name="group_xmlids">purchase.group_purchase_manager</field>
        <field name="description">Approves and manages every purchase order and vendor, and the purchase configuration.</field>
    </record>

    <record id="nc_role_purchase_user" model="ncollection.role">
        <field name="code">purchase_user</field>
        <field name="name">Purchase User</field>
        <field name="kind">standard</field>
        <field name="sequence">31</field>
        <field name="group_xmlids">purchase.group_purchase_user</field>
        <field name="description">Creates requests for quotation and purchase orders.</field>
    </record>

    <record id="nc_role_inventory_manager" model="ncollection.role">
        <field name="code">inventory_manager</field>
        <field name="name">Inventory Manager</field>
        <field name="kind">standard</field>
        <field name="sequence">40</field>
        <field name="group_xmlids">ncollection_core.group_role_warehouse,stock.group_stock_manager</field>
        <field name="description">Manages warehouses, operations, adjustments and the inventory configuration.</field>
    </record>

    <record id="nc_role_inventory_user" model="ncollection.role">
        <field name="code">inventory_user</field>
        <field name="name">Inventory User</field>
        <field name="kind">standard</field>
        <field name="sequence">41</field>
        <field name="group_xmlids">ncollection_core.group_role_warehouse,stock.group_stock_user</field>
        <field name="description">Receipts, deliveries, transfers and barcode operations.</field>
    </record>

    <record id="nc_role_hr_manager" model="ncollection.role">
        <field name="code">hr_manager</field>
        <field name="name">HR Manager</field>
        <field name="kind">standard</field>
        <field name="sequence">50</field>
        <field name="group_xmlids">ncollection_core.group_role_hr,hr.group_hr_manager</field>
        <field name="description">Employee records, departments and HR configuration.</field>
    </record>

    <record id="nc_role_hr_user" model="ncollection.role">
        <field name="code">hr_user</field>
        <field name="name">HR User</field>
        <field name="kind">standard</field>
        <field name="sequence">51</field>
        <field name="group_xmlids">ncollection_core.group_role_hr,hr.group_hr_user</field>
        <field name="description">Employee records and day-to-day HR work.</field>
    </record>

    <record id="nc_role_crm_manager" model="ncollection.role">
        <field name="code">crm_manager</field>
        <field name="name">CRM Manager</field>
        <field name="kind">standard</field>
        <field name="sequence">60</field>
        <field name="group_xmlids">ncollection_core.group_role_sales,sales_team.group_sale_manager,sales_team.group_sale_salesman_all_leads</field>
        <field name="description">Every lead and opportunity, sales teams and the pipeline configuration.</field>
    </record>

    <record id="nc_role_crm_user" model="ncollection.role">
        <field name="code">crm_user</field>
        <field name="name">CRM User</field>
        <field name="kind">standard</field>
        <field name="sequence">61</field>
        <field name="group_xmlids">ncollection_core.group_role_sales,sales_team.group_sale_salesman_all_leads</field>
        <field name="description">Works leads and opportunities.</field>
    </record>

    <record id="nc_role_reports_viewer" model="ncollection.role">
        <field name="code">reports_viewer</field>
        <field name="name">Reports Viewer</field>
        <field name="kind">standard</field>
        <field name="sequence">90</field>
        <field name="group_xmlids">ncollection_core.group_role_employee,account.group_account_readonly</field>
        <field name="description">Reads financial reports and documents; changes nothing.</field>
    </record>
</odoo>
