<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        P5-T04 anomaly alerts. Odoo 19: <list>, never <tree>; no attrs= (Rule 6).

        That sentence is the point of #348. Writing it used to FAIL the guard
        that enforces it — the guard matched the rule's own vocabulary as raw
        text, so #61 shipped a vaguer comment as a workaround. It is restored
        here as the ticket's live acceptance evidence; if the exclusion ever
        regresses, this file stops passing.

        #61 shipped these views with NO menu, because the surface belonged to
        DEV-3's #57/PR #341 and adding a competing one would have collided with
        work in flight. #341 has since merged, so #346 adds the menu below and
        the record rules that make it safe to show anyone.
    -->
    <record id="view_ncollection_alert_list" model="ir.ui.view">
        <field name="name">ncollection.alert.list</field>
        <field name="model">ncollection.alert</field>
        <field name="arch" type="xml">
            <list string="Anomaly Alerts" decoration-danger="severity == 'critical'"
                  decoration-warning="severity == 'warning'"
                  decoration-muted="state == 'acknowledged'">
                <field name="detected_at"/>
                <field name="severity"/>
                <field name="name"/>
                <field name="detector_key"/>
                <field name="observed_value" digits="[16,2]"/>
                <field name="baseline_value" digits="[16,2]"/>
                <field name="zscore"/>
                <field name="state"/>
                <field name="severity_rank" column_invisible="True"/>
            </list>
        </field>
    </record>

    <record id="view_ncollection_alert_form" model="ir.ui.view">
        <field name="name">ncollection.alert.form</field>
        <field name="model">ncollection.alert</field>
        <field name="arch" type="xml">
            <form string="Anomaly Alert">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="severity"/>
                        <field name="detector_key"/>
                        <field name="detected_at"/>
                        <field name="state"/>
                    </group>
                    <group string="Measurement">
                        <field name="observed_value"/>
                        <field name="baseline_value"/>
                        <field name="zscore"
                               help="Standard deviations from the baseline."/>
                    </group>
                    <group string="Suggested action">
                        <field name="suggested_action" nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_ncollection_alert" model="ir.actions.act_window">
        <field name="name">Anomaly Alerts</field>
        <field name="res_model">ncollection.alert</field>
        <field name="view_mode">list,form</field>
        <!--
            create/edit/delete off. Role holders have read-only ACLs, so a
            visible Save would fail server-side with an AccessError — the
            control is real either way, but offering an action that cannot
            succeed is how a user learns to distrust the screen. Alerts are
            written by the detector; a human forging or deleting one could
            hide a real anomaly.
        -->
        <field name="context">{'search_default_open': 1, 'create': False, 'edit': False, 'delete': False}</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">No alerts — nothing unusual detected.</p>
            <p>Anomalies are detected once a day. You see the alerts for your
               role only; an administrator sees all of them.</p>
        </field>
    </record>

    <record id="view_ncollection_alert_search" model="ir.ui.view">
        <field name="name">ncollection.alert.search</field>
        <field name="model">ncollection.alert</field>
        <field name="arch" type="xml">
            <!--
                Flat, with <separator/> rather than a <group expand="0">.

                #61 recorded the reason as "Odoo 19 dropped `expand`". That is
                WRONG, and #353 corrected it against the schema itself:
                base/rng/common.rng allows a <group> only colspan, rowspan,
                fill, height, width, name, color, invisible, position, groups
                and col. Neither `expand` NOR `string` is among them, so
                <group string="Group By"> — the far commoner spelling — is
                equally fatal. RelaxNG rejects the whole view either way and
                the module fails to INSTALL rather than degrading.

                `col` is the one that is easy to miss: it is not written next
                to `group` at all, but comes in through the `container` ref,
                and RelaxNG splices a referenced define's attributes into the
                containing element. Core Odoo relies on it — ir_model_views.xml
                has <group colspan="11" col="11" groups="..."> inside a
                <search> — so a guard that omitted it would flag Odoo's own
                markup. It did, on the first pass; odoo-reviewer caught it.

                Verified against the pinned odoo:19 image: <group/> and
                <group><filter/></group> validate; <group string=> and
                <group expand=> are both REJECTED. Forms are unaffected —
                the rng directory ships no form_view.rng at all, which is why
                <group string="Measurement"> above installs perfectly well.

                Matches the shape already used in
                ncollection_saas/views/backup_views.xml, and now guarded by
                architecture_guard so the next person gets a lint error
                instead of a failed install.
            -->
            <search>
                <field name="name"/>
                <field name="detector_key"/>
                <filter name="open" string="Open"
                        domain="[('state', '=', 'new')]"/>
                <filter name="critical" string="Critical"
                        domain="[('severity', '=', 'critical')]"/>
                <separator/>
                <filter name="by_severity" string="Group by Severity"
                        context="{'group_by': 'severity'}"/>
                <filter name="by_detector" string="Group by Detector"
                        context="{'group_by': 'detector_key'}"/>
            </search>
        </field>
    </record>

    <!--
        The menu is CONVENIENCE, not security (#346). Its `groups` mirror the
        union of the record rules in security/alert_security.xml, so the menu is
        hidden from users who would see nothing anyway — but the enforcement is
        the rule, because /web/dataset/call_kw never consults a menu
        (Standing Rule 4). test_anomaly_visibility asserts at the ORM for that
        reason.

        Top-level, with a high sequence so it sorts after the ERP apps. NOT
        parented under `menu_ncollection_dashboard_root`, which carries its own
        action (the P1-T17 landing page) — giving an action-menu children
        changes what clicking it does, and quietly altering the landing page is
        not this ticket's business.
    -->
    <menuitem id="menu_ncollection_alert"
              name="Anomaly Alerts"
              action="action_ncollection_alert"
              sequence="90"
              groups="ncollection_core.group_role_sales,ncollection_core.group_role_accountant,ncollection_core.group_role_hr,ncollection_core.group_role_warehouse,ncollection_core.group_role_manager,ncollection_core.group_role_ceo,ncollection_core.group_role_owner,base.group_system"/>
</odoo>
