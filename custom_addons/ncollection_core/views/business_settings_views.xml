<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Business Settings (Option A): the business settings a workspace Owner changes, now that Odoo's General
         Settings belongs to the platform. Sales, Purchase and Accounting add their own pages. -->
    <record id="view_nc_business_settings_form" model="ir.ui.view">
        <field name="name">ncollection.business.settings.form</field>
        <field name="model">ncollection.business.settings</field>
        <field name="arch" type="xml">
            <form string="Business Settings">
                <header>
                    <button name="action_nc_save" type="object" string="Save" class="btn-primary"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>Business Settings</h1>
                    </div>
                    <group>
                        <field name="company_id" options="{'no_open': True}"/>
                    </group>
                    <notebook name="nc_business_settings">
                        <page string="General" name="general">
                            <p class="text-muted">These settings apply to the company shown above.</p>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_nc_business_settings" model="ir.actions.act_window">
        <field name="name">Business Settings</field>
        <field name="res_model">ncollection.business.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
    </record>

    <menuitem id="menu_workspace_business_settings"
              name="Business Settings"
              parent="menu_workspace_settings_root"
              action="action_nc_business_settings"
              sequence="15"/>
</odoo>
