<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Branded "Subscription paused/expired" interstitial (P2-T03), served by
        the subscription gate (models/subscription_gate.py) in place of the
        backend web client for a suspended/expired tenant.

        Deliberately SELF-CONTAINED (no web.frontend_layout / asset bundles): the
        gate renders + flattens it in _pre_dispatch, before asset dispatch, so it
        must not depend on any bundle or filestore asset. Styling is inline; the
        brand primary uses the per-tenant nc-primary CSS custom property
        (ncollection_branding) with the NCollection default as fallback.
    -->
    <template id="subscription_blocked" name="NCollection Subscription Paused">
        <t t-set="brand" t-value="'#1F5F8F'"/>
        <html lang="en">
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <title>Workspace paused — NCollection</title>
                <link type="image/x-icon" rel="shortcut icon"
                      href="/ncollection_branding/static/src/img/favicon.ico"/>
            </head>
            <body style="margin:0;font-family:'Inter',-apple-system,Segoe UI,Roboto,Helvetica,Arial,sans-serif;background:#F7F9FC;color:#0F172A;">
                <div style="max-width:560px;margin:0 auto;padding:72px 24px;text-align:center;">
                    <img src="/ncollection_branding/static/src/img/logo.png" alt="NCollection"
                         style="max-height:60px;width:auto;margin-bottom:32px;"/>
                    <h1 style="font-size:1.7rem;margin:0 0 12px;" t-if="status == 'expired'">
                        Your subscription has expired</h1>
                    <h1 style="font-size:1.7rem;margin:0 0 12px;" t-else="">
                        Your workspace is paused</h1>
                    <p style="font-size:1.02rem;color:#5A6B83;line-height:1.55;margin:0 0 28px;">
                        Access to <strong t-out="company.name or 'your workspace'"/> is currently
                        unavailable
                        <t t-if="status == 'expired'">because the subscription has expired.</t>
                        <t t-else="">while the subscription is suspended.</t>
                        Please renew to restore access — your data is safe.
                    </p>
                    <a href="https://ncollection.com" target="_blank"
                       t-attf-style="display:inline-block;background:var(--nc-primary,{{brand}});color:#fff;padding:11px 22px;border-radius:6px;text-decoration:none;font-weight:600;">
                        Renew subscription</a>
                    <div style="margin-top:20px;">
                        <a href="/web/session/logout" style="color:#5A6B83;font-size:0.9rem;">Log out</a>
                    </div>
                    <p style="font-size:0.8rem;color:#8896A8;margin-top:36px;">
                        Need help? Contact
                        <a href="mailto:support@ncollection.com" style="color:#2D7AB7;">support@ncollection.com</a>.
                    </p>
                </div>
            </body>
        </html>
    </template>
</odoo>
