<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Shown once, after an administrator reset the password: see controllers/password_change.py. -->
    <template id="password_change_page" name="Choose your password">
        <t t-call="web.login_layout">
            <form class="oe_login_form" role="form" method="post">
                <input type="hidden" name="csrf_token" t-att-value="request.csrf_token()"/>
                <h4 class="mb-3">Choose your own password</h4>
                <p class="text-muted">An administrator reset the password of <strong t-out="login"/>. Enter the password you
                    were given, then choose a new one. You will then sign in again.</p>
                <p t-if="error" class="alert alert-danger" role="alert" t-out="error"/>
                <div class="mb-3">
                    <label for="old_password" class="form-label">Password you were given</label>
                    <input type="password" name="old_password" id="old_password" class="form-control" required="required"
                           autofocus="autofocus" autocomplete="current-password"/>
                </div>
                <div class="mb-3">
                    <label for="password" class="form-label">New password</label>
                    <input type="password" name="password" id="password" class="form-control" required="required"
                           autocomplete="new-password"/>
                </div>
                <div class="mb-3">
                    <label for="confirm_password" class="form-label">Confirm new password</label>
                    <input type="password" name="confirm_password" id="confirm_password" class="form-control"
                           required="required" autocomplete="new-password"/>
                </div>
                <div class="clearfix oe_login_buttons d-grid mt-3">
                    <button type="submit" class="btn btn-primary">Change password</button>
                    <a class="btn btn-link btn-sm" href="/web/session/logout">Sign out</a>
                </div>
            </form>
        </t>
    </template>
</odoo>
