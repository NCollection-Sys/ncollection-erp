<?xml version="1.0" encoding="UTF-8"?>
<!--
    Customer Workspace Dashboard templates (P1-T17).
    Markup mirrors demo/src/pages/Dashboard.tsx: header + quick actions, a KPI
    grid, then the charts row. Widgets arrive pre-filtered by the server (role,
    installation and licence); this template only renders what it is handed.
-->
<templates xml:space="preserve">

    <t t-name="ncollection_core.Dashboard">
        <div class="o_content nc-dashboard">

            <div class="nc-dashboard__header">
                <div>
                    <h1 class="nc-dashboard__title">Summary</h1>
                    <p class="nc-dashboard__subtitle">
                        <span class="nc-dashboard__company" t-if="state.meta.company_name" t-esc="state.meta.company_name"/>
                        <span t-if="firstName" class="nc-dashboard__welcome">Welcome back, <t t-esc="firstName"/></span>
                    </p>
                </div>
                <!-- Only actions for apps this tenant has AND licenses. -->
                <div class="nc-dashboard__actions" t-if="state.actions.length">
                    <button t-foreach="state.actions" t-as="quick" t-key="quick.key"
                            class="btn btn-secondary nc-quick-action"
                            t-on-click="() => this.onQuickAction(quick.action_id)">
                        <t t-esc="quick.label"/>
                    </button>
                </div>
            </div>

            <div t-if="state.loading" class="nc-dashboard__status">
                Loading your summary…
            </div>

            <div t-elif="state.failed" class="nc-dashboard__status nc-dashboard__status--error">
                The summary could not be loaded. Please refresh the page.
            </div>

            <!--
                An empty widget list is a legitimate state, not an error: a role
                may grant nothing, or the tenant's plan may not include the apps
                these widgets read.
            -->
            <div t-elif="!state.widgets.length" class="nc-dashboard__status">
                Nothing to summarise for your role yet.
            </div>

            <t t-else="">
                <div class="nc-kpi-grid" t-if="kpis.length">
                    <t t-foreach="kpis" t-as="widget" t-key="widget.key">
                        <t t-call="ncollection_core.DashboardKpiCard"/>
                    </t>
                </div>

                <!-- Balance Sheet and Profit & Loss: the report engine's own rows, with a link to the full report. -->
                <div class="nc-statement-grid" t-if="statements.length">
                    <t t-foreach="statements" t-as="widget" t-key="widget.key">
                        <t t-call="ncollection_core.DashboardStatementCard"/>
                    </t>
                </div>

                <!-- One ref on the container: t-ref inside a t-foreach would
                     only ever yield the last canvas. The component walks these
                     children on mount and pairs each canvas to its widget by
                     data-key. -->
                <div class="nc-chart-grid" t-ref="charts" t-if="charts.length">
                    <t t-foreach="charts" t-as="widget" t-key="widget.key">
                        <t t-call="ncollection_core.DashboardChartCard"/>
                    </t>
                </div>
            </t>

        </div>
    </t>

    <t t-name="ncollection_core.DashboardKpiCard">
        <div class="nc-kpi-card" t-att-data-widget="widget.key">
            <div class="nc-kpi-card__label"><t t-esc="widget.label"/></div>
            <div class="nc-kpi-card__value"><t t-esc="formatValue(widget)"/></div>
            <div class="nc-kpi-card__sub">
                <span t-if="formatTrend(widget)"
                      class="nc-trend"
                      t-att-class="trendClass(widget)"
                      t-esc="formatTrend(widget)"/>
                <span t-if="widget.sub"><t t-esc="widget.sub"/></span>
            </div>
        </div>
    </t>

    <t t-name="ncollection_core.DashboardStatementCard">
        <div class="nc-statement-card" t-att-data-widget="widget.key">
            <div class="nc-statement-card__head">
                <div>
                    <div class="nc-statement-card__title"><t t-esc="widget.label"/></div>
                    <div class="nc-statement-card__period" dir="ltr"><t t-esc="widget.period"/></div>
                </div>
                <button t-if="widget.action_id" class="btn btn-link nc-statement-card__open"
                        t-on-click="() => this.onQuickAction(widget.action_id)">
                    Open full report
                </button>
            </div>
            <div t-if="widget.empty" class="nc-statement-card__empty">
                No posted entries in this period yet.
            </div>
            <table t-else="" class="nc-statement-table">
                <tbody>
                    <tr t-foreach="widget.rows" t-as="row" t-key="row_index"
                        t-att-class="'nc-statement-row nc-statement-row--l' + row.level">
                        <td class="nc-statement-row__label" t-esc="row.label"/>
                        <td class="nc-statement-row__value" dir="ltr" t-esc="formatMoney(row.value)"/>
                    </tr>
                </tbody>
            </table>
        </div>
    </t>

    <t t-name="ncollection_core.DashboardChartCard">
        <div class="nc-chart-card" t-att-data-widget="widget.key">
            <div class="nc-chart-card__title"><t t-esc="widget.label"/></div>
            <div class="nc-chart-card__canvas">
                <!-- Chart.js draws here once mounted; paired by data-key. -->
                <canvas class="nc-chart" t-att-data-key="widget.key"/>
            </div>
        </div>
    </t>

</templates>
