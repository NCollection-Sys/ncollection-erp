<?xml version="1.0" encoding="UTF-8"?>
<!--
    Summary: the company's executive home. Header + quick actions, key figures, the financial statements, charts.
    Widgets arrive pre-filtered by the server (role, installation and licence); this template only renders what it
    is handed. Every card is the shared NCollection card (ncollection_branding): one design, no local card CSS.
-->
<templates xml:space="preserve">

    <t t-name="ncollection_core.Dashboard">
        <div class="o_content nc-dashboard">

            <div class="nc-dashboard__header">
                <div>
                    <h1 class="nc-dashboard__title">Summary</h1>
                    <p class="nc-dashboard__subtitle">
                        <span class="nc-dashboard__company" t-if="state.meta.company_name" t-esc="state.meta.company_name"/>
                        <span t-if="firstName" class="nc-dashboard__welcome">Welcome back, <t t-esc="firstName"/></span>
                    </p>
                </div>
                <!-- Only actions for apps this tenant has AND licenses. -->
                <div class="nc-dashboard__actions" t-if="state.actions.length">
                    <NcQuickActionCard t-foreach="state.actions" t-as="quick" t-key="quick.key"
                                       label="quick.label" icon="quickIcon(quick.key)"
                                       onClick="() => this.onQuickAction(quick.action_id)"/>
                </div>
            </div>

            <div t-if="state.loading" class="nc-kpi-grid" aria-busy="true">
                <NcKpiCard t-foreach="[1, 2, 3, 4, 5, 6]" t-as="n" t-key="n" label="''" state="'loading'"/>
            </div>

            <div t-elif="state.failed" class="nc-dashboard__status nc-dashboard__status--error">
                The summary could not be loaded. Please refresh the page.
            </div>

            <!--
                An empty widget list is a legitimate state, not an error: a role
                may grant nothing, or the tenant's plan may not include the apps
                these widgets read.
            -->
            <div t-elif="!state.widgets.length" class="nc-dashboard__status">
                Nothing to summarise for your role yet.
            </div>

            <t t-else="">
                <section class="nc-dashboard__section" t-if="kpis.length">
                    <h2 class="nc-dashboard__section-title">Key figures</h2>
                    <div class="nc-kpi-grid">
                        <div t-foreach="kpis" t-as="widget" t-key="widget.key" class="nc-kpi-cell"
                             t-att-data-widget="widget.key">
                            <NcKpiCard label="widget.label" value="formatValue(widget)"
                                       icon="iconFor(widget)" tone="widget.tone or 'neutral'"
                                       trend="trendFor(widget)" sub="widget.sub or undefined"
                                       period="widget.period or undefined"
                                       onClick="widget.drill ? () => this.drill(widget) : undefined"/>
                        </div>
                    </div>
                </section>

                <!-- Balance Sheet and Profit &amp; Loss: the report engine's own rows; amounts open their source. -->
                <section class="nc-dashboard__section" t-if="statements.length">
                    <h2 class="nc-dashboard__section-title">Financial statements</h2>
                    <div class="nc-statement-grid">
                        <div t-foreach="statements" t-as="widget" t-key="widget.key" class="nc-statement-cell"
                             t-att-data-widget="widget.key">
                            <NcStatementCard title="widget.label" period="widget.period"
                                             rows="statementRows(widget)" empty="widget.empty"
                                             emptyText="texts.statementEmpty" openLabel="texts.openReport"
                                             expandLabel="texts.showAccounts"
                                             onOpen="widget.action_id ? () => this.onQuickAction(widget.action_id) : undefined"
                                             onRowClick="(row) => this.drillStatement(widget, row)"/>
                        </div>
                    </div>
                </section>

                <!-- One ref on the container: t-ref inside a t-foreach would
                     only ever yield the last canvas. The component walks these
                     children on mount and pairs each canvas to its widget by
                     data-key. -->
                <section class="nc-dashboard__section" t-if="charts.length">
                    <h2 class="nc-dashboard__section-title">Trends</h2>
                    <div class="nc-chart-grid" t-ref="charts">
                        <t t-foreach="charts" t-as="widget" t-key="widget.key">
                            <t t-call="ncollection_core.DashboardChartCard"/>
                        </t>
                    </div>
                </section>
            </t>

        </div>
    </t>

    <t t-name="ncollection_core.DashboardChartCard">
        <div class="nc-chart-card" t-att-data-widget="widget.key">
            <div class="nc-chart-card__title"><t t-esc="widget.label"/></div>
            <div class="nc-chart-card__canvas">
                <!-- Chart.js draws here once mounted; paired by data-key. -->
                <canvas class="nc-chart" t-att-data-key="widget.key"/>
            </div>
        </div>
    </t>

</templates>
