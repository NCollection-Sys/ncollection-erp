#. module: ncollection_ai
#. odoo-python
#: code:addons/ncollection_ai/models/domain_mapper.py:0
msgid "Ask a question to search for."
msgstr "اكتب سؤالًا للبحث عنه."

#. module: ncollection_ai
#: model:ir.model.fields,field_description:ncollection_ai.field_ncollection_ai_context__display_name
#: model:ir.model.fields,field_description:ncollection_ai.field_ncollection_ai_domain_mapper__display_name
#: model:ir.model.fields,field_description:ncollection_ai.field_ncollection_ai_gateway__display_name
