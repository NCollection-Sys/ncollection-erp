    {
      "name": "CRM",
      "item": [
        {
          "name": "List Leads",
          "request": {
            "method": "GET",
            "header": [{"key": "Authorization", "value": "Bearer {{access_token}}"}],
            "url": {
              "raw": "{{base_url}}/api/v1/crm/leads",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "crm", "leads"]
            }
          }
        },
        {
          "name": "Create Lead",
          "request": {
