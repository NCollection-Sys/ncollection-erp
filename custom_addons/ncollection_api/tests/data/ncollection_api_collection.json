          "name": "Get OpenAPI 3.1 Spec",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{base_url}}/api/v1/openapi.json",
              "host": ["{{base_url}}"],
              "path": ["api", "v1", "openapi.json"]
            }
          }
        }
      ]
    }
  ]
}
