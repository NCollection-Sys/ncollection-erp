<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Webhook Subscriptions List View -->
    <record id="view_webhook_subscription_list" model="ir.ui.view">
        <field name="name">ncollection.webhook.subscription.list</field>
        <field name="model">ncollection.webhook.subscription</field>
        <field name="arch" type="xml">
            <list string="Webhook Subscriptions" decoration-muted="not active" decoration-danger="state == 'disabled'" decoration-warning="state == 'degraded'">
                <field name="name"/>
                <field name="target_url"/>
                <field name="event_types"/>
                <field name="client_id"/>
                <field name="state"/>
                <field name="failure_count"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <!-- Webhook Subscriptions Form View -->
    <record id="view_webhook_subscription_form" model="ir.ui.view">
        <field name="name">ncollection.webhook.subscription.form</field>
        <field name="model">ncollection.webhook.subscription</field>
        <field name="arch" type="xml">
            <form string="Webhook Subscription">
                <sheet>
                    <div class="oe_title">
                        <label for="name" class="oe_edit_only"/>
                        <h1><field name="name" placeholder="e.g. Zapier Sales Integration"/></h1>
                    </div>
                    <group>
                        <group name="endpoint_details" string="Endpoint Details">
                            <field name="target_url" placeholder="https://api.example.com/webhooks/odoo"/>
                            <field name="event_types" placeholder="sale.order.confirmed,account.move.posted or *"/>
                            <field name="client_id"/>
                        </group>
                        <group name="status_details" string="Health &amp; Security">
                            <field name="secret" password="True"/>
                            <field name="state"/>
                            <field name="failure_count"/>
                            <field name="active"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Deliveries" name="deliveries">
                            <field name="delivery_ids" readonly="1">
                                <list string="Deliveries" decoration-success="state == 'delivered'" decoration-danger="state in ('failed', 'dead_letter')" limit="20">
                                    <field name="create_date" string="Created"/>
                                    <field name="event"/>
                                    <field name="attempt"/>
                                    <field name="response_code"/>
                                    <field name="duration_ms"/>
                                    <field name="state"/>
                                    <field name="next_retry"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Webhook Deliveries List View -->
    <record id="view_webhook_delivery_list" model="ir.ui.view">
        <field name="name">ncollection.webhook.delivery.list</field>
        <field name="model">ncollection.webhook.delivery</field>
        <field name="arch" type="xml">
            <list string="Webhook Deliveries" decoration-success="state == 'delivered'" decoration-danger="state in ('failed', 'dead_letter')" decoration-info="state == 'pending'" create="0" delete="0">
                <field name="create_date" string="Timestamp"/>
                <field name="uuid"/>
                <field name="subscription_id"/>
                <field name="event"/>
                <field name="attempt"/>
                <field name="response_code"/>
                <field name="duration_ms"/>
                <field name="state"/>
                <field name="next_retry"/>
            </list>
        </field>
    </record>

    <!-- Webhook Deliveries Form View -->
    <record id="view_webhook_delivery_form" model="ir.ui.view">
        <field name="name">ncollection.webhook.delivery.form</field>
        <field name="model">ncollection.webhook.delivery</field>
        <field name="arch" type="xml">
            <form string="Webhook Delivery Log" create="0" delete="0">
                <header>
                    <button name="action_retry" type="object" string="Retry Delivery" class="btn-primary" invisible="state == 'delivered'"/>
                    <field name="state" widget="statusbar" statusbar_visible="pending,delivered,failed,dead_letter"/>
                </header>
                <sheet>
                    <group>
                        <group name="delivery_meta" string="Delivery Info">
                            <field name="uuid"/>
                            <field name="subscription_id"/>
                            <field name="event"/>
                            <field name="delivered_at"/>
                        </group>
                        <group name="delivery_status" string="Execution Details">
                            <field name="attempt"/>
                            <field name="max_attempts"/>
                            <field name="response_code"/>
                            <field name="duration_ms"/>
                            <field name="next_retry"/>
                        </group>
                    </group>
                    <group string="Payload">
                        <field name="payload" readonly="1" widget="ace" options="{'mode': 'json'}"/>
                    </group>
                    <group string="Response &amp; Error" invisible="not response_body and not error_message">
                        <field name="response_body" readonly="1"/>
                        <field name="error_message" readonly="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Actions -->
    <record id="action_webhook_subscriptions" model="ir.actions.act_window">
        <field name="name">Webhook Subscriptions</field>
        <field name="res_model">ncollection.webhook.subscription</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_webhook_deliveries" model="ir.actions.act_window">
        <field name="name">Webhook Delivery Logs</field>
        <field name="res_model">ncollection.webhook.delivery</field>
        <field name="view_mode">list,form</field>
    </record>

    <!-- Menu Items under Technical/API -->
    <menuitem id="menu_webhook_subscriptions"
              name="Webhook Subscriptions"
              parent="menu_nc_api_root"
              action="action_webhook_subscriptions"
              sequence="30"/>

    <menuitem id="menu_webhook_deliveries"
              name="Delivery Logs"
              parent="menu_nc_api_root"
              action="action_webhook_deliveries"
              sequence="40"/>
</odoo>
