<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- F2-T01 isolation: a report run + its lines are PRIVATE to the user
             who generated them. Without this, the transient wizard/line records
             (granted to account.group_account_readonly) are readable by any such
             user — which also makes the XLSX ir.attachment (res_model/res_id ->
             the wizard) downloadable by another user/company by guessing its id,
             and lets action_view() clear another user's in-flight report rows.
             Scoping to create_uid closes both. -->
        <record id="rule_report_reference_own" model="ir.rule">
            <field name="name">Report runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_reference"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_line_own" model="ir.rule">
            <field name="name">Report lines: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_line"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
