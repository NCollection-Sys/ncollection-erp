<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- F2-T01 isolation: a report run + its lines are PRIVATE to the user
             who generated them. Without this, the transient wizard/line records
             (granted to account.group_account_readonly) are readable by any such
             user — which also makes the XLSX ir.attachment (res_model/res_id ->
             the wizard) downloadable by another user/company by guessing its id,
             and lets action_view() clear another user's in-flight report rows.
             Scoping to create_uid closes both. -->
        <record id="rule_report_reference_own" model="ir.rule">
            <field name="name">Report runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_reference"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_line_own" model="ir.rule">
            <field name="name">Report lines: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_line"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <!-- F2-T02: same per-user scoping for the GL/TB report runs + GL lines. -->
        <record id="rule_report_trial_balance_own" model="ir.rule">
            <field name="name">Trial Balance runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_trial_balance"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_general_ledger_own" model="ir.rule">
            <field name="name">General Ledger runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_general_ledger"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_gl_line_own" model="ir.rule">
            <field name="name">General Ledger lines: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_gl_line"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <!-- F2-T03: same per-user scoping for the BS/P&L report runs. Their
             lines reuse ncollection.account.report.line, already scoped above. -->
        <record id="rule_report_balance_sheet_own" model="ir.rule">
            <field name="name">Balance Sheet runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_balance_sheet"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_profit_loss_own" model="ir.rule">
            <field name="name">Profit and Loss runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_profit_loss"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <!-- F2-T08: same per-user scoping for the executive report runs.
             Their lines reuse ncollection.account.report.line, scoped above. -->
        <record id="rule_report_financial_summary_own" model="ir.rule">
            <field name="name">Financial Summary runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_summary"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_revenue_analysis_own" model="ir.rule">
            <field name="name">Revenue Analysis runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_revenue"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_expense_analysis_own" model="ir.rule">
            <field name="name">Expense Analysis runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_expense"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_profitability_own" model="ir.rule">
            <field name="name">Profitability Report runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_profitability"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <!-- F2-T04 (#114). Same rule as every wizard above: a run belongs to the
             user who generated it. The FIGURES already sit behind
             rule_report_line_own, so what this closes is the run itself — its
             company, its period, its comparison window — plus re-running
             action_view()/the exports against someone else's record. -->
        <record id="rule_report_cash_flow_own" model="ir.rule">
            <field name="name">Cash Flow Statement runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_cash_flow"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_equity_changes_own" model="ir.rule">
            <field name="name">Statement of Changes in Equity runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_equity_changes"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <!-- F2-T05 partner-facing reports (#115), added by #413. These five
             shipped with an ACL row and no rule: both wizards filter
             `create_uid` in PYTHON when clearing a previous run, and that hand
             filter was the only control — a plain RPC search([]) on
             partner.line or aged.line walked straight past it and returned
             another accountant's rendered partner figures. Standing Rule 4: a
             restriction that exists only above the ORM is not a restriction.
             The two .line models are the ones that carry money. -->
        <record id="rule_report_partner_ledger_own" model="ir.rule">
            <field name="name">Partner Ledger runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_partner_ledger"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_partner_line_own" model="ir.rule">
            <field name="name">Partner Ledger lines: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_partner_line"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_aged_partner_own" model="ir.rule">
            <field name="name">Aged Partner Balance runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_aged_partner"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_aged_line_own" model="ir.rule">
            <field name="name">Aged Partner Balance lines: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_aged_line"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_statement_own" model="ir.rule">
            <field name="name">Partner Statement runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_statement"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <!-- F2-T09 dimension analysis (#315). These ARE per-user report runs,
             so they get the same create_uid scoping as every sibling — and
             #413's guard (test_every_model_this_module_grants_is_scoped_to_its_creator)
             fails the build without them, which is the guard working as
             designed on the first module added after it landed. -->
        <record id="rule_report_cost_center_own" model="ir.rule">
            <field name="name">Cost Center Analysis runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_cost_center"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_profit_center_own" model="ir.rule">
            <field name="name">Profit Center Analysis runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_profit_center"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_department_own" model="ir.rule">
            <field name="name">Department Analysis runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_department"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
