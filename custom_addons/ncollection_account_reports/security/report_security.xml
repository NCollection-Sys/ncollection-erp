<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- F2-T01 isolation: a report run + its lines are PRIVATE to the user
             who generated them. Without this, the transient wizard/line records
             (granted to account.group_account_readonly) are readable by any such
             user — which also makes the XLSX ir.attachment (res_model/res_id ->
             the wizard) downloadable by another user/company by guessing its id,
             and lets action_view() clear another user's in-flight report rows.
             Scoping to create_uid closes both. -->
        <record id="rule_report_reference_own" model="ir.rule">
            <field name="name">Report runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_reference"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_line_own" model="ir.rule">
            <field name="name">Report lines: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_line"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <!-- F2-T02: same per-user scoping for the GL/TB report runs + GL lines. -->
        <record id="rule_report_trial_balance_own" model="ir.rule">
            <field name="name">Trial Balance runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_trial_balance"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_general_ledger_own" model="ir.rule">
            <field name="name">General Ledger runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_general_ledger"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_gl_line_own" model="ir.rule">
            <field name="name">General Ledger lines: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_gl_line"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <!-- F2-T03: same per-user scoping for the BS/P&L report runs. Their
             lines reuse ncollection.account.report.line, already scoped above. -->
        <record id="rule_report_balance_sheet_own" model="ir.rule">
            <field name="name">Balance Sheet runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_balance_sheet"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
        <record id="rule_report_profit_loss_own" model="ir.rule">
            <field name="name">Profit and Loss runs: own only</field>
            <field name="model_id" ref="model_ncollection_account_report_profit_loss"/>
            <field name="domain_force">[('create_uid', '=', user.id)]</field>
            <field name="global" eval="True"/>
        </record>
    </data>
</odoo>
