<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The NCollection financial reports (statements, ledgers, analyses, VAT) as ONE kind of document a stamp can be
         scoped to: a "Reviewed" stamp on statements, say, without touching invoices. -->
    <record id="doc_type_financial_report" model="ncollection.document.type">
        <field name="name">Financial Report</field>
        <field name="code">financial_report</field>
        <field name="sequence">100</field>
        <field name="report_ids" eval="[(6, 0, [ ref('ncollection_account_reports.action_report_financial'), ref('ncollection_account_reports.action_report_trial_balance'), ref('ncollection_account_reports.action_report_general_ledger'), ref('ncollection_account_reports.action_report_balance_sheet'), ref('ncollection_account_reports.action_report_profit_loss'), ref('ncollection_account_reports.action_report_financial_summary'), ref('ncollection_account_reports.action_report_revenue_analysis'), ref('ncollection_account_reports.action_report_expense_analysis'), ref('ncollection_account_reports.action_report_profitability'), ref('ncollection_account_reports.action_report_partner_ledger'), ref('ncollection_account_reports.action_report_aged_partner'), ref('ncollection_account_reports.action_report_partner_statement'), ref('ncollection_account_reports.action_report_cash_flow'), ref('ncollection_account_reports.action_report_equity_changes'), ref('ncollection_account_reports.action_report_cost_center'), ref('ncollection_account_reports.action_report_profit_center'), ref('ncollection_account_reports.action_report_department'), ref('ncollection_account_reports.action_report_uae_vat'), ref('ncollection_account_reports.action_report_tax_analysis')])]"/>
    </record>
</odoo>
