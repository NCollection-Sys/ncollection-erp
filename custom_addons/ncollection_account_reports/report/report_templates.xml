<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!-- F2-T01: native QWeb PDF for any report built on the engine. It renders
         from the report's own _nc_columns() + _nc_compute_lines() — so every
         F2-T02+ report gets PDF for free. -->
    <record id="action_report_financial" model="ir.actions.report">
        <field name="name">Financial Report</field>
        <field name="model">ncollection.account.report.reference</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">ncollection_account_reports.report_financial</field>
        <field name="report_file">ncollection_account_reports.report_financial</field>
        <field name="print_report_name">object._nc_report_title()</field>
    </record>

    <template id="report_financial">
        <t t-call="web.html_container">
            <t t-foreach="docs" t-as="o">
                <t t-call="web.external_layout">
                    <div class="page">
                        <h2 t-out="o._nc_report_title()"/>
                        <p class="text-muted">
                            <span t-out="o.company_id.name"/> ·
                            <span t-out="o.date_from"/> → <span t-out="o.date_to"/> ·
                            <span t-out="dict(o._fields['target_move'].selection).get(o.target_move)"/>
                        </p>
                        <table class="table table-sm o_main_table">
                            <thead>
                                <tr>
                                    <t t-foreach="o._nc_columns()" t-as="col">
                                        <th t-att-class="'text-end' if col['type'] == 'monetary' else ''"
                                            t-out="col['label']"/>
                                    </t>
                                </tr>
                            </thead>
                            <tbody>
                                <t t-foreach="o._nc_compute_lines()" t-as="line">
                                    <tr t-att-style="'font-weight:bold' if not line.get('level') else ''">
                                        <t t-foreach="o._nc_columns()" t-as="col">
                                            <td t-att-class="'text-end' if col['type'] == 'monetary' else ''">
                                                <t t-if="col['type'] == 'monetary'">
                                                    <span t-out="line.get(col['key'], 0.0)"
                                                          t-options="{'widget': 'monetary', 'display_currency': o.company_id.currency_id}"/>
                                                </t>
                                                <t t-else="">
                                                    <span t-out="line.get(col['key'], '')"/>
                                                </t>
                                            </td>
                                        </t>
                                    </tr>
                                </t>
                            </tbody>
                        </table>
                    </div>
                </t>
            </t>
        </t>
    </template>

</odoo>
