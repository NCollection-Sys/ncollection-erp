<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        The Reports app: one hub, seven business categories, and every report
        client action. The ARRANGEMENT of other modules' report menus into these
        categories lives in ncollection.report.service (one catalog drives the
        menu tree, the landing page and the hidden duplicates) — this file only
        creates the containers and this module's own entries.

        Each engine report opens the shared client viewer; the report itself is
        chosen by context.nc_report_model, so there is one viewer and no
        per-report screen to keep in step.
    -->
    <record id="action_nc_report_hub" model="ir.actions.client">
        <field name="name">Reports</field>
        <field name="tag">ncollection_account_reports.report_hub</field>
    </record>

    <menuitem id="menu_nc_reports_root" name="Reports"
              action="action_nc_report_hub" sequence="57"
              web_icon="ncollection_account_reports,static/description/icon.png"/>
    <menuitem id="menu_nc_reports_financial" name="Financial &amp; Accounting" parent="menu_nc_reports_root" sequence="10"/>
    <menuitem id="menu_nc_reports_receivables" name="Receivables &amp; Payables" parent="menu_nc_reports_root" sequence="20"/>
    <menuitem id="menu_nc_reports_sales" name="Sales" parent="menu_nc_reports_root" sequence="30"/>
    <menuitem id="menu_nc_reports_purchases" name="Purchases" parent="menu_nc_reports_root" sequence="40"/>
    <menuitem id="menu_nc_reports_inventory" name="Inventory" parent="menu_nc_reports_root" sequence="50"/>
    <menuitem id="menu_nc_reports_tax" name="Tax" parent="menu_nc_reports_root" sequence="60"/>
    <menuitem id="menu_nc_reports_management" name="Management &amp; Analytics" parent="menu_nc_reports_root" sequence="70"/>

    <!-- The old flat folder is kept as a record (other modules parent their report menu to it) but is no longer shown. -->
    <record id="menu_ncollection_account_reports" model="ir.ui.menu">
        <field name="active" eval="False"/>
    </record>

