<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">

    <!--
        Row-level multi-company scoping for the FTA checklist. A tenant DB is
        single-company today (database-per-tenant), but Odoo permits several
        res.company in one DB and P10-T06 plans in-tenant multi-company
        consolidation. The ACL (ir.model.access.csv) is model-wide, so without
        this rule an accountant scoped to Company A could read/edit Company B's
        FTA rows by id. Mirrors how Odoo core scopes account.* records.
    -->
    <record id="fta_compliance_item_company_rule" model="ir.rule">
        <field name="name">FTA compliance item: per-company</field>
        <field name="model_id" ref="model_ncollection_fta_compliance_item"/>
        <field name="global" eval="True"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>

</odoo>
