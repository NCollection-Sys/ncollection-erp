#. module: ncollection_account_invoice_layout
#: model_terms:ir.ui.view,arch_db:ncollection_account_invoice_layout.view_nc_adjustment_type_form
msgid ""
"A charge increases the invoice, a discount decreases it. Each adjustment is booked as a real invoice line on\n"
"                        its account with its taxes, so the journal entry, receivable / payable and reconciliation stay Odoo's own.\n"
"                        Order: line discounts, then invoice discounts, then charges, then taxes."
msgstr "الرسم يزيد الفاتورة والخصم ينقصها. يُسجَّل كل تعديل كبند فاتورة حقيقي على حسابه مع ضرائبه، فيبقى قيد اليومية والذمم والتسوية من Odoo نفسه. الترتيب: خصومات البنود، ثم خصومات الفاتورة، ثم الرسوم، ثم الضرائب."

#. module: ncollection_account_invoice_layout
