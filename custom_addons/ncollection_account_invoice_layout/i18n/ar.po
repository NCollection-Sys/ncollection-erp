msgid "\"%s\" is an invoice charge or discount. Change it in the Charges & Adjustments block of the invoice."
msgstr "«%s» رسم أو خصم على مستوى الفاتورة. عدّله من قسم الرسوم والتعديلات في الفاتورة."

#. module: ncollection_account_invoice_layout
#. odoo-python
#: code:addons/ncollection_account_invoice_layout/models/invoice_adjustment.py:0
