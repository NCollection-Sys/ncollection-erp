<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Hardened auth defaults (P1-T19), applied via set_param because some
         keys (base.login_cooldown_*) already exist in a fresh database —
         a <record> would violate ir_config_parameter_key_uniq. noupdate:
         runs at install only, so module upgrades never clobber per-tenant
         tuning of these same keys. -->
    <data noupdate="1">

        <!-- Odoo CORE login cooldown = the app-layer brute-force lockout.
             After N failed logins, further attempts are refused for the
             cooldown duration. (OCA auth_brute_force is dead upstream —
             absent from every branch >= 12.0; this core mechanism is the
             documented minimal equivalent. Set _after to 0 to disable.) -->
        <function model="ir.config_parameter" name="set_param">
            <value>base.login_cooldown_after</value>
            <value>5</value>
        </function>
        <function model="ir.config_parameter" name="set_param">
            <value>base.login_cooldown_duration</value>
            <value>300</value>
        </function>

        <!-- OCA auth_session_timeout: log out inactive sessions after 2h.
             Per-tenant configurable via this same parameter. -->
        <function model="ir.config_parameter" name="set_param">
            <value>inactive_session_time_out_delay</value>
            <value>7200</value>
        </function>

        <!-- STAGE 1 — minimise (#219 window, #261 semantics).
             ncollection.auth.log stores ip_address + user_agent (PII) on every
             auth event, and #178 put that on every provisioned tenant. At this
             age those fields are dropped and `login` is replaced by a salted
             digest; event_type, create_date and user_id remain, so the attack
             PATTERN survives while the identifying detail does not.
             Set to 0 (or <= 0) to DISABLE minimisation entirely. -->
        <function model="ir.config_parameter" name="set_param">
            <value>ncollection_auth.log_retention_days</value>
            <value>180</value>
        </function>

        <!-- STAGE 2 — hard delete (#261).
             Breach studies put MEAN time-to-identify a compromise past 200
             days, so #219's flat 180-day DELETE destroyed the login_failed
             run-up and the login_success for the compromised session before
             anyone looked. 400 clears that with margin for an investigation
             that starts late, and covers an annual audit cycle.

             The minimised skeleton keeps user_id, so it is PSEUDONYMOUS, not
             anonymous — still personal data under PDPL, which is exactly why
             it gets a window of its own instead of being kept forever.

             Must be >= log_retention_days; a shorter value is REFUSED, not
             clamped (it would delete rows before they were ever minimised).
             Set to 0 (or <= 0) to keep skeletons indefinitely — read the
             paragraph above before doing that. -->
        <function model="ir.config_parameter" name="set_param">
            <value>ncollection_auth.log_skeleton_days</value>
            <value>400</value>
        </function>

    </data>
</odoo>
