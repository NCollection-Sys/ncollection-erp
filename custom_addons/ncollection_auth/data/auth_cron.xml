<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Daily auth-log retention purge (#219). Deletes ncollection.auth.log
            rows older than the ncollection_auth.log_retention_days parameter
            (data/auth_params.xml, default 180); <= 0 disables the purge.

            A NAMED scheduled action, not an @api.autovacuum hook, on purpose:
            ncollection.auth.log holds ip_address + user_agent (PII), so under
            UAE PDPL this purge is compliance evidence. A distinct Scheduled
            Action carries its own last-run/next-run timestamp that a reviewer
            can point at and an operator can disable independently. An
            autovacuum hook is bundled anonymously into Odoo's shared
            "Base: Auto-vacuum internal data" job alongside unrelated cleanup,
            which cannot be shown or disabled on its own.

            Mirrors the project's existing cron idiom
            (ncollection_billing/data/lifecycle_cron.xml -> cron_lifecycle_sweep):
            state=code calling a single model method that reads its own config.

            noupdate: per-tenant tuning of the interval or the active flag
            survives module upgrades, exactly as the params file does.
        -->
        <record id="cron_gc_auth_log" model="ir.cron">
            <field name="name">NCollection: auth log retention purge</field>
            <field name="model_id" ref="ncollection_auth.model_ncollection_auth_log"/>
            <field name="state">code</field>
            <field name="code">model._gc_auth_log()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
