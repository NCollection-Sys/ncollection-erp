<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_nc_business_settings_form_purchase" model="ir.ui.view">
        <field name="name">ncollection.business.settings.form.purchase</field>
        <field name="model">ncollection.business.settings</field>
        <field name="inherit_id" ref="ncollection_core.view_nc_business_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook[@name='nc_business_settings']" position="inside">
                <page string="Purchase" name="purchase">
                    <group>
                        <group string="Orders">
                            <field name="company_currency_id" invisible="1"/>
                            <field name="lock_confirmed_po"/>
                            <field name="po_order_approval"/>
                            <field name="po_double_validation_amount" invisible="not po_order_approval"/>
                        </group>
                        <group string="Vendors">
                            <field name="group_warning_purchase"/>
                            <field name="group_send_reminder"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
