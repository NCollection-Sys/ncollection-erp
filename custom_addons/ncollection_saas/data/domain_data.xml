<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            Weekly domain / SSL reconciliation (P2-T06). Backfills a subdomain
            record for every ready tenant, refreshes each cert's expiry from the
            wildcard param, and raises a 14-day-lead alert (chatter + activity)
            on anything expiring. Self-healing + idempotent — same philosophy as
            the P2-T03 config-sync reconciliation cron.
        -->
        <record id="cron_domain_ssl_scan" model="ir.cron">
            <field name="name">NCollection: scan tenant domains &amp; SSL expiry</field>
            <field name="model_id" ref="model_ncollection_domain"/>
            <field name="state">code</field>
            <field name="code">model._cron_scan_ssl_expiry()</field>
            <field name="interval_number">7</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Base domain tenant subdomains hang off (<db>.<base-domain>).
             Non-secret; overridable per deployment. -->
        <record id="param_base_domain" model="ir.config_parameter">
            <field name="key">ncollection_saas.base_domain</field>
            <field name="value">ncollectionerp.com</field>
        </record>
    </data>
</odoo>
