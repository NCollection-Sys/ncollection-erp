<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!-- Nightly per-tenant backup (P2-T05). Typed for the retention pyramid
             inside the method (monthly on the 1st, weekly on Sunday, else
             daily). Enqueues onto the provisioning channel — off HTTP workers. -->
        <record id="cron_tenant_backup_nightly" model="ir.cron">
            <field name="name">NCollection: nightly tenant backups</field>
            <field name="model_id" ref="model_ncollection_backup"/>
            <field name="state">code</field>
            <field name="code">model._cron_nightly_backups()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Retention: keep 7 daily / 4 weekly / 12 monthly per tenant. -->
        <record id="cron_tenant_backup_prune" model="ir.cron">
            <field name="name">NCollection: prune old tenant backups</field>
            <field name="model_id" ref="model_ncollection_backup"/>
            <field name="state">code</field>
            <field name="code">model._cron_prune()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">days</field>
            <field name="active" eval="True"/>
        </record>

        <!-- Monthly restore drill (§5.3): restore the newest backup to a scratch
             DB and confirm it is restorable, not merely present. -->
        <record id="cron_tenant_backup_drill" model="ir.cron">
            <field name="name">NCollection: monthly restore drill</field>
            <field name="model_id" ref="model_ncollection_backup"/>
            <field name="state">code</field>
            <field name="code">model._cron_restore_drill()</field>
            <field name="interval_number">1</field>
            <field name="interval_type">months</field>
            <field name="active" eval="True"/>
        </record>
    </data>
</odoo>
