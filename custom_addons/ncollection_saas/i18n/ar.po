#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/config_sync_rekey.py:0
msgid " %(n)s tenant(s) skipped (no config-sync account — they predate it and hold no key to rotate): %(names)s."
msgstr "تم تخطي %(n)s مستأجر (لا يوجد حساب لمزامنة الإعدادات — فهم سابقون له ولا يملكون مفتاحًا لتدويره): %(names)s."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/config_sync.py:0
msgid "%(body)s\n\nThis failure cannot heal itself — the nightly reconcile will keep retrying without success until the cause is fixed (typically a stale per-tenant key; see #221)."
msgstr "%(body)s\n\nلا يمكن لهذا الفشل أن يُصلح نفسه — ستواصل المطابقة الليلية المحاولة دون نجاح إلى أن يُعالج السبب (غالبًا مفتاح قديم خاص بالمستأجر؛ راجع #221)."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/platform_entry.py:0
msgid "%(company)s did not accept the entry (HTTP %(status)s). Its workspace is probably behind this platform's code. Upgrade every NCollection module named by the upgrade preflight for it, together in one run (never ncollection_core alone), then try again."
msgstr "%(company)s لم تقبل الدخول (HTTP %(status)s). مساحة عملها على الأرجح أقدم من شيفرة هذه المنصة. حدّث معًا، في تشغيل واحد، كل وحدات NCollection التي يسمّيها فحص الترقية المسبق لها (وليس ncollection_core وحدها أبدًا)، ثم أعد المحاولة."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/platform_entry.py:0
msgid "%s cannot be entered right now (it is not provisioned, or it is suspended or expired)."
msgstr "لا يمكن دخول %s الآن (لم تتم تهيئتها، أو أنها معلّقة أو منتهية)."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/platform_entry.py:0
#: code:addons/ncollection_saas/models/tenant_admin.py:0
msgid "%s could not be reached. Try again in a moment."
msgstr "تعذّر الوصول إلى %s. حاول مرة أخرى بعد قليل."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/platform_entry.py:0
msgid "%s entered this company as Platform Administrator."
msgstr "دخل %s هذه الشركة بصفته مدير المنصّة."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/platform_entry.py:0
msgid "%s has no safe address to enter."
msgstr "%s ليس لها عنوان آمن للدخول."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/platform_entry.py:0
msgid "%s has no valid database registered."
msgstr "%s ليس لها قاعدة بيانات صالحة مسجّلة."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/config_sync_rekey.py:0
msgid "%s is not set, so no per-tenant key can be derived. Set it in the secrets store / .env and retry — refusing rather than reporting a rotation that did not happen."
msgstr "%s غير مضبوط، لذا لا يمكن اشتقاق مفتاح لكل مستأجر. اضبطه في مخزن الأسرار أو ملف .env ثم أعد المحاولة — فنحن نرفض بدلًا من الإبلاغ عن تدوير لم يحدث."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/tenant.py:0
msgid "'%s' already has a workspace; it cannot be rejected."
msgstr "'%s' لديها مساحة عمل بالفعل؛ لا يمكن رفضها."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/wizards/backup_restore.py:0
msgid "'%s' is a live tenant database. Choose a scratch/staging name — THIS WIZARD never overwrites a live tenant. (An in-place rollback of a tenant's OWN snapshot is a different path: action_restore_in_place, #244.)"
msgstr "'%s' قاعدة بيانات مستأجر فعّالة. اختر اسمًا لبيئة تجريبية أو اختبار — هذا المعالج لا يستبدل مستأجرًا فعّالًا أبدًا. (الاستعادة في المكان من لقطة المستأجر نفسه مسار مختلف: action_restore_in_place، #244.)"

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/tenant.py:0
msgid "'%s' is already being provisioned."
msgstr "'%s' قيد التهيئة بالفعل."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/tenant.py:0
msgid "'%s' is already provisioned; nothing was created."
msgstr "'%s' مُهيّأة بالفعل؛ لم يُنشأ شيء."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/res_config_settings.py:0
msgid "'%s' is not a valid base domain. Use a hostname with at least two labels, e.g. example.com."
msgstr "'%s' ليس نطاقًا أساسيًا صالحًا. استخدم اسم مضيف من جزأين على الأقل، مثل example.com."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/tenant.py:0
msgid "'%s' was rejected. Reopen the request before provisioning."
msgstr "تم رفض '%s'. أعد فتح الطلب قبل التهيئة."

#. module: ncollection_saas
#: model_terms:ir.ui.view,arch_db:ncollection_saas.view_ncollection_tenant_form_modules
msgid ")\n                            is the shared baseline for every tenant that uses it. Anything\n                            changed on this tab applies to <strong>this tenant only</strong>\n                            — the plan and every other tenant stay exactly as they were."
msgstr ") هي الأساس المشترك لكل مستأجر يستخدمها. أي تغيير على هذا التبويب يسري على <strong>هذا المستأجر فقط</strong> — وتبقى الخطة وكل مستأجر آخر كما هي تمامًا."

#. module: ncollection_saas
#: model:ir.model.fields,help:ncollection_saas.field_ncollection_fleet_migration_line__wave
msgid "0 = canary; 1..N = rolling waves."
msgstr "0 = تجريبي؛ 1..N = موجات تدريجية."

#. module: ncollection_saas
#: model:mail.template,body_html:ncollection_saas.mail_template_checkout_verify
msgid "<div style=\"font-family:Arial,sans-serif;color:#0F172A;\">\n                    <p>Hi <t t-out=\"object.contact_name or object.company_name\"/>,</p>\n                    <p>Thanks for registering <strong t-out=\"object.company_name\"/>. Confirm your\n                       contact email so we can review your request. Your workspace\n                       <strong t-out=\"object.database_name\"/> is created once an\n                       administrator approves it.</p>\n                    <p>\n                        <a t-attf-href=\"{{ object.get_base_url() }}/nc/checkout/verify/{{ object.checkout_token }}\" style=\"display:inline-block;padding:10px 18px;background:#1F5F8F;color:#fff;                                   text-decoration:none;border-radius:6px;\">Confirm my email</a>\n                    </p>\n                    <p style=\"color:#64748B;font-size:13px;\">If you didn't request this, you can ignore this email.</p>\n                </div>\n            "
msgstr "<div style=\"font-family:Arial,sans-serif;color:#0F172A;\"><p>مرحبًا <t t-out=\"object.contact_name or object.company_name\"/>،</p><p>شكرًا لتسجيل <strong t-out=\"object.company_name\"/>. أكّد بريدك الإلكتروني للتواصل حتى نراجع طلبك. يتم إنشاء مساحة عملك <strong t-out=\"object.database_name\"/> بعد موافقة المسؤول.</p><p><a t-attf-href=\"{{ object.get_base_url() }}/nc/checkout/verify/{{ object.checkout_token }}\" style=\"display:inline-block;padding:10px 18px;background:#1F5F8F;color:#fff; text-decoration:none;border-radius:6px;\">تأكيد بريدي الإلكتروني</a></p><p style=\"color:#64748B;font-size:13px;\">إذا لم تطلب ذلك، يمكنك تجاهل هذه الرسالة.</p></div>"

#. module: ncollection_saas
#: model:mail.template,body_html:ncollection_saas.mail_template_tenant_welcome
msgid "<div style=\"margin:0;padding:0;\">\n                    <p>Hi <t t-out=\"object.contact_name or object.company_name or ''\"/>,</p>\n                    <p>Your registration was approved and your NCollection workspace for\n                        <strong t-out=\"object.company_name or ''\"/> is ready.</p>\n                    <p>\n                        <a t-att-href=\"object.portal_url\" t-att-style=\"'background:%s;color:#fff;padding:10px 18px;border-radius:6px;text-decoration:none;display:inline-block;' % (object.create_uid.company_id.email_secondary_color or '#1F5F8F')\">\n                            Open your workspace\n                        </a>\n                    </p>\n                    <p>Workspace address: <t t-out=\"object.portal_url or ''\"/></p>\n                    <p t-if=\"object.admin_login\">Username: <strong t-out=\"object.admin_login\"/></p>\n                    <p t-if=\"ctx.get('nc_setup_url')\">\n                        To get started, set your password here:\n                        <a t-att-href=\"ctx.get('nc_setup_url')\" t-out=\"ctx.get('nc_setup_url')\"/>\n                    </p>\n                    <p t-else=\"\">\n                        Sign in with this username and the password you chose when you\n                        registered. If you have forgotten it, use “Forgot password?” on the\n                        login page.\n                    </p>\n                </div>\n            "
msgstr "<div style=\"margin:0;padding:0;\"><p>مرحبًا <t t-out=\"object.contact_name or object.company_name or ''\"/>،</p><p>تمت الموافقة على تسجيلك وأصبحت مساحة عمل NCollection الخاصة بـ <strong t-out=\"object.company_name or ''\"/> جاهزة.</p><p><a t-att-href=\"object.portal_url\" t-att-style=\"'background:%s;color:#fff;padding:10px 18px;border-radius:6px;text-decoration:none;display:inline-block;' % (object.create_uid.company_id.email_secondary_color or '#1F5F8F')\">افتح مساحة عملك</a></p><p>عنوان مساحة العمل: <t t-out=\"object.portal_url or ''\"/></p><p t-if=\"object.admin_login\">اسم المستخدم: <strong t-out=\"object.admin_login\"/></p><p t-if=\"ctx.get('nc_setup_url')\">للبدء، عيّن كلمة مرورك هنا: <a t-att-href=\"ctx.get('nc_setup_url')\" t-out=\"ctx.get('nc_setup_url')\"/></p><p t-else=\"\">سجّل الدخول بهذا الاسم وكلمة المرور التي اخترتها عند التسجيل. وإذا نسيتها فاستخدم «نسيت كلمة المرور؟» في صفحة الدخول.</p></div>"

