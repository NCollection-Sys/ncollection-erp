msgid "Tenant Backup"
msgstr "النسخة الاحتياطية للمستأجر"

msgid "Daily"
msgstr "يومي"

msgid "Weekly"
msgstr "أسبوعي"

msgid "Monthly"
msgstr "شهري"

msgid "Pending"
msgstr "قيد الانتظار"

msgid "Running"
msgstr "قيد التشغيل"

msgid "Done"
msgstr "تم"

msgid "Failed"
msgstr "فشل"

msgid "Backup File"
msgstr "ملف النسخة الاحتياطية"

msgid "Size (bytes)"
msgstr "الحجم (بايت)"

msgid "Restore drill SKIPPED: scratch name '%s' collides with a live tenant database — refusing to overwrite it."
msgstr "تم تخطّي تدريب الاستعادة: يتعارض الاسم المؤقت '%s' مع قاعدة بيانات مستأجر مباشرة — رفض الكتابة فوقها."

msgid "Restore drill OK: %(file)s restored to scratch DB %(db)s."
msgstr "نجح تدريب الاستعادة: تمت استعادة %(file)s إلى قاعدة البيانات المؤقتة %(db)s."

msgid "Restore drill FAILED: %s"
msgstr "فشل تدريب الاستعادة: %s"

msgid "Tenant backup FAILED for %(db)s (%(type)s)."
msgstr "فشلت النسخة الاحتياطية للمستأجر لقاعدة البيانات %(db)s (%(type)s)."

msgid "Investigate backup failure: %s"
msgstr "تحقّق من فشل النسخة الاحتياطية: %s"

msgid "Tenant Domain & SSL Certificate"
msgstr "نطاق المستأجر وشهادة SSL"

msgid "Domain (FQDN)"
msgstr "النطاق (FQDN)"

msgid "Fully-qualified hostname, e.g. acme.ncollectionerp.com."
msgstr "اسم مضيف مؤهّل بالكامل، مثل acme.ncollectionerp.com."

msgid "Tenant"
msgstr "مستأجر"

msgid "Platform Subdomain"
msgstr "النطاق الفرعي للمنصّة"

msgid "Custom Domain"
msgstr "نطاق مخصّص"

msgid "Rides Wildcard Cert"
msgstr "يستخدم شهادة البدل (Wildcard)"

msgid "SSL Expiry"
msgstr "انتهاء صلاحية SSL"

msgid "Valid"
msgstr "صالحة"

msgid "Expiring Soon"
msgstr "على وشك الانتهاء"

msgid "Expired"
msgstr "منتهي الصلاحية"

msgid "Unknown"
msgstr "غير معروف"

msgid "SSL Status"
msgstr "حالة SSL"

msgid "Last Expiry Alert"
msgstr "آخر تنبيه انتهاء صلاحية"

msgid "When the expiry alert last fired — throttles the weekly cron."
msgstr "وقت إطلاق تنبيه انتهاء الصلاحية آخر مرة — يضبط وتيرة المهمة المجدولة الأسبوعية."

msgid "A domain record for this FQDN already exists."
msgstr "يوجد بالفعل سجلّ نطاق لهذا الـ FQDN."

msgid "SSL certificate for %(fqdn)s is %(label)s (expiry: %(expiry)s)."
msgstr "شهادة SSL للنطاق %(fqdn)s هي %(label)s (انتهاء الصلاحية: %(expiry)s)."

msgid "Renew SSL: %s"
msgstr "تجديد SSL: %s"

msgid "Tenant Fleet Migration"
msgstr "ترحيل أسطول المستأجرين"

msgid "Comma-separated technical module names to upgrade (odoo -u) across every ready tenant."
msgstr "أسماء الوحدات التقنية مفصولة بفواصل لترقيتها (odoo -u) عبر كل مستأجر جاهز."

msgid "Tenants per rolling wave after the canary passes."
msgstr "عدد المستأجرين لكل موجة تدريجية بعد نجاح الاختبار التجريبي (canary)."

msgid "Canary Tenants"
msgstr "المستأجرون التجريبيون (Canary)"

msgid "Upgraded first; the fleet rolls out only if ALL canaries pass."
msgstr "تتم ترقيتهم أولاً؛ لا يُطرح الأسطول إلا إذا نجح جميع المستأجرين التجريبيين (canaries)."

msgid "Log the intended upgrade for every tenant without touching any database."
msgstr "سجّل الترقية المقصودة لكل مستأجر دون المساس بأي قاعدة بيانات."

msgid "Auto-restore on failure"
msgstr "استعادة تلقائية عند الفشل"

msgid "Draft"
msgstr "مسودة"

msgid "Canary Running"
msgstr "الاختبار التجريبي قيد التشغيل"

msgid "Canary Failed"
msgstr "فشل الاختبار التجريبي"

msgid "Rolling Out"
msgstr "قيد الطرح"

msgid "Cancelled"
msgstr "ملغى"

msgid "Targets"
msgstr "الأهداف"

msgid "Fleet migration %s"
msgstr "ترحيل الأسطول %s"

msgid "Specify at least one module to upgrade."
msgstr "حدّد وحدة واحدة على الأقل لترقيتها."

msgid "Invalid module name '%s'."
msgstr "اسم وحدة غير صالح '%s'."

msgid "Wave size must be at least 1."
msgstr "يجب أن يكون حجم الموجة 1 على الأقل."

msgid "Select at least one canary tenant — it is the verification gate."
msgstr "اختر مستأجراً تجريبياً واحداً على الأقل — فهو بوابة التحقق."

msgid "None of the selected canary tenants are 'ready'."
msgstr "لا يوجد أي من المستأجرين التجريبيين المحدّدين في حالة 'جاهز'."

msgid "Prepared: %(c)s canary + %(o)s fleet tenant(s)."
msgstr "تم التحضير: %(c)s تجريبي + %(o)s من مستأجري الأسطول."

msgid "This migration has already been started."
msgstr "لقد بدأ هذا الترحيل بالفعل."

msgid "Canary failed — fleet rollout halted."
msgstr "فشل الاختبار التجريبي — توقّف طرح الأسطول."

msgid "Fleet migration complete (%s)."
msgstr "اكتمل ترحيل الأسطول (%s)."

msgid "Migration cancelled by %s."
msgstr "تم إلغاء الترحيل بواسطة %s."

msgid "Tenant Fleet Migration Target"
msgstr "هدف ترحيل أسطول المستأجرين"

msgid "0 = canary; 1..N = rolling waves."
msgstr "0 = تجريبي؛ 1..N = موجات تدريجية."

msgid "Snapshotting"
msgstr "التقاط اللقطة"

msgid "Upgrading"
msgstr "قيد الترقية"

msgid "Probing"
msgstr "الفحص"

msgid "Restored"
msgstr "تمت الاستعادة"

msgid "Skipped (dry-run)"
msgstr "تم التخطّي (تشغيل تجريبي)"

msgid "Pre-upgrade snapshot for rollback."
msgstr "لقطة ما قبل الترقية للتراجع."

msgid "Migration cancelled before this tenant ran."
msgstr "تم إلغاء الترحيل قبل تشغيل هذا المستأجر."

msgid "Refused: %s"
msgstr "مرفوض: %s"

msgid "Upgrading: %s"
msgstr "قيد الترقية: %s"

msgid "Upgrade OK."
msgstr "نجحت الترقية."

msgid "module upgrade"
msgstr "ترقية الوحدة"

msgid "smoke probe"
msgstr "فحص أولي (smoke)"

msgid "Provision tenant DB '%s'"
msgstr "تجهيز قاعدة بيانات المستأجر '%s'"

msgid "Job for database '%s' is already done; refusing to re-run."
msgstr "مهمة قاعدة البيانات '%s' منتهية بالفعل؛ رفض إعادة التشغيل."

msgid "Provisioning started for database '%s'."
msgstr "بدأ التجهيز لقاعدة البيانات '%s'."

msgid "Retry: cleared the database left by a previous failed run."
msgstr "إعادة المحاولة: تم مسح قاعدة البيانات المتبقّية من تشغيل فاشل سابق."

msgid "Name validated."
msgstr "تم التحقق من الاسم."

msgid "Database created; modules installed: %s"
msgstr "تم إنشاء قاعدة البيانات؛ الوحدات المثبّتة: %s"

msgid "Tenant seeded: admin (forced reset), workspace config, branding."
msgstr "تمت تهيئة المستأجر: المسؤول (إعادة تعيين إجبارية)، إعدادات مساحة العمل، الهوية البصرية."

msgid "Invalid database name '%s': must match ^[a-z][a-z0-9]{2,62}$."
msgstr "اسم قاعدة بيانات غير صالح '%s': يجب أن يطابق ^[a-z][a-z0-9]{2,62}$."

msgid "Database name '%s' is reserved."
msgstr "اسم قاعدة البيانات '%s' محجوز."

msgid "Database '%s' already exists (collision)."
msgstr "قاعدة البيانات '%s' موجودة بالفعل (تعارض)."

msgid "database init"
msgstr "تهيئة قاعدة البيانات"

msgid "tenant seed"
msgstr "تهيئة المستأجر"

msgid "Rolled back: dropped database '%s'."
msgstr "تم التراجع: حُذفت قاعدة البيانات '%s'."

msgid "FAILED: %s"
msgstr "فشل: %s"

msgid "Provisioning quota exceeded: %(n)s jobs in the last hour (limit %(limit)s)."
msgstr "تم تجاوز حصة التجهيز: %(n)s مهمة في الساعة الأخيرة (الحد %(limit)s)."

msgid "DONE — tenant database is login-ready."
msgstr "تم — قاعدة بيانات المستأجر جاهزة لتسجيل الدخول."

msgid "The database name of a provisioned tenant is immutable — it is the live database and subdomain (tenant %s). Changing it would orphan the database and break routing."
msgstr "اسم قاعدة البيانات لمستأجر مُجهَّز غير قابل للتغيير — فهو قاعدة البيانات المباشرة والنطاق الفرعي (المستأجر %s). تغييره سيؤدي إلى تيتيم قاعدة البيانات وتعطيل التوجيه."

msgid "Database name '%s' is reserved (a platform or maintenance database) and cannot be assigned to a tenant."
msgstr "اسم قاعدة البيانات '%s' محجوز (قاعدة بيانات منصّة أو صيانة) ولا يمكن تخصيصه لمستأجر."

msgid "Provisioning FAILED for tenant %(name)s (database '%(db)s'). Latest job log:\n%(log)s"
msgstr "فشل التجهيز للمستأجر %(name)s (قاعدة البيانات '%(db)s'). آخر سجلّ للمهمة:\n%(log)s"

msgid "Tenant provisioning failed: %s"
msgstr "فشل تجهيز المستأجر: %s"

msgid "Restore Tenant Backup to a Scratch Database"
msgstr "استعادة النسخة الاحتياطية للمستأجر إلى قاعدة بيانات مؤقتة"

msgid "Restore Into (scratch DB)"
msgstr "الاستعادة إلى (قاعدة بيانات مؤقتة)"

msgid "A NON-live database name. The restore refuses to overwrite an existing tenant's database."
msgstr "اسم قاعدة بيانات غير مباشرة. ترفض الاستعادة الكتابة فوق قاعدة بيانات مستأجر قائم."

msgid "'%s' is a live tenant database. Choose a scratch/staging name — restores never overwrite a live tenant."
msgstr "'%s' هي قاعدة بيانات مستأجر مباشرة. اختر اسماً مؤقتاً/تجريبياً — لا تكتب الاستعادة أبداً فوق مستأجر مباشر."

msgid "Restore of %(src)s into %(db)s queued."
msgstr "تمت جدولة استعادة %(src)s إلى %(db)s."

