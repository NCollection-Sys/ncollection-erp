#. module: ncollection_saas
#: model:ir.model.fields,help:ncollection_saas.field_ncollection_backup_restore_wizard__target_db
msgid "A NON-live database name. The restore refuses to overwrite an existing tenant's database."
msgstr "اسم قاعدة بيانات غير مباشرة. ترفض الاستعادة الكتابة فوق قاعدة بيانات مستأجر قائم."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/backup.py:0
msgid "A backup's tenant cannot be reassigned. Snapshot '%(b)s' belongs to '%(t)s'; repointing it would let a restore claim another tenant's database as its own."
msgstr "لا يمكن إعادة إسناد مستأجر النسخة الاحتياطية. اللقطة '%(b)s' تخص '%(t)s'؛ وإعادة توجيهها ستسمح لاستعادة بادّعاء قاعدة بيانات مستأجر آخر على أنها قاعدتها."

#. module: ncollection_saas
#. odoo-python
#: code:addons/ncollection_saas/models/backup.py:0
msgid "A backup's tenant database name is stamped at creation and can never be written (snapshot %r). It is what the restore guard resolves the file's directory from, so rewriting it would let a restore claim another tenant's dump."
msgstr "اسم قاعدة بيانات مستأجر النسخة الاحتياطية يُختم عند الإنشاء ولا يمكن كتابته أبدًا (اللقطة %r). فمنه يحدّد حارس الاستعادة مجلد الملف، وإعادة كتابته ستسمح لاستعادة بادّعاء ملف مستأجر آخر."

#. module: ncollection_saas
#: model:ir.model.constraint,message:ncollection_saas.constraint_ncollection_domain_fqdn_uniq
msgid "A domain record for this FQDN already exists."
msgstr "يوجد بالفعل سجلّ نطاق لهذا الـ FQDN."

#. module: ncollection_saas
#: model_terms:ir.actions.act_window,help:ncollection_saas.action_ncollection_domain
msgid "A domain record is created for every provisioned tenant. Platform\n                subdomains ride the wildcard certificate automatically."
msgstr "يُنشأ سجل نطاق لكل مستأجر مُهيّأ. وتعتمد النطاقات الفرعية للمنصة تلقائيًا على الشهادة العامة (wildcard)."

#. module: ncollection_saas
