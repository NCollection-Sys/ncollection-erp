<?xml version="1.0" encoding="utf-8"?>
<!--
    Tenant module/config-sync visibility for the Platform Admin (#455).

    The SaaS layer owns the config_sync_* fields (ncollection_saas extends the
    tenant), so this view extension lives here rather than in
    ncollection_subscription, whose form cannot reference fields that do not
    exist when it is installed alone.

    This answers the question an admin could not previously answer at all:
    "I changed the plan's modules — did that actually reach the customer?"
-->
<odoo>

    <record id="view_ncollection_tenant_form_modules" model="ir.ui.view">
        <field name="name">ncollection.tenant.form.modules</field>
        <field name="model">ncollection.tenant</field>
        <field name="inherit_id" ref="ncollection_subscription.view_ncollection_tenant_form"/>
        <field name="arch" type="xml">

            <!-- Retry lives beside the status it repairs, not in a menu. -->
            <xpath expr="//sheet" position="before">
                <header>
                    <!-- #459: licensing a module never installed it. This is
                         the supported way to close that gap for an EXISTING
                         tenant; new tenants still get everything at
                         provisioning time. -->
                    <button name="action_install_licensed_modules" type="object"
                            string="Install Licensed Modules" class="btn-primary"
                            invisible="database_status != 'ready'"
                            confirm="Install this plan's modules into the tenant's database? It runs in an isolated process and is safe to repeat — modules that are already installed are left untouched."
                            help="Install this plan's modules into the tenant database so
                                  the licensed applications actually work. Licensing alone
                                  only makes them visible."/>
                    <button name="action_config_sync_now" type="object"
                            string="Sync Configuration Now"
                            invisible="database_status != 'ready'"
                            help="Push this tenant's plan configuration (modules, limits,
                                  subscription status) into its database now. Same push a
                                  plan change queues automatically — use it to retry after
                                  a failure."/>
                    <!-- #469: a BUTTON, never a migration. Nothing schedules
                         this — changing a live tenant's chart of accounts and
                         currency is a business decision with tax consequences,
                         and Odoo's loader either deletes their books or stacks
                         a second chart on the first. A database holding
                         accounting entries is refused outright; one already on
                         the target chart is a no-op, so retrying is safe. -->
                    <!-- #476: the confirm text is ONE line in the source on
                         purpose. Odoo renders the attribute verbatim, so the
                         indented continuation lines this used to have became
                         runs of whitespace inside the modal and the sentence
                         broke across the dialog at arbitrary points. -->
                    <button name="action_apply_localization" type="object"
                            string="Apply Country Localization"
                            invisible="database_status != 'ready' or not country_id"
                            confirm="Load this country's accounting localization — chart of accounts and currency — into the tenant's existing database? This is refused if the tenant already has accounting entries, and does nothing if the localization has already been applied."
                            help="For a tenant provisioned before its country was set.
                                  New tenants are localized at provisioning, which is the
                                  only moment a chart of accounts can be loaded safely."/>
                    <field name="module_install_state" widget="statusbar"
                           statusbar_visible="none,queued,running,done"
                           invisible="database_status != 'ready'"/>
                    <field name="country_id" invisible="1"/>
                </header>
            </xpath>

            <xpath expr="//notebook" position="inside">
                <!-- #476: modules and config sync were one undifferentiated tab
                     with the module set rendered as a comma-separated blob. They
                     are two different questions — "what is this customer
                     entitled to" and "did the last push land" — so they are now
                     two tabs, and entitlement is a table rather than a string. -->
                <page string="Modules" name="modules">
                    <div class="alert alert-info" role="status">
                        Entitlement is the <strong>plan</strong>
                        (<field name="plan_id" readonly="1" nolabel="1" class="oe_inline"/>)
                        plus the country localization, minus anything disabled for this
                        tenant below. Editing the plan changes it for
                        <strong>every</strong> tenant on that plan; the overrides below
                        change only this one.
                    </div>

                    <group>
                        <group string="Entitlement">
                            <field name="effective_module_names" readonly="1"
                                   placeholder="Core modules only"/>
                        </group>
                        <group string="Installation">
                            <!-- #459: installation is a separate fact from
                                 licensing, so it gets its own state rather than
                                 being implied by a green sync. -->
                            <field name="module_install_state" widget="badge"
                                   decoration-success="module_install_state == 'done'"
                                   decoration-info="module_install_state in ('queued', 'running')"
                                   decoration-danger="module_install_state == 'failed'"/>
                            <field name="module_install_last_ok" readonly="1"
                                   invisible="not module_install_last_ok"/>
                            <field name="module_install_last_error" readonly="1"
                                   invisible="not module_install_last_error"/>
                        </group>
                    </group>

                    <separator string="Overrides For This Tenant Only"/>
                    <div class="text-muted mb-2">
                        A row here is a deliberate exception to the plan.
                        <strong>Disabled</strong> withdraws a module the plan grants;
                        <strong>Added</strong> grants one it does not. Removing the row
                        restores exactly what the plan says. Disabling withdraws the
                        licence and hides the app — it never uninstalls the module or
                        deletes any data.
                    </div>
                    <field name="module_override_ids" nolabel="1"
                           context="{'default_tenant_id': id}">
                        <list editable="bottom">
                            <field name="module_name" placeholder="e.g. crm"/>
                            <field name="mode" widget="badge"
                                   decoration-danger="mode == 'disable'"
                                   decoration-success="mode == 'enable'"/>
                            <field name="reason" placeholder="Why this tenant differs"/>
                        </list>
                    </field>

                    <group string="Installation Log" invisible="not module_install_log">
                        <field name="module_install_log" readonly="1" nolabel="1"/>
                    </group>
                </page>

                <page string="Config Sync" name="config_sync">
                    <div class="text-muted mb-3">
                        Configuration synchronisation pushes this tenant's entitlement,
                        limits and subscription status into its own database, where
                        licensing is enforced. It runs automatically on every change and
                        is retried by a reconciliation cron; the buttons in the header
                        force it now.
                    </div>
                    <group>
                        <group string="Last Push">
                            <field name="config_sync_state" widget="badge"
                                   decoration-success="config_sync_state == 'ok'"
                                   decoration-warning="config_sync_state == 'transient'"
                                   decoration-danger="config_sync_state == 'needs_attention'"/>
                            <field name="config_sync_last_ok" readonly="1"
                                   invisible="not config_sync_last_ok"/>
                        </group>
                        <group string="Failures">
                            <field name="config_sync_failure_count" readonly="1"/>
                            <field name="config_sync_last_error" readonly="1"
                                   invisible="not config_sync_last_error"/>
                        </group>
                    </group>
                </page>
            </xpath>
        </field>
    </record>

</odoo>
