<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Public checkout pages (P2-T16). A self-contained layout that pulls in
        web.assets_frontend (=> tokens.scss + checkout.scss + checkout.js) WITHOUT
        the website/portal footer machinery (web.frontend_layout's portal
        language selector needs website context we don't provide). NCollection-
        branded, zero Odoo references, bilingual-ready copy.
    -->

    <!-- ===================== Standalone layout ===================== -->
    <template id="checkout_layout" name="NCollection Checkout Layout">
        <html>
            <head>
                <meta charset="utf-8"/>
                <meta name="viewport" content="width=device-width, initial-scale=1"/>
                <!-- Without this the browser asks the host for /favicon.ico, which
                     this standalone layout does not serve, and logs a 404 on every
                     page view of the customer's first impression. The product favicon
                     (Product Branding) is publicly served and versioned. -->
                <link rel="icon" type="image/x-icon"
                      t-att-href="nc_product_brand()['favicon_url']"/>
                <title><t t-esc="title or nc_product_brand()['short_name']"/></title>
                <t t-call-assets="web.assets_frontend" t-js="false"/>
            </head>
            <body>
                <t t-out="0"/>
                <t t-call-assets="web.assets_frontend" t-css="false"/>
            </body>
        </html>
    </template>

    <!-- ===================== Pricing ===================== -->
    <template id="checkout_pricing" name="NCollection Pricing">
        <t t-call="ncollection_saas.checkout_layout">
            <t t-set="title" t-value="'Pricing — ' + nc_product_brand()['short_name']"/>
            <div class="nc-checkout" data-nc-checkout="pricing">
                <header class="nc-checkout__head">
                    <h1>Pick a plan. Get your ERP in minutes.</h1>
                    <p>Start a free 14-day trial — no card required.</p>
                    <div class="nc-checkout__toggle">
                        <button type="button" class="nc-checkout__toggle-btn is-active" data-cycle="monthly">Monthly</button>
                        <button type="button" class="nc-checkout__toggle-btn" data-cycle="yearly">Yearly</button>
                    </div>
                </header>
                <div class="nc-checkout__plans">
                    <t t-foreach="plans" t-as="plan" t-key="plan.id">
                        <div class="nc-checkout__plan">
                            <h2 t-esc="plan.name"/>
                            <div class="nc-checkout__price">
                                <span class="nc-checkout__amount"
                                      t-att-data-monthly="plan.monthly_price"
                                      t-att-data-yearly="plan.yearly_price"
                                      t-esc="'%.0f' % (plan.monthly_price or 0.0)"/>
                                <span class="nc-checkout__per">/ mo</span>
                            </div>
                            <p class="nc-checkout__desc" t-esc="plan.description or ''"/>
                            <a class="nc-checkout__cta"
                               t-attf-href="/nc/checkout?plan={{ plan.code }}&amp;cycle=monthly"
                               t-att-data-plan="plan.code">Start free trial</a>
                        </div>
                    </t>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================== Registration form ===================== -->
    <!-- A REQUEST, not an instant workspace: submitting creates a pending
         registration that an administrator approves. Every user-visible string
         carries data-i18n so checkout.js can switch English/Arabic (RTL) without a
         reload; the server-rendered English is the fallback. -->
    <template id="checkout_form" name="NCollection Checkout">
        <t t-call="ncollection_saas.checkout_layout">
            <t t-set="title">Register your company</t>
            <div class="nc-checkout" data-nc-checkout="form"
                 t-att-data-recaptcha-site-key="recaptcha_site_key or ''">
                <div class="nc-checkout__card">
                    <h1 data-i18n="form.title">Register your company</h1>
                    <p class="nc-checkout__sub"><span data-i18n="form.sub">Request a workspace on the</span>
                        <strong t-esc="selected_plan.name"/>
                        <span data-i18n="form.sub2">plan. We review every request before the workspace is created.</span></p>

                    <form class="nc-checkout__form" data-nc-form="register" novalidate="novalidate">
                        <input type="hidden" name="plan" t-att-value="selected_plan.code"/>
                        <input type="hidden" name="cycle" t-att-value="billing_cycle"/>

                        <label><span data-i18n="f.company">Company name</span>
                            <input type="text" name="company" required="required" maxlength="200" autocomplete="organization"/>
                        </label>
                        <label><span data-i18n="f.contact">Your name</span>
                            <input type="text" name="contact" maxlength="200" autocomplete="name"/>
                        </label>
                        <label><span data-i18n="f.email">Contact email</span>
                            <input type="email" name="email" required="required" maxlength="200" autocomplete="email"/>
                            <small class="nc-checkout__hint" data-i18n="f.email.hint">For notices and password recovery. This is not your login.</small>
                        </label>
                        <label><span data-i18n="f.subdomain">Workspace address (subdomain)</span>
                            <span class="nc-checkout__subdomain" dir="ltr">
                                <input type="text" name="subdomain" required="required"
                                       autocomplete="off" spellcheck="false" autocapitalize="off"/>
                                <span class="nc-checkout__subdomain-suffix">.<t t-esc="base_domain"/></span>
                            </span>
                            <small class="nc-checkout__hint" data-nc-availability=""></small>
                        </label>
                        <label><span data-i18n="f.username">Username</span>
                            <input type="text" name="username" required="required" maxlength="32"
                                   autocomplete="username" spellcheck="false" autocapitalize="off" dir="ltr"
                                   placeholder="atlasadmin"/>
                            <small class="nc-checkout__hint" data-i18n="f.username.hint">You sign in with this username, not your email. Lowercase letters, digits, . _ -</small>
                        </label>
                        <label><span data-i18n="f.password">Password</span>
                            <input type="password" name="password" required="required" minlength="8" maxlength="128" autocomplete="new-password" dir="ltr"/>
                        </label>
                        <label><span data-i18n="f.password2">Confirm password</span>
                            <input type="password" name="password_confirm" required="required" minlength="8" maxlength="128" autocomplete="new-password" dir="ltr"/>
                        </label>

                        <t t-if="recaptcha_site_key">
                            <div class="g-recaptcha" t-att-data-sitekey="recaptcha_site_key"></div>
                            <script src="https://www.google.com/recaptcha/api.js" async="async" defer="defer"></script>
                        </t>

                        <button type="submit" class="nc-checkout__cta" data-nc-submit="" data-i18n="f.submit">
                            Submit registration request
                        </button>
                        <p class="nc-checkout__error" data-nc-error="" role="alert"></p>
                    </form>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================== Request status ===================== -->
    <!-- Lands here right after submitting. The default and by far the most common
         state is "awaiting approval"; the page then follows the request through
         approved -> provisioning -> ready (or failed / rejected). -->
    <template id="checkout_pending" name="NCollection Registration Status">
        <t t-call="ncollection_saas.checkout_layout">
            <t t-set="title">Registration request</t>
            <div class="nc-checkout" data-nc-checkout="pending"
                 t-att-data-tenant-uuid="tenant_uuid">
                <div class="nc-checkout__card nc-checkout__card--center">
                    <div class="nc-checkout__icon" data-nc-icon="">&#9719;</div>
                    <h1 data-nc-pending-title="" data-i18n="pending.title">Registration submitted</h1>
                    <p class="nc-checkout__sub" data-nc-pending-msg="" data-i18n="pending.msg">
                        Your registration request has been submitted and is awaiting approval.
                    </p>
                    <p class="nc-checkout__sub" data-nc-company="" t-att-data-company="company_name"/>
                    <a class="nc-checkout__cta nc-checkout__cta--hidden" data-nc-login="" href="#" data-i18n="ready.cta">
                        Open my workspace
                    </a>
                </div>
            </div>
        </t>
    </template>

    <!-- ===================== Invalid/expired verify token ===================== -->
    <template id="checkout_verify_invalid" name="NCollection Verify Invalid">
        <t t-call="ncollection_saas.checkout_layout">
            <t t-set="title" t-value="'Link expired — ' + nc_product_brand()['short_name']"/>
            <div class="nc-checkout" data-nc-checkout="invalid">
                <div class="nc-checkout__card nc-checkout__card--center">
                    <h1>This link is no longer valid</h1>
                    <p class="nc-checkout__sub">The confirmation link is invalid or has already
                        been used. You can start again from the pricing page.</p>
                    <a class="nc-checkout__cta" href="/pricing">Back to pricing</a>
                </div>
            </div>
        </t>
    </template>

</odoo>
