<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The platform database keeps Odoo's General Settings "Users" block: the tenant layer hides it as a duplicate of
         the Workspace Administration Center (ncollection_core: res_config_settings_view_form_no_users_block), and the
         platform administration interface must not change with it. -->
    <record id="view_ncollection_saas_config_settings_users" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ncollection.saas.users.block</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="ncollection_core.res_config_settings_view_form_no_users_block"/>
        <field name="arch" type="xml">
            <xpath expr="//block[@name='users_setting_container']" position="attributes">
                <attribute name="invisible">0</attribute>
            </xpath>
        </field>
    </record>
</odoo>
