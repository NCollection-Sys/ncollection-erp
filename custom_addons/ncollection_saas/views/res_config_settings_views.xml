<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ncollection_saas_config_settings" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.ncollection.saas</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app string="Management" name="ncollection_saas"
                     logo="/ncollection_subscription/static/description/icon.png">
                    <block title="Tenant Addressing"
                           help="Every tenant is reachable at &lt;subdomain&gt;.&lt;base domain&gt;. Changing the base domain changes the URL of every tenant at once.">
                        <setting id="nc_base_domain_setting" string="Base Domain"
                                 help="Production routing also needs wildcard DNS for *.&lt;base domain&gt;, a matching wildcard certificate, and a reverse proxy that forwards the Host header — see docs/markdown/ROUTING.md.">
                            <field name="nc_base_domain" placeholder="example.com"/>
                        </setting>
                    </block>
                    <block title="Custom Tenant Domains"
                           help="A tenant may use its own verified domain (erp.customer.com) instead of, or as well as, its platform subdomain.">
                        <setting id="nc_custom_domains_setting" string="Custom Domains"
                                 help="Requires the edge agent on the host: docs/markdown/CUSTOM_TENANT_DOMAINS.md.">
                            <field name="nc_custom_domains_enabled"/>
                        </setting>
                        <setting id="nc_custom_domain_targets" string="Where customers point their DNS"
                                 invisible="not nc_custom_domains_enabled">
                            <div class="content-group">
                                <div class="row"><label for="nc_custom_domain_ipv4" class="col-lg-4 o_light_label"/><field name="nc_custom_domain_ipv4" placeholder="203.0.113.10"/></div>
                                <div class="row"><label for="nc_custom_domain_ipv6" class="col-lg-4 o_light_label"/><field name="nc_custom_domain_ipv6" placeholder="2001:db8::10"/></div>
                                <div class="row"><label for="nc_custom_domain_cname" class="col-lg-4 o_light_label"/><field name="nc_custom_domain_cname" placeholder="edge.example.com"/></div>
                            </div>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_ncollection_saas_settings" model="ir.actions.act_window">
        <field name="name">Management Settings</field>
        <field name="res_model">res.config.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'module': 'ncollection_saas'}</field>
    </record>

    <menuitem id="menu_ncollection_saas_settings"
              name="Settings"
              parent="ncollection_subscription.menu_ncollection_saas_root"
              action="action_ncollection_saas_settings"
              groups="base.group_system"
              sequence="90"/>

</odoo>
