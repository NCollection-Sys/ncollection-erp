<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Platform Summary: "My Companies". A plain list of the tenants THIS platform administrator is authorised for
         (registry read; no tenant database is opened to draw it). "Enter Company" is a server-checked action. -->
    <record id="view_ncollection_platform_summary_companies" model="ir.ui.view">
        <field name="name">ncollection.subscription.dashboard.form.companies</field>
        <field name="model">ncollection.subscription.dashboard</field>
        <field name="inherit_id" ref="ncollection_subscription.view_ncollection_subscription_dashboard_form"/>
        <field name="arch" type="xml">
            <xpath expr="//h1[hasclass('o_ncollection_dashboard_title')]" position="after">
                <div class="o_ncollection_companies mb-4">
                    <h2 class="o_ncollection_section_title">My Companies</h2>
                    <field name="enterable_tenant_ids" nolabel="1" readonly="1">
                        <list create="false" delete="false" edit="false" no_open="1">
                            <field name="company_name"/>
                            <field name="status" widget="badge"
                                   decoration-success="status == 'active'" decoration-info="status == 'trial'"/>
                            <field name="tenant_url" widget="url"/>
                            <button name="action_enter_company" type="object" string="Enter Company"
                                    class="btn btn-primary"/>
                        </list>
                    </field>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
