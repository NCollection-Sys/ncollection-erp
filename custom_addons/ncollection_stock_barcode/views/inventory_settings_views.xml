<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Inventory: an app of the tenant Settings page (Odoo's own settings view, ncollection_core
         business_settings_views.xml). Hidden / read-only by the user's level on the "inventory" section; the server
         checks the same level for every changed value. -->
    <record id="view_nc_business_settings_form_inventory" model="ir.ui.view">
        <field name="name">ncollection.business.settings.form.inventory</field>
        <field name="model">ncollection.business.settings</field>
        <field name="inherit_id" ref="ncollection_core.view_nc_business_settings_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Inventory" string="Inventory" name="stock" invisible="nc_level_inventory == 'hidden'">
                    <block title="Traceability">
                        <setting id="nc_group_stock_production_lot"><field name="group_stock_production_lot" readonly="nc_level_inventory == 'view'"/></setting>
                        <setting id="nc_group_lot_on_delivery_slip" invisible="not group_stock_production_lot"><field name="group_lot_on_delivery_slip" readonly="nc_level_inventory == 'view'"/></setting>
                        <setting id="nc_group_stock_tracking_lot"><field name="group_stock_tracking_lot" readonly="nc_level_inventory == 'view'"/></setting>
                        <setting id="nc_group_stock_tracking_owner"><field name="group_stock_tracking_owner" readonly="nc_level_inventory == 'view'"/></setting>
                    </block>
                    <block title="Operations">
                        <setting id="nc_group_warning_stock"><field name="group_warning_stock" readonly="nc_level_inventory == 'view'"/></setting>
                        <setting id="nc_group_stock_sign_delivery"><field name="group_stock_sign_delivery" readonly="nc_level_inventory == 'view'"/></setting>
                        <setting id="nc_group_stock_reception_report"><field name="group_stock_reception_report" readonly="nc_level_inventory == 'view'"/></setting>
                        <setting id="nc_annual_inventory_month"><field name="annual_inventory_month" readonly="nc_level_inventory == 'view'"/></setting>
                        <setting id="nc_annual_inventory_day"><field name="annual_inventory_day" readonly="nc_level_inventory == 'view'"/></setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>

    <record id="action_nc_inventory_settings" model="ir.actions.act_window">
        <field name="name">Inventory Settings</field>
        <field name="res_model">ncollection.business.settings</field>
        <field name="view_mode">form</field>
        <field name="target">current</field>
        <field name="context">{'nc_settings_section': 'inventory', 'module': 'stock'}</field>
    </record>

    <menuitem id="menu_workspace_inventory_settings" name="Inventory Settings" active="False"
              parent="ncollection_core.menu_workspace_settings_root" action="action_nc_inventory_settings"
              sequence="18" groups="ncollection_core.group_tenant_admin,ncollection_core.group_settings_inventory"/>

    <!-- Inventory settings declared in ncollection_core/wizards/app_settings.py (warehouse structure, replenishment,
         units, lots on invoices): shown only while their module is installed. -->
    <record id="view_nc_business_settings_form_inventory_apps" model="ir.ui.view">
        <field name="name">ncollection.business.settings.form.inventory.apps</field>
        <field name="model">ncollection.business.settings</field>
        <field name="inherit_id" ref="view_nc_business_settings_form_inventory"/>
        <field name="arch" type="xml">
            <xpath expr="//app[@name='stock']" position="inside">
                <block title="Warehouse">
                    <setting id="nc_group_stock_multi_locations"><field name="group_stock_multi_locations" readonly="nc_level_inventory == 'view'"/></setting>
                    <setting id="nc_group_stock_adv_location" invisible="not group_stock_multi_locations"><field name="group_stock_adv_location" readonly="nc_level_inventory == 'view'"/></setting>
                    <setting id="nc_group_stock_lot_print_gs1"><field name="group_stock_lot_print_gs1" readonly="nc_level_inventory == 'view'"/></setting>
                    <setting id="nc_horizon_days"><field name="horizon_days" readonly="nc_level_inventory == 'view'"/></setting>
                    <setting id="nc_stock_move_email_validation"><field name="stock_move_email_validation" readonly="nc_level_inventory == 'view'"/></setting>
                    <setting id="nc_group_lot_on_invoice" invisible="' stock_account ' not in nc_apps"><field name="group_lot_on_invoice" readonly="nc_level_inventory == 'view'"/></setting>
                </block>
                <block title="Units of Measure">
                    <setting id="nc_product_weight_in_lbs"><field name="product_weight_in_lbs" readonly="nc_level_inventory == 'view'"/></setting>
                    <setting id="nc_product_volume_volume_in_cubic_feet"><field name="product_volume_volume_in_cubic_feet" readonly="nc_level_inventory == 'view'"/></setting>
                </block>
            </xpath>
        </field>
    </record>
</odoo>
