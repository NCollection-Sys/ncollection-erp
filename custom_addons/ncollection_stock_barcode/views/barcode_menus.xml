<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="action_nc_barcode_scanner" model="ir.actions.client">
        <field name="name">Barcode Scanner</field>
        <field name="tag">ncollection_stock_barcode.scanner</field>
    </record>

    <!-- A real application on Home: its own tile, opening the scanner itself (not a shortcut to a list). Rights follow
         stock (Inventory users); licensing follows stock too (ncollection_core ir_ui_menu NATIVE_FOLLOWS_LICENCE), so a
         plan without Inventory shows no tile, and the ORM refuses the stock models either way. -->
    <menuitem id="menu_nc_barcode_root" name="Barcode"
              sequence="45" action="action_nc_barcode_scanner" groups="stock.group_stock_user"
              web_icon="ncollection_stock_barcode,static/description/icon.png"/>

    <!-- ...and still inside Inventory, where a warehouse user already looks for it. -->
    <menuitem id="menu_nc_barcode_scanner" name="Barcode Scanner"
              parent="stock.menu_stock_warehouse_mgmt" sequence="5"
              action="action_nc_barcode_scanner" groups="stock.group_stock_user"/>
</odoo>
