<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_company_form_nc_approvals" model="ir.ui.view">
        <field name="name">res.company.form.nc.approvals</field>
        <field name="model">res.company</field>
        <field name="inherit_id" ref="base.view_company_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Approval Thresholds">
                    <field name="nc_sale_approval_threshold"/>
                    <field name="nc_purchase_approval_threshold"/>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
