<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_nc_approval" model="ir.ui.view">
        <field name="name">sale.order.form.nc.approval</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//header" position="inside">
                <field name="nc_approval_required" invisible="1"/>
                <button name="action_request_approval" type="object"
                        string="Request Approval" class="btn-primary"
                        invisible="not nc_approval_required or approval_state != 'none'"/>
                <button name="action_approve" type="object" string="Approve"
                        class="btn-primary" invisible="approval_state != 'to_approve'"
                        groups="sales_team.group_sale_manager"/>
                <button name="action_reject" type="object" string="Reject"
                        invisible="approval_state != 'to_approve'"
                        groups="sales_team.group_sale_manager"/>
                <field name="approval_state" widget="badge"
                       invisible="approval_state == 'none'"
                       decoration-warning="approval_state == 'to_approve'"
                       decoration-success="approval_state == 'approved'"
                       decoration-danger="approval_state == 'rejected'"/>
            </xpath>
        </field>
    </record>
</odoo>
