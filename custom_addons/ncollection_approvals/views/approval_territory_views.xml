<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_lead_territory_list" model="ir.ui.view">
        <field name="name">ncollection.lead.territory.list</field>
        <field name="model">ncollection.lead.territory</field>
        <field name="arch" type="xml">
            <list>
                <field name="sequence" widget="handle"/>
                <field name="name"/>
                <field name="user_id"/>
                <field name="team_id"/>
                <field name="state_ids" widget="many2many_tags"/>
                <field name="country_ids" widget="many2many_tags"/>
            </list>
        </field>
    </record>

    <record id="view_lead_territory_form" model="ir.ui.view">
        <field name="name">ncollection.lead.territory.form</field>
        <field name="model">ncollection.lead.territory</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <group>
                            <field name="name"/>
                            <field name="user_id"/>
                            <field name="team_id"/>
                            <field name="active"/>
                        </group>
                        <group>
                            <field name="state_ids" widget="many2many_tags"/>
                            <field name="country_ids" widget="many2many_tags"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_lead_territory" model="ir.actions.act_window">
        <field name="name">Lead Territories</field>
        <field name="res_model">ncollection.lead.territory</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">Define a territory</p>
            <p>Leads whose state or country matches a territory are auto-assigned
               to its salesperson (state before country; rules ordered by sequence).</p>
        </field>
    </record>

    <menuitem id="menu_lead_territory" name="Lead Territories"
              parent="crm.crm_menu_config"
              action="action_lead_territory" sequence="50"/>
</odoo>
