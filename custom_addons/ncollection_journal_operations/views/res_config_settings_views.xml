<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_operations_accounts" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.ncollection.operations.accounts</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="account.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//setting[@id='post_bank_transactions_and_payments_setting']//div[hasclass('content-group')]"
                   position="inside">
                <div class="row mt8">
                    <label for="nc_payment_suspense_account_id" class="col-lg-5 o_light_label"/>
                    <field name="nc_payment_suspense_account_id" placeholder="Required for payments without a payee"/>
                </div>
                <div class="row mt8">
                    <label for="nc_bank_fee_account_id" class="col-lg-5 o_light_label"/>
                    <field name="nc_bank_fee_account_id" placeholder="Required for transfer bank charges"/>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
