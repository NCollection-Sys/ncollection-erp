<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_internal_transfer_form" model="ir.ui.view">
        <field name="name">ncollection.internal.transfer.form</field>
        <field name="model">ncollection.internal.transfer</field>
        <field name="arch" type="xml">
            <form string="Internal Transfer">
                <header>
                    <button name="action_post" string="Confirm Transfer" type="object" class="oe_highlight"
                            invisible="state != 'draft'" groups="account.group_account_user" data-hotkey="q"/>
                    <button name="action_nc_print_receipt" string="Print Receipt" type="object" icon="fa-print" groups="account.group_account_readonly"
                            invisible="state != 'posted'"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_payments" type="object" class="oe_stat_button" icon="fa-exchange"
                                invisible="not source_payment_id">
                            <span class="o_stat_text">Payments</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="company_id" invisible="1"/>
                    <field name="multi_currency" invisible="1"/>
                    <div class="o_nc_transfer_route d-flex flex-wrap align-items-center gap-3 mb-3">
                        <div class="o_nc_transfer_side">
                            <div class="text-muted small">From Journal</div>
                            <field name="source_journal_id" readonly="1" options="{'no_open': True}"
                                   class="fs-4 fw-bold"/>
                            <div class="text-muted small mt-1">Outgoing Payment Method</div>
                            <field name="payment_method_line_id" required="1" readonly="state != 'draft'" context="{'hide_payment_journal_id': 1}"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </div>
                        <i class="fa fa-long-arrow-right fa-2x text-primary o_nc_transfer_arrow" role="img"
                           aria-label="to" title="to"/>
                        <div class="o_nc_transfer_side">
                            <div class="text-muted small">To Journal</div>
                            <field name="destination_journal_id" options="{'no_create': True, 'no_open': True}"
                                   readonly="state != 'draft'" class="fs-4 fw-bold" placeholder="Choose the receiving journal"/>
                            <div class="text-muted small mt-1">Incoming Payment Method</div>
                            <field name="destination_payment_method_line_id" required="destination_journal_id"
                                   readonly="state != 'draft' or not destination_journal_id"
                                   context="{'hide_payment_journal_id': 1}" options="{'no_create': True, 'no_open': True}"
                                   placeholder="No incoming method on this journal"/>
                        </div>
                    </div>
                    <group>
                        <group>
                            <!-- The monetary widget already shows each journal's currency. -->
                            <field name="source_currency_id" invisible="1"/>
                            <field name="destination_currency_id" invisible="1"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="fee_amount" readonly="state != 'draft'" invisible="state != 'draft' and not fee_amount"/>
                            <field name="destination_amount" invisible="not multi_currency and not fee_amount"
                                   readonly="state != 'draft' or not multi_currency"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="memo" readonly="state != 'draft'" placeholder="Reason of the transfer"/>
                            <field name="nc_status" invisible="state == 'draft'" widget="badge" decoration-success="nc_status == 'paid'" decoration-info="nc_status == 'in_progress'"/>
                            <field name="progress" invisible="state == 'draft'" widget="badge"
                                   decoration-success="progress == 'done'" decoration-info="progress != 'done'"/>
                            <field name="source_payment_id" invisible="not source_payment_id" readonly="1"/>
                            <field name="destination_payment_id" invisible="not destination_payment_id" readonly="1"/>
                        </group>
                    </group>
                    <!-- Requests 13 / 14: one section, a preview while draft, what was booked once posted. -->
                    <field name="show_exchange" invisible="1"/>
                    <field name="rate_missing" invisible="1"/>
                    <field name="company_currency_id" invisible="1"/>
                    <div class="o_nc_fx_card" invisible="not show_exchange">
                        <div class="o_nc_fx_head">
                            <span class="o_nc_fx_title">Exchange Rate &amp; Transfer Details</span>
                            <span class="badge text-bg-light" invisible="state != 'draft'">Preview: nothing is booked yet</span>
                            <span class="badge text-bg-success" invisible="state == 'draft'">Booked</span>
                        </div>
                        <div class="alert alert-danger py-2 mb-2" role="alert" invisible="not rate_missing">
                            No exchange rate on or before the transfer date: add it before confirming.
                        </div>
                        <div class="o_nc_fx_grid">
                            <div class="o_nc_fx_cell"><div class="o_nc_fx_label">Amount Sent</div>
                                <field name="amount" readonly="1" class="o_nc_fx_value"/></div>
                            <div class="o_nc_fx_cell"><div class="o_nc_fx_label">Amount Received</div>
                                <field name="destination_amount" readonly="1" class="o_nc_fx_value"/></div>
                            <div class="o_nc_fx_cell" invisible="not multi_currency"><div class="o_nc_fx_label">Accounting Rate</div>
                                <field name="accounting_rate" readonly="1" class="o_nc_fx_value"/>
                                <div class="o_nc_fx_sub">per 1 <field name="source_currency_id" readonly="1" options="{'no_open': True}" class="d-inline"/>,
                                    in <field name="destination_currency_id" readonly="1" options="{'no_open': True}" class="d-inline"/></div></div>
                            <div class="o_nc_fx_cell" invisible="not multi_currency"><div class="o_nc_fx_label">Effective Rate</div>
                                <field name="effective_rate" readonly="1" class="o_nc_fx_value"/></div>
                            <div class="o_nc_fx_cell" invisible="not multi_currency"><div class="o_nc_fx_label">Expected Amount</div>
                                <field name="expected_amount" readonly="1" class="o_nc_fx_value"/></div>
                            <div class="o_nc_fx_cell" invisible="not multi_currency"><div class="o_nc_fx_label">Conversion Difference</div>
                                <field name="difference_amount" readonly="1" class="o_nc_fx_value"
                                       decoration-danger="difference_amount &lt; 0" decoration-info="difference_amount &gt; 0"/></div>
                            <div class="o_nc_fx_cell"><div class="o_nc_fx_label">Bank Fee</div>
                                <field name="fee_amount" readonly="1" class="o_nc_fx_value"/>
                                <div class="o_nc_fx_sub" invisible="not multi_currency">
                                    <field name="fee_company_amount" readonly="1" class="d-inline"/></div></div>
                            <div class="o_nc_fx_cell" invisible="not multi_currency or state != 'draft'">
                                <div class="o_nc_fx_label">Exchange Gain / Loss (estimate)</div>
                                <field name="exchange_estimate" readonly="1" class="o_nc_fx_value"
                                       decoration-danger="exchange_estimate &lt; 0" decoration-info="exchange_estimate &gt; 0"/></div>
                            <div class="o_nc_fx_cell" invisible="state == 'draft' or not multi_currency">
                                <div class="o_nc_fx_label">Exchange Gain / Loss (booked)</div>
                                <field name="exchange_amount" readonly="1" class="o_nc_fx_value"
                                       decoration-danger="exchange_amount &lt; 0" decoration-info="exchange_amount &gt; 0"/></div>
                        </div>
                        <div class="o_nc_fx_entries small" invisible="state == 'draft'">
                            <span invisible="not fee_move_id">Bank fee entry: <field name="fee_move_id" readonly="1" class="d-inline"/></span>
                            <span invisible="not exchange_move_id">Exchange entry: <field name="exchange_move_id" readonly="1" class="d-inline"/></span>
                        </div>
                        <div class="o_nc_fx_note text-muted small" invisible="state != 'draft'">
                            On confirmation the bank fee is booked to Bank Fees; what remains between the value sent and
                            the value received is booked by Odoo as exchange gain or loss when the two sides are reconciled.
                        </div>
                    </div>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_internal_transfer_list" model="ir.ui.view">
        <field name="name">ncollection.internal.transfer.list</field>
        <field name="model">ncollection.internal.transfer</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="source_journal_id"/>
                <field name="destination_journal_id"/>
                <field name="amount" sum="Total"/>
                <field name="source_currency_id" column_invisible="1"/>
                <field name="memo"/>
                <field name="state" widget="badge"/>
                <field name="nc_status" widget="badge" decoration-success="nc_status == 'paid'" decoration-info="nc_status == 'in_progress'"/>
                <field name="progress" widget="badge" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_internal_transfer" model="ir.actions.act_window">
        <field name="name">Internal Transfers</field>
        <field name="res_model">ncollection.internal.transfer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_internal_transfer" name="Internal Transfers" action="action_internal_transfer"
              parent="account.account_transactions_menu" sequence="40" groups="account.group_account_readonly"/>
</odoo>
