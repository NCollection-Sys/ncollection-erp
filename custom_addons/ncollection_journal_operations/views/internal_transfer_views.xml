<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_internal_transfer_form" model="ir.ui.view">
        <field name="name">ncollection.internal.transfer.form</field>
        <field name="model">ncollection.internal.transfer</field>
        <field name="arch" type="xml">
            <form string="Internal Transfer">
                <header>
                    <button name="action_post" string="Confirm Transfer" type="object" class="oe_highlight"
                            invisible="state != 'draft'" groups="account.group_account_user" data-hotkey="q"/>
                    <field name="state" widget="statusbar" statusbar_visible="draft,posted"/>
                </header>
                <sheet>
                    <div class="oe_button_box" name="button_box">
                        <button name="action_open_payments" type="object" class="oe_stat_button" icon="fa-exchange"
                                invisible="not source_payment_id">
                            <span class="o_stat_text">Payments</span>
                        </button>
                    </div>
                    <div class="oe_title">
                        <h1><field name="name" readonly="1"/></h1>
                    </div>
                    <field name="company_id" invisible="1"/>
                    <field name="multi_currency" invisible="1"/>
                    <div class="o_nc_transfer_route d-flex flex-wrap align-items-center gap-3 mb-3">
                        <div class="o_nc_transfer_side">
                            <div class="text-muted small">From Journal</div>
                            <field name="source_journal_id" readonly="1" options="{'no_open': True}"
                                   class="fs-4 fw-bold"/>
                            <div class="text-muted small mt-1">Payment Method</div>
                            <field name="payment_method_line_id" required="1" readonly="state != 'draft'" context="{'hide_payment_journal_id': 1}"
                                   options="{'no_create': True, 'no_open': True}"/>
                        </div>
                        <i class="fa fa-long-arrow-right fa-2x text-primary o_nc_transfer_arrow" role="img"
                           aria-label="to" title="to"/>
                        <div class="o_nc_transfer_side">
                            <div class="text-muted small">To Journal</div>
                            <field name="destination_journal_id" options="{'no_create': True, 'no_open': True}"
                                   readonly="state != 'draft'" class="fs-4 fw-bold" placeholder="Choose the receiving journal"/>
                        </div>
                    </div>
                    <group>
                        <group>
                            <!-- The monetary widget already shows each journal's currency. -->
                            <field name="source_currency_id" invisible="1"/>
                            <field name="destination_currency_id" invisible="1"/>
                            <field name="amount" readonly="state != 'draft'"/>
                            <field name="destination_amount" invisible="not multi_currency"
                                   readonly="state != 'draft'"/>
                            <field name="date" readonly="state != 'draft'"/>
                        </group>
                        <group>
                            <field name="memo" readonly="state != 'draft'" placeholder="Reason of the transfer"/>
                            <field name="nc_status" invisible="state == 'draft'" widget="badge" decoration-success="nc_status == 'paid'" decoration-info="nc_status == 'in_progress'"/>
                            <field name="progress" invisible="state == 'draft'" widget="badge"
                                   decoration-success="progress == 'done'" decoration-info="progress != 'done'"/>
                            <field name="source_payment_id" invisible="not source_payment_id" readonly="1"/>
                            <field name="destination_payment_id" invisible="not destination_payment_id" readonly="1"/>
                        </group>
                    </group>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>

    <record id="view_internal_transfer_list" model="ir.ui.view">
        <field name="name">ncollection.internal.transfer.list</field>
        <field name="model">ncollection.internal.transfer</field>
        <field name="arch" type="xml">
            <list>
                <field name="date"/>
                <field name="name"/>
                <field name="source_journal_id"/>
                <field name="destination_journal_id"/>
                <field name="amount" sum="Total"/>
                <field name="source_currency_id" column_invisible="1"/>
                <field name="memo"/>
                <field name="state" widget="badge"/>
                <field name="nc_status" widget="badge" decoration-success="nc_status == 'paid'" decoration-info="nc_status == 'in_progress'"/>
                <field name="progress" widget="badge" optional="hide"/>
            </list>
        </field>
    </record>

    <record id="action_internal_transfer" model="ir.actions.act_window">
        <field name="name">Internal Transfers</field>
        <field name="res_model">ncollection.internal.transfer</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_internal_transfer" name="Internal Transfers" action="action_internal_transfer"
              parent="account.account_transactions_menu" sequence="40" groups="account.group_account_readonly"/>
</odoo>
