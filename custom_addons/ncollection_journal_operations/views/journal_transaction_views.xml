<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_journal_transaction_list" model="ir.ui.view">
        <field name="name">ncollection.journal.transaction.list</field>
        <field name="model">ncollection.journal.transaction</field>
        <field name="arch" type="xml">
            <list create="0" edit="0" delete="0" decoration-success="direction == 'in'"
                  decoration-danger="direction == 'out'" decoration-muted="status == 'in_process'">
                <field name="date"/>
                <field name="reference"/>
                <field name="operation" widget="badge"/>
                <field name="direction" column_invisible="1"/>
                <field name="partner_id" optional="show"/>
                <field name="account_id" optional="hide"/>
                <field name="description" optional="show"/>
                <field name="payment_method_line_id" optional="show"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="company_currency_id" column_invisible="1"/>
                <field name="amount_in" sum="Incoming"/>
                <field name="amount_out" sum="Outgoing"/>
                <field name="pending_balance" sum="Pending" optional="show"/>
                <field name="running_balance" optional="show"/>
                <field name="status" widget="badge" decoration-info="status in ('in_process', 'to_reconcile')"
                       decoration-warning="status == 'awaiting_bank'" decoration-success="status in ('paid', 'reconciled')"/>
                <field name="journal_id" optional="hide"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_open_source" type="object" icon="fa-external-link" title="Open"/>
                <button name="action_open_move" type="object" icon="fa-list" title="Journal Items"
                        groups="account.group_account_readonly"/>
            </list>
        </field>
    </record>

    <record id="view_journal_transaction_search" model="ir.ui.view">
        <field name="name">ncollection.journal.transaction.search</field>
        <field name="model">ncollection.journal.transaction</field>
        <field name="arch" type="xml">
            <search>
                <field name="reference"/>
                <field name="description"/>
                <field name="partner_id"/>
                <field name="account_id"/>
                <field name="amount"/>
                <field name="journal_id"/>
                <filter name="incoming" string="Incoming" domain="[('direction', '=', 'in')]"/>
                <filter name="outgoing" string="Outgoing" domain="[('direction', '=', 'out')]"/>
                <separator/>
                <filter name="receipts" string="Receipts" domain="[('operation', '=', 'receipt')]"/>
                <filter name="payments" string="Payments" domain="[('operation', '=', 'payment')]"/>
                <filter name="transfers" string="Internal Transfers" domain="[('operation', '=', 'transfer')]"/>
                <filter name="accounts" string="Account Operations" domain="[('operation', '=', 'account')]"/>
                <filter name="bank" string="Bank Transactions" domain="[('operation', '=', 'bank')]"/>
                <filter name="entries" string="Journal Entries" domain="[('operation', '=', 'entry')]"/>
                <separator/>
                <filter name="pending" string="Pending" domain="[('pending_balance', '!=', 0)]"/>
                <filter name="to_reconcile" string="To Reconcile" domain="[('status', '=', 'to_reconcile')]"/>
                <separator/>
                <filter name="date" string="Date" date="date"/>
                <group>
                    <filter name="group_operation" string="Type" context="{'group_by': 'operation'}"/>
                    <filter name="group_status" string="Status" context="{'group_by': 'status'}"/>
                    <filter name="group_partner" string="Customer / Supplier" context="{'group_by': 'partner_id'}"/>
                    <filter name="group_month" string="Month" context="{'group_by': 'date:month'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_journal_transaction" model="ir.actions.act_window">
        <field name="name">Transactions</field>
        <field name="res_model">ncollection.journal.transaction</field>
        <field name="view_mode">list</field>
        <field name="search_view_id" ref="view_journal_transaction_search"/>
    </record>
</odoo>
