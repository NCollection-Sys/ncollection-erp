<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- Every payment form (standard and card): Mark as Paid beside View, for an operation the server considers
         eligible (nc_can_mark_paid; _nc_mark_as_paid re-checks everything under a row lock). Supplier wording. -->
    <record id="view_account_payment_form_nc_ops" model="ir.ui.view">
        <field name="name">account.payment.form.nc.journal.operations</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="ncollection_account_core.view_account_payment_form_nc_workflow"/>
        <field name="arch" type="xml">
            <xpath expr="//header/button[@name='action_nc_view']" position="after">
                <button name="action_nc_mark_as_paid" string="Mark as Paid" type="object" class="btn-primary"
                        invisible="not nc_can_mark_paid" groups="account.group_account_user"
                        data-hotkey="m"/>
            </xpath>
            <xpath expr="//sheet" position="inside">
                <field name="nc_can_mark_paid" invisible="1"/>
                <field name="nc_operation" invisible="1"/>
            </xpath>
            <xpath expr="//field[@name='date']" position="after">
                <field name="nc_pending_amount" invisible="not nc_can_mark_paid" readonly="1"/>
            </xpath>
            <xpath expr="//field[@name='partner_id'][contains(@invisible, 'supplier')]" position="attributes">
                <attribute name="string">Supplier</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id'][contains(@invisible, 'supplier')]" position="attributes">
                <attribute name="string">Supplier Bank Account</attribute>
            </xpath>
        </field>
    </record>

    <!-- The card's Payment / Receipt form: same record, same header (Confirm, View, Print Receipt, Mark as Paid),
         without the direction and journal choices the card already made. -->
    <record id="view_payment_form_operation" model="ir.ui.view">
        <field name="name">account.payment.form.nc.operation</field>
        <field name="model">account.payment</field>
        <field name="inherit_id" ref="account.view_account_payment_form"/>
        <field name="mode">primary</field>
        <field name="priority">100</field>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='payment_type']" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <!-- Odoo's own Customer / Vendor fields are hidden FIRST and selected by their partner_type condition, so the
                 Payee field added below can never be matched by these selectors. -->
            <xpath expr="//field[@name='partner_id'][contains(@invisible, 'partner_type != ')][contains(@invisible, 'customer')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='partner_id'][contains(@invisible, 'partner_type != ')][contains(@invisible, 'supplier')]" position="attributes">
                <attribute name="invisible">1</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_type']" position="before">
                <field name="nc_source_journal_id" invisible="1"/>
                <field name="nc_allowed_account_ids" invisible="1"/>
                <field name="analytic_precision" invisible="1"/>
                <field name="nc_counterpart_type" required="1" readonly="state != 'draft'"/>
                <field name="partner_id" string="Payee" required="nc_counterpart_type in ('customer', 'supplier')"
                       invisible="nc_counterpart_type not in ('customer', 'supplier')" readonly="state != 'draft'"
                       domain="[('customer_rank', '>', 0)] if nc_counterpart_type == 'customer' else [('supplier_rank', '>', 0)]"
                       context="{'res_partner_search_mode': nc_counterpart_type, 'default_is_company': True}"
                       options="{'no_quick_create': True}"/>
                <field name="nc_counterpart_account_id" string="Payee" required="nc_counterpart_type == 'account'"
                       invisible="nc_counterpart_type != 'account'" readonly="state != 'draft'"
                       options="{'no_create': True}"/>
            </xpath>
            <xpath expr="//field[@name='memo']" position="attributes">
                <attribute name="string">Description</attribute>
            </xpath>
            <xpath expr="//field[@name='journal_id']" position="attributes">
                <attribute name="invisible">1</attribute>
                <attribute name="readonly">1</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_method_line_id']" position="attributes">
                <attribute name="invisible">payment_type == 'inbound'</attribute>
                <attribute name="string">Payment Method</attribute>
            </xpath>
            <xpath expr="//field[@name='payment_method_line_id']" position="after">
                <field name="payment_method_line_id" string="Receipt Method" invisible="payment_type != 'inbound'"
                       context="{'hide_payment_journal_id': 1}" options="{'no_create': True, 'no_open': True}"
                       required="1" readonly="state != 'draft'"/>
                <field name="nc_analytic_distribution" widget="analytic_distribution" string="Analytic"
                       invisible="nc_counterpart_type != 'account'" readonly="state != 'draft'"
                       groups="analytic.group_analytic_accounting"
                       options="{'account_field': 'nc_counterpart_account_id', 'business_domain': 'general'}"/>
            </xpath>
            <!-- An Account operation has no partner, so no partner bank account. -->
            <xpath expr="//field[@name='partner_bank_id'][contains(@invisible, 'customer')]" position="attributes">
                <attribute name="invisible" add="nc_counterpart_type == 'account'" separator=" or "/>
            </xpath>
            <xpath expr="//field[@name='partner_bank_id'][contains(@invisible, 'supplier')]" position="attributes">
                <attribute name="invisible" add="nc_counterpart_type == 'account'" separator=" or "/>
            </xpath>
        </field>
    </record>

    <!-- Pending Balance drill-down: the payments behind the card figure (domain set by the journal method). -->
    <record id="view_payment_list_pending" model="ir.ui.view">
        <field name="name">account.payment.list.nc.pending</field>
        <field name="model">account.payment</field>
        <field name="arch" type="xml">
            <list create="0" decoration-success="payment_type == 'inbound'" decoration-danger="payment_type == 'outbound'"
                  default_order="date desc, id desc">
                <field name="date"/>
                <field name="name" string="Reference"/>
                <field name="payment_type" string="Direction"/>
                <field name="nc_counterpart_type" optional="show"/>
                <field name="partner_id" string="Customer / Supplier"/>
                <field name="destination_account_id" string="Account" optional="hide"/>
                <field name="memo" string="Description"/>
                <field name="payment_method_line_id" string="Method"/>
                <field name="amount_signed" string="Amount" sum="Total"/>
                <field name="nc_pending_amount" string="Pending" sum="Pending"/>
                <field name="currency_id" groups="base.group_multi_currency"/>
                <field name="state" widget="badge" decoration-info="state == 'in_process'"
                       decoration-success="state == 'paid'"/>
                <field name="journal_id"/>
                <field name="company_id" groups="base.group_multi_company" optional="hide"/>
                <button name="action_nc_mark_as_paid" string="Mark as Paid" type="object" icon="fa-check"
                        invisible="not nc_can_mark_paid" groups="account.group_account_user"/>
                <field name="nc_can_mark_paid" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="action_pending_payments" model="ir.actions.act_window">
        <field name="name">Pending Balance</field>
        <field name="res_model">account.payment</field>
        <field name="view_mode">list,form</field>
        <field name="view_id" ref="view_payment_list_pending"/>
        <field name="context">{'create': False}</field>
    </record>
</odoo>
