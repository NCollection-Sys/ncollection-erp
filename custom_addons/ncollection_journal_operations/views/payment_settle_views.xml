<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_payment_settle_form" model="ir.ui.view">
        <field name="name">ncollection.payment.settle.form</field>
        <field name="model">ncollection.payment.settle</field>
        <field name="arch" type="xml">
            <form string="Mark as Paid">
                <field name="direction" invisible="1"/>
                <div class="alert alert-warning" role="alert">
                    You are confirming yourself that this money has reached (or left) the account. The system has not
                    checked this with the bank. The amount moves from the outstanding account to the journal's account
                    and the payment is matched with it; your name and the date are recorded on the payment.
                </div>
                <p class="text-muted">
                    A bank file imported later with the same amount and a matching partner or reference is recognised,
                    not added twice.
                </p>
                <group>
                    <group>
                        <field name="payment_id" options="{'no_open': True}"/>
                        <field name="amount"/>
                        <field name="currency_id" invisible="1"/>
                        <field name="date"/>
                    </group>
                    <group>
                        <field name="from_account_id" options="{'no_open': True}"/>
                        <field name="to_account_id" options="{'no_open': True}"/>
                    </group>
                </group>
                <footer>
                    <button name="action_confirm" string="Confirm: Mark as Paid" type="object" class="btn-primary"
                            data-hotkey="q"/>
                    <button string="Discard" special="cancel" class="btn-secondary" data-hotkey="x"/>
                </footer>
            </form>
        </field>
    </record>
</odoo>
