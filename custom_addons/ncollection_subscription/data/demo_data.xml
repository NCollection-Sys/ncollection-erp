<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <!-- The SHIPPED subscription plans: created once, at install. noupdate keeps an operator's edits;
         forcecreate="0" means an upgrade never re-creates a plan an operator deleted (Odoo's convert.py: a missing
         noupdate record is created again on -u unless forcecreate is 0). The demo tenants and subscriptions that
         used to be here are demo data and live in demo/demo_tenants.xml, loaded only into a database installed
         with demo data: they were created in production because this file is listed under 'data'. -->


    <!-- Subscription Plans -->
    <record id="demo_plan_starter" model="ncollection.subscription.plan" forcecreate="0">
        <field name="name">Starter</field>
        <field name="code">STARTER</field>
        <field name="monthly_price">49.0</field>
        <field name="yearly_price">490.0</field>
        <field name="max_users">5</field>
        <field name="max_companies">1</field>
        <field name="description">Entry-level plan for small businesses getting started with NCollection ERP.</field>
    </record>

    <record id="demo_plan_growth" model="ncollection.subscription.plan" forcecreate="0">
        <field name="name">Growth</field>
        <field name="code">GROWTH</field>
        <field name="monthly_price">149.0</field>
        <field name="yearly_price">1490.0</field>
        <field name="max_users">25</field>
        <field name="max_companies">3</field>
        <field name="description">For growing companies that need multiple users and companies.</field>
    </record>

    <record id="demo_plan_enterprise" model="ncollection.subscription.plan" forcecreate="0">
        <field name="name">Enterprise</field>
        <field name="code">ENTERPRISE</field>
        <field name="monthly_price">399.0</field>
        <field name="yearly_price">3990.0</field>
        <field name="max_users">100</field>
        <field name="max_companies">10</field>
        <field name="description">Full-scale plan for large organizations with multiple subsidiaries.</field>
        <!-- P3-T01 (interim OCA financial bootstrap): the Enterprise plan
             provisions the accounting stack + OCA reports so a fresh tenant can
             run a Trial Balance / GL / BS-P&L immediately. account_financial_report
             (Trial Balance, GL, aged balance) + ncollection_mis_templates (pulls
             mis_builder -> interim Balance Sheet / P&L). Each retires as its native
             F2 equivalent reaches parity (#117 F2-T07).

             #467 adds the NATIVE financial stack alongside them. Only the
             user-facing apps are named; each pulls its own dependencies, and
             Ring 1 expands the closure at read time, so listing
             ncollection_account_reports also licenses
             ncollection_account_analytics and ncollection_account_core. The two
             OCA entries stay until #117 retires them — the native and interim
             reports coexist rather than one silently replacing the other.

             ncollection_account_assets is deliberately NOT here: it depends on
             OCA account_asset_management, which only exists once ./oca has been
             aggregated (`make oca`). Naming it in the default plan would turn a
             missing generated directory into a failing install job on every
             Enterprise tenant. It remains selectable in the picker for
             deployments that have the engine. -->
        <field name="allowed_module_names">account,account_financial_report,ncollection_mis_templates,ncollection_account_reports,ncollection_account_dashboard,ncollection_account_budget</field>
    </record>

</odoo>
