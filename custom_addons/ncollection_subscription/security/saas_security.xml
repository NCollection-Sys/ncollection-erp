<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <!--
            P2-T15 — Platform Admin group.

            Gates the SaaS-admin dashboard + platform operations menus (tenants,
            subscriptions, plans, provisioning). This is NCollection *staff* who
            operate the platform — distinct from the tenant-side Owner/roles. The
            group is the explicit gate, MIRRORED at the ORM via ir.model.access
            (Rule 7), never a UI-only restriction. base.group_system implies it,
            so existing system administrators keep their access unchanged.
        -->
        <record id="module_category_ncollection" model="ir.module.category">
            <field name="name">Management</field>
            <field name="sequence">90</field>
        </record>

        <!-- Odoo 19: the module category lives on res.groups.privilege, which the
             group then points at via privilege_id (category_id was removed from
             res.groups). -->
        <record id="res_groups_privilege_platform" model="res.groups.privilege">
            <field name="name">Platform</field>
            <field name="category_id" ref="module_category_ncollection"/>
        </record>

        <record id="group_platform_admin" model="res.groups">
            <field name="name">Platform Admin</field>
            <field name="privilege_id" ref="res_groups_privilege_platform"/>
            <field name="comment">NCollection platform staff: the SaaS-admin dashboard,
                tenants, subscriptions, plans and the provisioning queue.</field>
        </record>

    </data>

    <!-- Applied on EVERY upgrade (deliberately NOT noupdate): system
         administrators imply Platform Admin, so existing admins keep access to
         the SaaS menus. Command.link is additive — it won't drop group_system's
         other implied groups. -->
    <data>
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[Command.link(ref('group_platform_admin'))]"/>
        </record>
        <!-- Platform staff, and only they, may change the identity of the system (ncollection_branding). Through this
             link the platform database's system administrators keep that right; a tenant database has no Platform
             Admin group, so its Owner never reaches it.

             WRITTEN FROM THE MANAGER GROUP'S SIDE (implied_by_ids = "who implies me"), on purpose. group_platform_admin is
             declared above in a noupdate block, so Odoo records it as noupdate and, on an UPGRADE of an existing
             database, skips any later write to it: an implied_ids line on that record is applied by a fresh install
             and silently NOT by an upgrade (measured on a copy of the real platform database: 0 rows), which would
             lock the operators out of System Branding. The manager group is an ordinary record, so this is applied
             on install and on every upgrade. -->
        <record id="ncollection_branding.group_system_branding_manager" model="res.groups">
            <field name="implied_by_ids" eval="[Command.link(ref('group_platform_admin'))]"/>
        </record>
    </data>
</odoo>
