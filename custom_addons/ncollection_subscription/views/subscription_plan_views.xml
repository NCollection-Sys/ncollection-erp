<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ncollection_subscription_plan_tree" model="ir.ui.view">
        <field name="name">ncollection.subscription.plan.tree</field>
        <field name="model">ncollection.subscription.plan</field>
        <field name="arch" type="xml">
            <list string="Subscription Plans" decoration-muted="not active">
                <field name="name"/>
                <field name="code"/>
                <field name="monthly_price" widget="monetary"/>
                <field name="yearly_price" widget="monetary"/>
                <field name="max_users"/>
                <field name="max_companies"/>
                <field name="tenant_count"/>
                <field name="currency_id" column_invisible="1"/>
                <field name="active" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_ncollection_subscription_plan_form" model="ir.ui.view">
        <field name="name">ncollection.subscription.plan.form</field>
        <field name="model">ncollection.subscription.plan</field>
        <field name="arch" type="xml">
            <form string="Subscription Plan">
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. Growth"/>
                        </h1>
                        <h3>
                            <field name="code" placeholder="e.g. GROWTH"/>
                        </h3>
                    </div>
                    <group>
                        <group string="Pricing">
                            <field name="currency_id" groups="base.group_multi_currency"/>
                            <field name="monthly_price" widget="monetary"/>
                            <field name="yearly_price" widget="monetary"/>
                            <!-- #471: charged once for a One Time membership.
                                 Never renewed and excluded from MRR. -->
                            <field name="one_time_price" widget="monetary"/>
                        </group>
                        <group string="Limits">
                            <field name="max_users"/>
                            <field name="max_companies"/>
                            <field name="active"/>
                        </group>
                        <group string="Lifecycle">
                            <field name="trial_days"/>
                            <field name="grace_days"/>
                        </group>
                    </group>
                    <notebook>
                        <!--
                            #455: allowed_module_names is THE control for what
                            every tenant on this plan gets, and it appeared in
                            no view at all — the one field that decides each
                            tenant's module set could not be seen or edited
                            anywhere in the UI. It is not a display mirror of
                            something else: provisioning installs
                            CORE_TENANT_MODULES + this list, and config sync
                            pushes this list into each tenant's
                            ncollection.workspace.config, where Ring 1 (menus)
                            and Ring 2 (ORM) enforce it.
                        -->
                        <page string="Modules">
                            <div class="alert alert-info" role="status">
                                <strong>Saving this list takes effect on every tenant of this plan.</strong>
                                Adding a module queues its <strong>installation</strong> into every
                                ready tenant's database and re-syncs licensing; removing one
                                revokes access but never uninstalls, so customer data is kept.
                                Both run in the background — the save does not wait — and each
                                tenant's own result is shown on its form.
                                <br/>
                                Core modules (<code>base</code>, <code>ncollection_core</code>,
                                <code>ncollection_branding</code>, <code>ncollection_auth</code>)
                                are always installed and are not listed here.
                                A module listed here also licenses whatever it depends on.
                            </div>
                            <!-- #457: was a raw Text field an admin typed
                                 "crm,stock" into. The widget writes the SAME
                                 comma-separated technical names, so the
                                 licensing contract is untouched — it only
                                 stops a SaaS operator having to know them. -->
                            <field name="allowed_module_names"
                                   widget="nc_module_picker"
                                   nolabel="1"/>
                        </page>
                        <page string="Description">
                            <field name="description" placeholder="Plan description for client demos..."/>
                        </page>
                        <page string="Tenants">
                            <field name="tenant_ids" readonly="1">
                                <list>
                                    <field name="company_name"/>
                                    <field name="status"/>
                                    <field name="email"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ncollection_subscription_plan_search" model="ir.ui.view">
        <field name="name">ncollection.subscription.plan.search</field>
        <field name="model">ncollection.subscription.plan</field>
        <field name="arch" type="xml">
            <search/>
        </field>
    </record>

    <record id="action_ncollection_subscription_plan" model="ir.actions.act_window">
        <field name="name">Subscription Plans</field>
        <field name="res_model">ncollection.subscription.plan</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription plan
            </p>
            <p>
                Define pricing tiers such as Starter, Growth and Enterprise.
            </p>
        </field>
    </record>

</odoo>
