<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ncollection_subscription_tree" model="ir.ui.view">
        <field name="name">ncollection.subscription.tree</field>
        <field name="model">ncollection.subscription</field>
        <field name="arch" type="xml">
            <list string="Subscriptions" decoration-success="status == 'active'"
                  decoration-info="status == 'draft'"
                  decoration-warning="status == 'expired'"
                  decoration-danger="status == 'cancelled'">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="plan_id"/>
                <field name="billing_cycle"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-info="status == 'draft'"
                       decoration-warning="status == 'expired'"
                       decoration-danger="status == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_ncollection_subscription_form" model="ir.ui.view">
        <field name="name">ncollection.subscription.form</field>
        <field name="model">ncollection.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_start_trial" type="object" string="Start Trial"
                            class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="status not in ('draft', 'trial')"/>
                    <button name="action_renew" type="object" string="Renew"
                            invisible="status not in ('active', 'expired')"/>
                    <button name="action_suspend" type="object" string="Suspend"
                            invisible="status not in ('active', 'expired')"/>
                    <button name="action_reactivate" type="object" string="Reactivate"
                            class="btn-primary" invisible="status not in ('suspended', 'expired')"/>
                    <button name="action_terminate" type="object" string="Terminate"
                            invisible="status != 'suspended'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="status not in ('draft', 'trial', 'active')"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,trial,active,expired,suspended"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. SUB-0001"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Subscription Details">
                            <field name="tenant_id"/>
                            <field name="plan_id"/>
                            <field name="billing_cycle"/>
                        </group>
                        <group string="Validity">
                            <field name="start_date"/>
                            <field name="end_date"/>
                            <field name="trial_end_date" invisible="status != 'trial'"/>
                            <field name="grace_end_date" invisible="not end_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ncollection_subscription_search" model="ir.ui.view">
        <field name="name">ncollection.subscription.search</field>
        <field name="model">ncollection.subscription</field>
        <field name="arch" type="xml">
            <search/>
        </field>
    </record>

    <record id="action_ncollection_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">ncollection.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription
            </p>
            <p>
                Link a tenant to a subscription plan and billing cycle.
            </p>
        </field>
    </record>

</odoo>
