<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ncollection_subscription_tree" model="ir.ui.view">
        <field name="name">ncollection.subscription.tree</field>
        <field name="model">ncollection.subscription</field>
        <field name="arch" type="xml">
            <tree string="Subscriptions" decoration-success="status == 'active'"
                  decoration-info="status == 'draft'"
                  decoration-warning="status == 'expired'"
                  decoration-danger="status == 'cancelled'">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="plan_id"/>
                <field name="billing_cycle"/>
                <field name="start_date"/>
                <field name="end_date"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-info="status == 'draft'"
                       decoration-warning="status == 'expired'"
                       decoration-danger="status == 'cancelled'"/>
            </tree>
        </field>
    </record>

    <record id="view_ncollection_subscription_form" model="ir.ui.view">
        <field name="name">ncollection.subscription.form</field>
        <field name="model">ncollection.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="draft,active,expired,cancelled"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. SUB-0001"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Subscription Details">
                            <field name="tenant_id"/>
                            <field name="plan_id"/>
                            <field name="billing_cycle"/>
                        </group>
                        <group string="Validity">
                            <field name="start_date"/>
                            <field name="end_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ncollection_subscription_search" model="ir.ui.view">
        <field name="name">ncollection.subscription.search</field>
        <field name="model">ncollection.subscription</field>
        <field name="arch" type="xml">
            <search string="Search Subscriptions">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="plan_id"/>
                <filter string="Draft" name="draft" domain="[('status', '=', 'draft')]"/>
                <filter string="Active" name="active_status" domain="[('status', '=', 'active')]"/>
                <filter string="Expired" name="expired" domain="[('status', '=', 'expired')]"/>
                <filter string="Cancelled" name="cancelled" domain="[('status', '=', 'cancelled')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Plan" name="group_plan" context="{'group_by': 'plan_id'}"/>
                    <filter string="Billing Cycle" name="group_cycle" context="{'group_by': 'billing_cycle'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ncollection_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">ncollection.subscription</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_ncollection_subscription_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription
            </p>
            <p>
                Link a tenant to a subscription plan and billing cycle.
            </p>
        </field>
    </record>

</odoo>
