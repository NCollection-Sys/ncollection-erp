<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ncollection_subscription_tree" model="ir.ui.view">
        <field name="name">ncollection.subscription.tree</field>
        <field name="model">ncollection.subscription</field>
        <field name="arch" type="xml">
            <list string="Subscriptions" decoration-success="status == 'active'"
                  decoration-info="status == 'draft'"
                  decoration-warning="status == 'expired'"
                  decoration-danger="status == 'cancelled'">
                <field name="name"/>
                <field name="tenant_id"/>
                <field name="plan_id"/>
                <field name="billing_cycle"/>
                <field name="start_date"/>
                <!-- Empty for a One Time membership, by design (#471). -->
                <field name="end_date"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'active'"
                       decoration-info="status == 'draft'"
                       decoration-warning="status == 'expired'"
                       decoration-danger="status == 'cancelled'"/>
            </list>
        </field>
    </record>

    <record id="view_ncollection_subscription_form" model="ir.ui.view">
        <field name="name">ncollection.subscription.form</field>
        <field name="model">ncollection.subscription</field>
        <field name="arch" type="xml">
            <form string="Subscription">
                <header>
                    <button name="action_start_trial" type="object" string="Start Trial"
                            class="btn-primary" invisible="status != 'draft'"/>
                    <button name="action_activate" type="object" string="Activate"
                            class="btn-primary" invisible="status not in ('draft', 'trial')"/>
                    <!-- #471: renewing a One Time membership would stamp an end
                         date and raise a second invoice for a customer who has
                         already paid in full. The model refuses it too. -->
                    <button name="action_renew" type="object" string="Renew"
                            invisible="status not in ('active', 'expired') or is_one_time"/>
                    <button name="action_suspend" type="object" string="Suspend"
                            invisible="status not in ('active', 'expired')"/>
                    <button name="action_reactivate" type="object" string="Reactivate"
                            class="btn-primary" invisible="status not in ('suspended', 'expired')"/>
                    <button name="action_terminate" type="object" string="Terminate"
                            invisible="status != 'suspended'"/>
                    <button name="action_cancel" type="object" string="Cancel"
                            invisible="status not in ('draft', 'trial', 'active')"/>
                    <field name="status" widget="statusbar"
                           statusbar_visible="draft,trial,active,expired,suspended"/>
                </header>
                <sheet>
                    <div class="oe_title">
                        <h1>
                            <field name="name" placeholder="e.g. SUB-0001"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Subscription Details">
                            <field name="tenant_id"/>
                            <field name="plan_id"/>
                            <field name="billing_cycle"/>
                        </group>
                        <group string="Validity">
                            <field name="is_one_time" invisible="1"/>
                            <field name="start_date"/>
                            <!-- #471: a perpetual membership HAS no end date.
                                 Showing an empty date field would invite
                                 someone to fill it in, which the model
                                 constraint then refuses. -->
                            <field name="end_date" invisible="is_one_time"/>
                            <div colspan="2" class="text-muted"
                                 invisible="not is_one_time">
                                <i class="fa fa-infinity me-1" role="img"/>
                                <strong>Perpetual membership.</strong>
                                Paid once, never renewed, no expiry date. Access ends only
                                when an administrator suspends, cancels or terminates it.
                            </div>
                            <field name="trial_end_date" invisible="status != 'trial'"/>
                            <field name="grace_end_date" invisible="not end_date"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ncollection_subscription_search" model="ir.ui.view">
        <field name="name">ncollection.subscription.search</field>
        <field name="model">ncollection.subscription</field>
        <field name="arch" type="xml">
            <search/>
        </field>
    </record>

    <record id="action_ncollection_subscription" model="ir.actions.act_window">
        <field name="name">Subscriptions</field>
        <field name="res_model">ncollection.subscription</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Create your first subscription
            </p>
            <p>
                Link a tenant to a subscription plan and billing cycle.
            </p>
        </field>
    </record>

    <!-- Revenue analytics (P2-T15): native graph (trend) + pivot (per-plan). -->
    <record id="view_ncollection_subscription_graph" model="ir.ui.view">
        <field name="name">ncollection.subscription.graph</field>
        <field name="model">ncollection.subscription</field>
        <field name="arch" type="xml">
            <graph string="Revenue Trend" type="line" sample="1">
                <field name="start_date" interval="month"/>
                <field name="mrr" type="measure"/>
            </graph>
        </field>
    </record>

    <record id="view_ncollection_subscription_pivot" model="ir.ui.view">
        <field name="name">ncollection.subscription.pivot</field>
        <field name="model">ncollection.subscription</field>
        <field name="arch" type="xml">
            <pivot string="Revenue by Plan" sample="1">
                <field name="plan_id" type="row"/>
                <field name="billing_cycle" type="col"/>
                <field name="mrr" type="measure"/>
            </pivot>
        </field>
    </record>

    <record id="action_ncollection_revenue_analytics" model="ir.actions.act_window">
        <field name="name">Revenue Analytics</field>
        <field name="res_model">ncollection.subscription</field>
        <field name="view_mode">graph,pivot</field>
        <!-- Active subscriptions only: MRR is realized recurring revenue, so
             draft/trial/cancelled/expired must not inflate the trend/breakdown
             (matches the KPI card + SAAS_ADMIN_DASHBOARD.md). -->
        <field name="domain">[('status', '=', 'active')]</field>
    </record>

</odoo>
