<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <record id="view_ncollection_provisioning_job_tree" model="ir.ui.view">
        <field name="name">ncollection.provisioning.job.tree</field>
        <field name="model">ncollection.provisioning.job</field>
        <field name="arch" type="xml">
            <tree string="Provisioning Queue"
                  decoration-success="status == 'done'"
                  decoration-info="status == 'queued'"
                  decoration-warning="status == 'running'"
                  decoration-danger="status == 'failed'">
                <field name="tenant_id"/>
                <field name="database_name"/>
                <field name="created_at"/>
                <field name="completed_at"/>
                <field name="status" widget="badge"
                       decoration-success="status == 'done'"
                       decoration-info="status == 'queued'"
                       decoration-warning="status == 'running'"
                       decoration-danger="status == 'failed'"/>
            </tree>
        </field>
    </record>

    <record id="view_ncollection_provisioning_job_form" model="ir.ui.view">
        <field name="name">ncollection.provisioning.job.form</field>
        <field name="model">ncollection.provisioning.job</field>
        <field name="arch" type="xml">
            <form string="Provisioning Job">
                <header>
                    <field name="status" widget="statusbar" statusbar_visible="queued,running,done,failed"/>
                </header>
                <sheet>
                    <group>
                        <group string="Job Details">
                            <field name="tenant_id"/>
                            <field name="database_name"/>
                        </group>
                        <group string="Timing">
                            <field name="created_at"/>
                            <field name="completed_at"/>
                        </group>
                    </group>
                    <notebook>
                        <page string="Log">
                            <field name="log" placeholder="Provisioning log output..."/>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_ncollection_provisioning_job_search" model="ir.ui.view">
        <field name="name">ncollection.provisioning.job.search</field>
        <field name="model">ncollection.provisioning.job</field>
        <field name="arch" type="xml">
            <search string="Search Provisioning Jobs">
                <field name="tenant_id"/>
                <field name="database_name"/>
                <filter string="Queued" name="queued" domain="[('status', '=', 'queued')]"/>
                <filter string="Running" name="running" domain="[('status', '=', 'running')]"/>
                <filter string="Done" name="done" domain="[('status', '=', 'done')]"/>
                <filter string="Failed" name="failed" domain="[('status', '=', 'failed')]"/>
                <group expand="0" string="Group By">
                    <filter string="Status" name="group_status" context="{'group_by': 'status'}"/>
                    <filter string="Tenant" name="group_tenant" context="{'group_by': 'tenant_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_ncollection_provisioning_job" model="ir.actions.act_window">
        <field name="name">Provisioning Queue</field>
        <field name="res_model">ncollection.provisioning.job</field>
        <field name="view_mode">tree,form</field>
        <field name="search_view_id" ref="view_ncollection_provisioning_job_search"/>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                No provisioning jobs yet
            </p>
            <p>
                Jobs appear here when a new tenant database is queued for provisioning.
            </p>
        </field>
    </record>

</odoo>
