<?xml version="1.0" encoding="UTF-8"?>
<templates xml:space="preserve">

    <t t-name="ncollection_subscription.ModulePicker">
        <div class="o_nc_modpick">

            <div t-if="!state.loaded" class="o_nc_modpick__loading">
                Loading available modules…
            </div>

            <t t-else="">
                <!-- Toolbar: search, scope, category, bulk actions. One row on a
                     wide screen, wrapping on a narrow one — the catalog is long
                     enough now that filtering has to be reachable without
                     scrolling past the grid. -->
                <div class="o_nc_modpick__toolbar">
                    <div class="o_nc_modpick__tabs" role="tablist">
                        <button type="button" role="tab"
                                t-attf-class="o_nc_modpick__tab {{ state.tab === 'all' ? 'o_nc_modpick__tab--on' : '' }}"
                                t-att-aria-selected="state.tab === 'all' ? 'true' : 'false'"
                                t-on-click="() => this.state.tab = 'all'">
                            All modules
                            <span class="o_nc_modpick__count" t-esc="state.optional.length"/>
                        </button>
                        <button type="button" role="tab"
                                t-attf-class="o_nc_modpick__tab {{ state.tab === 'included' ? 'o_nc_modpick__tab--on' : '' }}"
                                t-att-aria-selected="state.tab === 'included' ? 'true' : 'false'"
                                t-on-click="() => this.state.tab = 'included'">
                            Included in this plan
                            <span class="o_nc_modpick__count" t-esc="selected.length"/>
                        </button>
                    </div>

                    <input type="text"
                           class="o_nc_modpick__search form-control form-control-sm"
                           placeholder="Search modules…"
                           aria-label="Search modules"
                           t-model="state.query"/>

                    <select class="o_nc_modpick__category form-select form-select-sm"
                            aria-label="Filter by category"
                            t-model="state.category">
                        <option value="">All categories</option>
                        <t t-foreach="categories" t-as="cat" t-key="cat">
                            <option t-att-value="cat" t-esc="cat"/>
                        </t>
                    </select>

                    <div class="o_nc_modpick__bulk" t-if="!props.readonly">
                        <button type="button" class="btn btn-sm btn-secondary"
                                t-on-click="() => this.selectAll()">
                            Select all
                        </button>
                        <button type="button" class="btn btn-sm btn-secondary"
                                t-att-disabled="!visibleOptional.length"
                                t-on-click="() => this.selectVisible()">
                            Select visible results
                            <span class="o_nc_modpick__count" t-esc="visibleOptional.length"/>
                        </button>
                        <button type="button" class="btn btn-sm btn-secondary"
                                t-att-disabled="!selected.length"
                                t-on-click="() => this.clearSelection()">
                            Clear selection
                        </button>
                    </div>
                </div>

                <div class="o_nc_modpick__hint">
                    Core modules are installed in every tenant on every plan and cannot be
                    toggled. A module listed here also licenses whatever it depends on.
                </div>

                <!-- Names the plan stores that this platform's addons path does
                     not offer as an application. Shown rather than dropped: a
                     bulk "clear" that silently revoked them would take modules
                     away from live tenants. -->
                <div t-if="unlisted.length" class="o_nc_modpick__section">
                    <div class="o_nc_modpick__section-head">
                        <span class="o_nc_modpick__section-title">Not in the catalog</span>
                        <span class="o_nc_modpick__section-note">
                            Licensed by this plan but not offered as an application here —
                            kept as-is by the bulk actions. Click to remove one.
                        </span>
                    </div>
                    <div class="o_nc_modpick__grid">
                        <t t-foreach="unlisted" t-as="mod" t-key="mod.name">
                            <button type="button"
                                    class="o_nc_modpick__card o_nc_modpick__card--on o_nc_modpick__card--unlisted"
                                    t-att-disabled="props.readonly"
                                    t-att-title="mod.name"
                                    t-att-data-module="mod.name"
                                    t-on-click="() => this.toggle(mod)">
                                <span class="o_nc_modpick__icon">
                                    <span class="o_nc_modpick__lettermark" t-esc="initials(mod)"/>
                                </span>
                                <span class="o_nc_modpick__body">
                                    <span class="o_nc_modpick__label" t-esc="mod.label"/>
                                    <span class="o_nc_modpick__summary">Not offered on this platform</span>
                                </span>
                                <span class="o_nc_modpick__state o_nc_modpick__state--on">✓</span>
                            </button>
                        </t>
                    </div>
                </div>

                <div t-if="!visibleOptional.length and !visibleCore.length"
                     class="o_nc_modpick__empty">
                    No module matches the current search or filters.
                    <button type="button" class="btn btn-link btn-sm"
                            t-on-click="() => this.resetFilters()">Reset filters</button>
                </div>

                <div t-else="" class="o_nc_modpick__grid">
                    <!-- Core and optional share ONE grid. A separate
                         always-included block was mostly whitespace once the
                         catalog grew; the distinction is carried by the card
                         itself (dashed, badged, not clickable). -->
                    <t t-foreach="visibleCore" t-as="mod" t-key="'core-' + mod.name">
                        <div class="o_nc_modpick__card o_nc_modpick__card--core"
                             t-att-title="mod.name">
                            <span class="o_nc_modpick__icon">
                                <img t-if="mod.icon" t-att-src="iconSrc(mod)" t-att-alt="mod.label"/>
                                <span t-else="" class="o_nc_modpick__lettermark"
                                      t-esc="initials(mod)"/>
                            </span>
                            <span class="o_nc_modpick__body">
                                <span class="o_nc_modpick__label" t-esc="mod.label"/>
                                <span t-if="mod.summary" class="o_nc_modpick__summary"
                                      t-esc="mod.summary"/>
                            </span>
                            <span class="o_nc_modpick__badge">Core</span>
                        </div>
                    </t>

                    <t t-foreach="visibleOptional" t-as="mod" t-key="mod.name">
                        <button type="button"
                                t-attf-class="o_nc_modpick__card {{ isSelected(mod) ? 'o_nc_modpick__card--on' : (isImplied(mod) ? 'o_nc_modpick__card--implied' : '') }}"
                                t-att-disabled="props.readonly"
                                t-att-title="mod.name"
                                t-att-data-module="mod.name"
                                t-att-aria-pressed="isSelected(mod) ? 'true' : 'false'"
                                t-on-click="() => this.toggle(mod)">
                            <span class="o_nc_modpick__icon">
                                <img t-if="mod.icon" t-att-src="iconSrc(mod)" t-att-alt="mod.label"/>
                                <span t-else="" class="o_nc_modpick__lettermark"
                                      t-esc="initials(mod)"/>
                            </span>
                            <span class="o_nc_modpick__body">
                                <span class="o_nc_modpick__label" t-esc="mod.label"/>
                                <span t-if="mod.summary" class="o_nc_modpick__summary"
                                      t-esc="mod.summary"/>
                                <span t-elif="mod.category" class="o_nc_modpick__summary"
                                      t-esc="mod.category"/>
                            </span>
                            <span t-if="isSelected(mod)"
                                  class="o_nc_modpick__state o_nc_modpick__state--on">✓</span>
                            <span t-elif="isImplied(mod)"
                                  class="o_nc_modpick__state o_nc_modpick__state--implied"
                                  title="Included as a dependency of another selected module">↳</span>
                            <span t-else="" class="o_nc_modpick__state"/>
                        </button>
                    </t>
                </div>
            </t>
        </div>
    </t>

</templates>
