<?xml version="1.0" encoding="utf-8"?>
<odoo noupdate="1">
    <record id="rule_payment_batch_company" model="ir.rule">
        <field name="name">Payment batch: own companies</field>
        <field name="model_id" ref="model_ncollection_bank_payment_batch"/>
        <field name="domain_force">[('company_id', 'in', company_ids)]</field>
    </record>
    <record id="seq_payment_batch" model="ir.sequence">
        <field name="name">Payment Batch</field>
        <field name="code">ncollection.bank.payment.batch</field>
        <field name="prefix">BATCH/%(year)s/</field>
        <field name="padding">4</field>
        <field name="company_id" eval="False"/>
    </record>
</odoo>
