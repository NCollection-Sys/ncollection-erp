<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- The bank / cash card. Transactions (all, reconciled included) is Odoo's own button, which account_reconcile_oca
         already routes to its matching workspace. The import button of account_statement_import_file becomes Upload:
         same place, but bank journals only (a cash register has no bank file), and through the journal method that
         binds the wizard to THIS journal and requires the preview. The second row adds To Reconcile / Statements /
         New. Every entry is a journal method (models/account_journal.py) that re-checks access on the server; the
         groups= here only hides what the server would refuse. -->
    <record id="account_journal_dashboard_kanban_view" model="ir.ui.view">
        <field name="name">account.journal.dashboard.kanban.ncollection.bank</field>
        <field name="model">account.journal</field>
        <field name="inherit_id" ref="account.account_journal_dashboard_kanban_view"/>
        <field name="priority">90</field>
        <field name="arch" type="xml">
            <!-- Community has no bank synchronisation: say what this journal can actually do. -->
            <xpath expr="//t[@name='empty_journal_helper']/span[@t-if=&quot;journal_type == 'bank'&quot;]" position="replace">
                <span class="text-muted o_nc_bank_empty_helper" t-if="journal_type == 'bank'">Upload a bank statement file, or add transactions with New.</span>
            </xpath>
            <xpath expr="//button[@name='import_account_statement']" position="replace">
                <button t-if="journal_type == 'bank'" name="action_nc_bank_upload" type="object"
                        class="btn btn-primary o_nc_bank_upload" groups="account.group_account_user">
                    <span>Upload</span>
                </button>
            </xpath>
            <xpath expr="//a[@name='import_account_statement']" position="replace">
                <a type="object" name="action_nc_bank_upload">Upload</a>
            </xpath>
            <xpath expr="//div[@id='dashboard_bank_cash_left']" position="inside">
                <div class="o_nc_bank_nav d-flex flex-wrap gap-2 mt-2 small">
                    <a type="object" name="action_nc_bank_to_reconcile" class="o_nc_bank_nav_to_reconcile">To Reconcile</a>
                    <a type="object" name="action_nc_bank_statements" class="o_nc_bank_nav_statements">Statements</a>
                    <a type="object" name="action_nc_bank_new" class="o_nc_bank_nav_new"
                       groups="account.group_account_user">New</a>
                </div>
            </xpath>
        </field>
    </record>
</odoo>
