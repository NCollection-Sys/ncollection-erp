#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/models/x.py:0
msgid "Could not find any bank account with number '%(account_number)s'  linked to partner '%(partner_name)s'. You should create the bank account and set it on the related bank journal. If the related bank journal doesn't exist yet, you should create a new one."
msgstr "لم يُعثر على حساب بنكي برقم '%(account_number)s' مرتبط بالشريك '%(partner_name)s'. أنشئ الحساب البنكي وحدّده في يومية البنك المعنية، وإن لم تكن اليومية موجودة فأنشئها."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/models/x.py:0
msgid "Import (OCA) (%s)"
msgstr "استيراد (%s)"

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/models/x.py:0
msgid "Missing currency code in the bank statement file."
msgstr "رمز العملة مفقود في ملف كشف البنك."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/models/x.py:0
msgid "Missing payment_ref on a transaction."
msgstr "إحدى المعاملات بلا بيان."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/models/x.py:0
msgid "The Bank Accounting Account is not set on the journal '%s'."
msgstr "لم يُحدد الحساب المحاسبي للبنك في اليومية '%s'."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/models/x.py:0
msgid "The bank account with number '%(account_number)s' exists in Odoo but it is not set on any bank journal. You should set it on the related bank journal. If the related bank journal doesn't  exist yet, you should create a new one."
msgstr "الحساب البنكي رقم '%(account_number)s' موجود لكنه غير محدد في أي يومية بنك. حدّده في يومية البنك المعنية، وإن لم تكن اليومية موجودة فأنشئها."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/models/x.py:0
msgid "The bank statement file uses currency '%s' but there is no such currency in Odoo."
msgstr "يستخدم ملف كشف البنك العملة '%s' وهي غير موجودة في النظام."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/models/x.py:0
msgid "The currency of the bank statement (%(currency_name)s) is not the same as the currency of the journal '%(journal_name)s' (%(journal_currency_name)s)."
msgstr "عملة كشف البنك (%(currency_name)s) تختلف عن عملة اليومية '%(journal_name)s' (%(journal_currency_name)s)."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/models/x.py:0
msgid "The format of this bank statement file doesn't contain the bank account number, so you must start the wizard from the right bank journal in the dashboard."
msgstr "تنسيق هذا الملف لا يتضمن رقم الحساب البنكي، لذا يجب بدء الاستيراد من يومية البنك الصحيحة في لوحة المحاسبة."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/models/x.py:0
msgid "The journal found for the file (%(journal_match)s) is different from the selected journal (%(journal_selected)s)."
msgstr "اليومية المطابقة للملف (%(journal_match)s) تختلف عن اليومية المحددة (%(journal_selected)s)."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/models/x.py:0
msgid "The parsing of the statement file returned an invalid result."
msgstr "أعاد تحليل ملف الكشف نتيجة غير صالحة."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/models/x.py:0
msgid "This bank statement file format is not supported.\nDid you install the Odoo module to support this format?"
msgstr "تنسيق ملف كشف البنك هذا غير مدعوم.\nالتنسيقات المدعومة: CAMT وCSV وXLSX وQIF وOFX."

#. module: account_statement_import_file
#. odoo-python
#: code:addons/account_statement_import_file/models/x.py:0
msgid "You have already imported this file, or this file only contains already imported transactions."
msgstr "سبق استيراد هذا الملف، أو أن كل معاملاته مستوردة سابقاً."
