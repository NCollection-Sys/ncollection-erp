__pycache__/
*.pyc
*.pyo
*.log

# Local environment (never commit real secrets — see .env.example)
.env

# Root-level backup output dir only — must NOT swallow scripts/backup/ (P2-T04).
/backup/
*.zip

.vscode/
.idea/

odoo_data/
postgres_data/
# OCA addon repos — generated by `make oca` from repos.yml (P1-T04). Never commit.
/oca/
/.oca-venv/

# Staging deploy state — written on the staging server by scripts/deploy/*.sh
# (records current/previous image tags for rollback). Server-local, never commit.
.last_deployed_tag
.previous_deployed_tag

# PgBouncer auth file (P2-T09) — holds the real DB password. Generated from
# .env per deployment; only the .example template is committed.
config/pgbouncer/userlist.txt

# P3-T03 load-test run artifacts (regenerable)
scripts/perf/results/
